From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mark Abe <github@mab.wien>
Date: Sat, 12 Sep 2026 00:00:00 +0200
Subject: [PATCH] musl sched yield

Index: src/multibuff_ecx.c
===================================================================
--- src.orig/multibuff_ecx.c
+++ src/multibuff_ecx.c
@@ -51,6 +51,7 @@
 #define __USE_GNU
 
 #include <pthread.h>
+#include <sched.h>
 #include <openssl/rsa.h>
 #include <openssl/err.h>
 #include <string.h>
@@ -350,7 +351,7 @@ int multibuff_x25519_keygen(EVP_PKEY_CTX
            loop around and try again until the request
            completes and we can continue. */
         if ((job_ret = qat_pause_job(job, ASYNC_STATUS_OK)) == 0)
-            pthread_yield();
+            sched_yield();
     } while (QAT_CHK_JOB_RESUMED_UNEXPECTEDLY(job_ret));
 
     DEBUG("Finished: %p status = %d\n", x25519_keygen_req, sts);
@@ -495,7 +496,7 @@ int multibuff_x25519_derive(EVP_PKEY_CTX
            loop around and try again until the request
            completes and we can continue. */
         if ((job_ret = qat_pause_job(job, ASYNC_STATUS_OK)) == 0)
-            pthread_yield();
+            sched_yield();
     } while (QAT_CHK_JOB_RESUMED_UNEXPECTEDLY(job_ret));
 
     DEBUG("Finished: %p status = %d\n", x25519_derive_req, sts);
