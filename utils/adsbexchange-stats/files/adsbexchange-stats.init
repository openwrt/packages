#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# Copyright (C) 2026 Dr Bill Mcilhargey
#
# /etc/init.d/adsbexchange-stats -- procd init for the
# ADSBexchange.com statistics uploader.
#
# Reads /etc/config/adsbexchange-stats plus the selected feeder UUID /
# readsb.main.write_json from /etc/config/readsb, renders an env file
# consumed by the patched upstream json-status uploader, and supervises
# it under procd. The feeder UUID overrides the shared station UUID.
#
# See README for option/UCI/log-level reference.
#
# shellcheck disable=SC2034  # START/STOP/USE_PROCD/EXTRA_* read by rc.common
# shellcheck disable=SC3043  # busybox ash and dash both support `local`

START=92
STOP=10
USE_PROCD=1

# shellcheck source=files/adsbexchange-stats.functions.sh
. /usr/lib/adsbexchange-stats/functions.sh

# Coerce $1 against an allow-list separated by "|", echoing the matched
# value or the default $3. Defends the env file from arbitrary UCI input.
_clamp() {
	local IFS='|' value
	for value in $2; do
		[ "$1" = "$value" ] && { echo "$1"; return 0; }
	done
	echo "$3"
}
_env_assignment() {
	local name=$1 value=$2
	printf "%s='" "$name"
	while :; do
		case $value in
			*"'"*)
				printf "%s'\\\\''" "${value%%\'*}"
				value=${value#*\'}
				;;
			*) printf "%s'\n" "$value"; return 0 ;;
		esac
	done
}

# Render a shell-sourceable env file consumed by the patched json-status.
# Wrapped in a subshell so the umask change does not leak to procd.
# UUID is passed in (already validated by start_instance) to avoid a
# second uci read and the TOCTOU window with concurrent `readsb-uuid`.
write_env() (
	local cfg="$1"
	local uuid="$2"
	local feeder="$3"
	local json_paths
	local dns_cache dns_ttl dns_ignore_local
	local log_level log_summary_interval

	json_paths=$(adsbx_resolve_json_paths)

	config_get dns_cache            "$cfg" dns_cache 0
	config_get dns_ttl              "$cfg" dns_ttl 600
	config_get dns_ignore_local     "$cfg" dns_ignore_local 0
	config_get log_level            "$cfg" log_level 1
	config_get log_summary_interval "$cfg" log_summary_interval 300

	dns_cache=$(_clamp "$dns_cache" '0|1' 0)
	dns_ignore_local=$(_clamp "$dns_ignore_local" '0|1' 0)
	dns_ttl=$(adsbx_uint "$dns_ttl" 600 dns_ttl)
	# clamped log_level is consumed locally; subshell scope means it
	# does not escape (caller re-reads UCI for its own log line).
	# shellcheck disable=SC2030
	log_level=$(_clamp "$log_level" '0|1|2|3' 1)
	log_summary_interval=$(adsbx_uint "$log_summary_interval" 300 log_summary_interval)

	umask 077
	echo "$uuid" > "$ADSBX_UUID_FILE" || return 1

	umask 022
	{
		echo "# Generated by /etc/init.d/adsbexchange-stats; do not edit."
		_env_assignment UUID_FILE "$ADSBX_UUID_FILE"
		_env_assignment ADSBX_FEEDER "$feeder"
		# TEMP_DIR overrides the upstream default (/run/adsbexchange-stats/)
		# which is missing on builds where /run is not symlinked to /var/run
		# (e.g. some GL.iNet QSDK derivatives).
		_env_assignment TEMP_DIR "$ADSBX_RUNTIME_DIR"
		_env_assignment DNS_CACHE "$dns_cache"
		_env_assignment DNS_TTL "$dns_ttl"
		_env_assignment DNS_IGNORE_LOCAL "$dns_ignore_local"
		_env_assignment ADSBX_LOG_TAG "$ADSBX_LOG_TAG"
		_env_assignment ADSBX_LOG_LEVEL "$log_level"
		_env_assignment ADSBX_SUMMARY_INTERVAL "$log_summary_interval"
		echo ". /usr/lib/adsbexchange-stats/json-status-helpers.sh"
		# Render JSON_PATHS as a real bash array so the uploader keeps
		# its `for p in "${JSON_PATHS[@]}"` iteration. Tokens passed
		# _adsbx_safe_path; disable globbing as belt-and-braces before
		# the intentional word-split.
		set -f
		# shellcheck disable=SC2086
		set -- $json_paths
		set +f
		printf 'JSON_PATHS=('
		printf '"%s" ' "$@"
		printf ')\n'
	} > "$ADSBX_ENV_FILE"
)

start_instance() {
	local cfg="$1"
	local enabled uuid feeder log_level summary_interval json_paths

	config_get_bool enabled "$cfg" enabled 0
	if [ "$enabled" -ne 1 ]; then
		adsbx_notice "instance '$cfg' disabled in UCI; set 'option enabled 1'"
		return 0
	fi

	# Don't auto-generate UUID here: that would race with `readsb-uuid`.
	config_get feeder "$cfg" feeder
	uuid=$(adsbx_require_uuid "$feeder") || return 1

	if ! mkdir -p "$ADSBX_RUNTIME_DIR" || ! write_env "$cfg" "$uuid" "$feeder"; then
		adsbx_err "cannot prepare the uploader environment; not starting"
		return 1
	fi

	config_get log_level        "$cfg" log_level 1
	config_get summary_interval "$cfg" log_summary_interval 300
	json_paths=$(adsbx_resolve_json_paths)
	# log_level is the freshly-read UCI value; the same name was clamped
	# inside write_env's subshell but did not escape.
	# shellcheck disable=SC2031
	adsbx_notice "starting '$cfg' feeder=$feeder uuid=$uuid log_level=$log_level summary=${summary_interval}s paths='$json_paths'"

	procd_open_instance "$cfg"
	# json-status is bash (arrays, [[ ]], `enable -f sleep`).
	procd_set_param command /bin/bash "$ADSBX_UPLOADER"
	procd_set_param env ADSBX_ENV_FILE="$ADSBX_ENV_FILE"
	procd_set_param respawn 3600 15 0
	procd_set_param nice 19
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	if [ "${PKG_UPGRADE:-}" = 1 ] && ! enabled; then
		adsbx_notice "upgrade preserves the disabled boot service"
		return 0
	fi
	if [ "$(uci -q get adsbexchange-stats.main)" != adsbexchange-stats ]; then
		adsbx_err "missing or invalid main section; only 'config adsbexchange-stats main' is supported"
		return 1
	fi
	config_load adsbexchange-stats
	start_instance main
}

stop_service() {
	adsbx_notice "stopping uploader"
}

# rc.common calls this after stopping procd's process, not before it.
service_stopped() {
	[ -d "$ADSBX_RUNTIME_DIR" ] || return 0
	adsbx_notice "clearing known runtime files in $ADSBX_RUNTIME_DIR"
	rm -f "$ADSBX_ENV_FILE" "$ADSBX_UUID_FILE" \
		"$ADSBX_RUNTIME_DIR/tmp.json" "$ADSBX_RUNTIME_DIR/new.json" \
		"$ADSBX_RUNTIME_DIR/upload.gz" "$ADSBX_RUNTIME_DIR/curl.stderr" || {
		adsbx_err "could not remove uploader runtime files"
		return 1
	}
	rmdir "$ADSBX_RUNTIME_DIR" 2>/dev/null || \
		adsbx_warn "retaining $ADSBX_RUNTIME_DIR (unexpected files or directory removal failed)"
}

service_triggers() {
	procd_add_reload_trigger "adsbexchange-stats"
	# Pick up UUID / write_json changes from `readsb-uuid` etc.
	procd_add_reload_trigger "readsb"
}

reload_service() {
	stop
	start
}

# `/etc/init.d/adsbexchange-stats showurl` -- public per-station stats URL.
showurl() {
	local uuid
	uuid=$(adsbx_require_uuid) || return $?
	adsbx_feed_url "$uuid"
}

# Explicit consent action used by the readsb wizard or an operator.
activate() {
	local feeder=${1:-} pending
	[ -n "$feeder" ] || {
		adsbx_err "usage: service adsbexchange-stats activate <enabled-adsbexchange-feeder>"
		return 1
	}
	pending=$(uci -q changes readsb) || {
		adsbx_err "cannot inspect pending readsb configuration"
		return 1
	}
	[ -z "$pending" ] || {
		adsbx_err "commit or revert pending readsb edits before activating statistics"
		return 1
	}
	adsbx_require_uuid "$feeder" >/dev/null || return 1
	command -v readsb_uci_apply_package >/dev/null 2>&1 || {
		adsbx_err "update readsb-wiedehopf before using feeder-aware statistics setup"
		return 1
	}
	if ! readsb_uci_apply_package adsbexchange-stats "main.feeder=$feeder" "main.enabled=1"; then
		adsbx_err "statistics configuration was not applied"
		return 1
	fi
	# shellcheck disable=SC2169
	if ! enable || ! restart; then
		adsbx_err "statistics saved for '$feeder', but service activation failed"
		return 1
	fi
	adsbx_notice "statistics uploads explicitly enabled for feeder '$feeder'"
}

# `/etc/init.d/adsbexchange-stats about` -- standard project banner.
# Identity / license / maintainer / source URL / common entry points.
# Placeholders are substituted by the Makefile at install time so the
# banner stays in sync with PKG_VERSION / PKG_MAINTAINER / PKG_LICENSE.
about() {
	cat <<'EOF'
adsbexchange-stats -- ADSBexchange.com statistics uploader for OpenWrt

  Version     : @PKG_VERSION@
  License     : @PKG_LICENSE@
  Maintainer  : @PKG_MAINTAINER@
  Source      : @PKG_URL@
  Depends on  : bash, jq, curl, coreutils-stat, readsb-wiedehopf

Service control:
  service adsbexchange-stats {start|stop|restart|reload|status|enable|disable}
  service adsbexchange-stats showurl    Print this station's public stats URL
  service adsbexchange-stats about      Show this banner
  service adsbexchange-stats activate <feeder>
                                       Consent to uploads for an enabled ADSBx feeder
  readsb-feeder --setup-companions <feeder>
                                       Interactive, default-No consent

Configuration:
  /etc/config/adsbexchange-stats        UCI options (see README)
  readsb-uuid                           Manage the shared station UUID
  logread -e adsbexchange-stats         Tail uploader logs

Report issues and read the full README at the source URL above.
EOF
}

EXTRA_COMMANDS="showurl about activate"
EXTRA_HELP="	showurl	Print this feeder's public ADSBexchange stats URL
	about	Show package banner (version, license, maintainer, usage)
	activate	Enable statistics uploads for the named ADSBx feeder"
