#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# shellcheck shell=ash

# shellcheck disable=SC2034
START=61

# Do not set USE_PROCD. The rc.common wrapper always submits a service "set"
# after start_service returns, but install/upgrade deferral must leave an
# existing hciattach instance untouched. The explicit wrappers below retain
# the standard procd behavior after those preflight checks.
PROG="${PROG:-/usr/sbin/orbi-bt-setup}"
HCIATTACH="${HCIATTACH:-/usr/bin/hciattach}"
BLUETOOTHD_INIT="${BLUETOOTHD_INIT:-/etc/init.d/bluetoothd}"
FLOCK="${FLOCK:-flock}"
HCI_EXTENSION="${HCI_EXTENSION:-/sys/module/hci_uart/parameters/hciextn}"
PENDING_MARKER="${PENDING_MARKER:-/var/run/orbi-bt-setup/ana-freq.pending}"
REBOOT_MARKER="${REBOOT_MARKER:-/var/run/orbi-bt-setup.reboot-required}"
SEQUENCE_LOCK="${SEQUENCE_LOCK:-/var/run/orbi-bt-setup.sequence.lock}"
INSTALL_SKIP="${INSTALL_SKIP:-/var/run/orbi-bt-setup.skip-package-start}"
INITTAB="${INITTAB:-/etc/inittab}"
PROC_ROOT="${PROC_ROOT:-/proc}"

ATTACH_POLLS="${ATTACH_POLLS:-25}"
DETACH_POLLS="${DETACH_POLLS:-10}"
KILL_POLLS="${KILL_POLLS:-5}"
POLL_DELAY="${POLL_DELAY:-1}"

temporary_pid=
temporary_start=
prepared=0
sequence_lock_held=0

if ! command -v procd_open_service >/dev/null 2>&1; then
	# shellcheck source=/dev/null
	. "${IPKG_INSTROOT}/lib/functions/procd.sh" || exit 1
fi
# shellcheck disable=SC2154
basescript="$(readlink "$initscript")"

if command -v extra_command >/dev/null 2>&1; then
	extra_command "running" "Check if the service is running"
	extra_command "status" "Service status"
	extra_command "trace" "Start with syscall trace"
	extra_command "info" "Dump procd service info"
fi

setup_error() {
	echo "orbi-bt-setup: $*" >&2
}

bluetoothd_running() {
	if [ -x "$BLUETOOTHD_INIT" ] &&
			"$BLUETOOTHD_INIT" running >/dev/null 2>&1; then
		return 0
	fi

	pidof bluetoothd >/dev/null 2>&1
}

service_is_running() {
	local instance="${1:-*}"

	procd_running "$(basename "${basescript:-$initscript}")" "$instance"
}

require_hci_extension() {
	local value

	[ -r "$HCI_EXTENSION" ] || {
		setup_error "BCSP HCI extension state is unavailable"
		return 1
	}
	IFS= read -r value < "$HCI_EXTENSION" || {
		setup_error "failed to read BCSP HCI extension state"
		return 1
	}
	[ "$value" = "Y" ] || {
		setup_error "BCSP HCI extensions are disabled"
		return 1
	}
}

acquire_sequence_lock() {
	umask 077
	exec 9>"$SEQUENCE_LOCK" || {
		setup_error "failed to open the setup sequence lock"
		return 1
	}
	if ! "$FLOCK" -n 9; then
		exec 9>&-
		setup_error "another Orbi Bluetooth setup sequence is running"
		return 1
	fi
	sequence_lock_held=1
}

release_sequence_lock() {
	[ "$sequence_lock_held" -eq 1 ] || return 0
	exec 9>&-
	sequence_lock_held=0
}

mark_reboot_required() {
	umask 077
	[ ! -L "$REBOOT_MARKER" ] || return 1
	: > "$REBOOT_MARKER"
}

process_record() {
	local stat rest

	[ -r "$PROC_ROOT/$1/stat" ] || return 1
	stat="$(cat "$PROC_ROOT/$1/stat")" || return 1
	rest="${stat##*) }"
	printf '%s\n' "$rest" |
		awk 'NF >= 20 { print $1, $20; found = 1 }
			END { if (!found) exit 1 }'
}

process_start_time() {
	local record

	record="$(process_record "$1")" || return 1
	printf '%s\n' "${record#* }"
}

owned_process_running() {
	local record state started

	[ -n "$temporary_pid" ] && [ -n "$temporary_start" ] || return 1
	record="$(process_record "$temporary_pid")" || return 1
	state="${record%% *}"
	started="${record#* }"
	[ "$started" = "$temporary_start" ] || return 1
	case "$state" in
		Z|X|x) return 1 ;;
	esac
	return 0
}

start_temporary_attach() {
	local tty="$1"

	"$HCIATTACH" -n -t 10 -s 115200 "$tty" bcsp 115200 noflow &
	temporary_pid=$!
	temporary_start="$(process_start_time "$temporary_pid")" || {
		kill -KILL "$temporary_pid" 2>/dev/null
		wait "$temporary_pid" 2>/dev/null
		temporary_pid=
		temporary_start=
		setup_error "temporary hciattach exited before it could be tracked"
		return 1
	}
}

wait_for_hci() {
	local poll=0

	while [ "$poll" -lt "$ATTACH_POLLS" ]; do
		owned_process_running || {
			setup_error "temporary hciattach exited before the HCI appeared"
			return 1
		}
		if "$PROG" hci >/dev/null 2>&1; then
			return 0
		fi
		poll=$((poll + 1))
		sleep "$POLL_DELAY"
	done

	setup_error "timed out waiting for the target HCI"
	return 1
}

wait_for_hci_absent() {
	local poll=0

	while [ "$poll" -lt "$DETACH_POLLS" ]; do
		if ! "$PROG" hci >/dev/null 2>&1; then
			return 0
		fi
		poll=$((poll + 1))
		sleep "$POLL_DELAY"
	done

	setup_error "timed out waiting for the target HCI to disappear"
	return 1
}

stop_temporary_attach() {
	local pid="$temporary_pid"
	local poll=0

	[ -n "$pid" ] || return 0

	if owned_process_running; then
		kill -TERM "$pid" 2>/dev/null
	fi
	while owned_process_running && [ "$poll" -lt "$DETACH_POLLS" ]; do
		poll=$((poll + 1))
		sleep "$POLL_DELAY"
	done

	if owned_process_running; then
		kill -KILL "$pid" 2>/dev/null
		poll=0
		while owned_process_running && [ "$poll" -lt "$KILL_POLLS" ]; do
			poll=$((poll + 1))
			sleep "$POLL_DELAY"
		done
	fi

	if owned_process_running; then
		setup_error "temporary hciattach did not terminate"
		return 1
	fi

	wait "$pid" 2>/dev/null
	temporary_pid=
	temporary_start=
	return 0
}

detach_temporary_attach() {
	stop_temporary_attach || return 1
	wait_for_hci_absent
}

cleanup_temporary_attach() {
	[ -n "$temporary_pid" ] || return 0
	detach_temporary_attach
}

abort_start() {
	local message="$1"
	local cleanup_rc=0

	trap - HUP INT TERM
	cleanup_temporary_attach || cleanup_rc=1
	if [ "$prepared" -eq 1 ] || [ -e "$PENDING_MARKER" ]; then
		mark_reboot_required ||
			setup_error "failed to record the reboot-required state"
		setup_error "ANA_FREQ setup may be incomplete; reboot before retrying"
	fi
	release_sequence_lock
	setup_error "$message"
	[ "$cleanup_rc" -eq 0 ] ||
		setup_error "temporary hciattach cleanup also failed"
	return 1
}

interrupt_start() {
	abort_start "Bluetooth setup was interrupted"
	exit 1
}

consume_install_skip() {
	[ -e "$INSTALL_SKIP" ] || [ -L "$INSTALL_SKIP" ] || return 1
	rm -f "$INSTALL_SKIP" || {
		setup_error "failed to clear the package-install deferral marker"
		return 1
	}
	echo "orbi-bt-setup: setup deferred until reboot or explicit service start" >&2
	return 0
}

valid_tty() {
	local suffix

	case "$1" in
		/dev/ttyMSM*) suffix="${1#/dev/ttyMSM}" ;;
		*) return 1 ;;
	esac
	case "$suffix" in
		''|*[!0-9]*) return 1 ;;
	esac
	return 0
}

respawning_uart_owner_configured() {
	local tty_name="${1##*/}"

	[ -e "$INITTAB" ] || return 1
	[ -r "$INITTAB" ] || return 2
	awk -F: -v tty="$tty_name" '
		/^[[:space:]]*#/ { next }
		$1 == tty { found = 1 }
		END { exit found ? 0 : 1 }
	' "$INITTAB"
}

register_final_attach() {
	local tty="$1"

	procd_open_instance || return 1
	procd_set_param command "$HCIATTACH" -n -t 10 -s 115200 \
		"$tty" bcsp 115200 noflow || return 1
	procd_set_param stdout 1 || return 1
	procd_set_param stderr 1 || return 1
	procd_set_param term_timeout 10 || return 1
	procd_close_instance
}

start_service() {
	local owner_rc tty

	acquire_sequence_lock || return 1
	if ! require_hci_extension; then
		release_sequence_lock
		return 1
	fi

	temporary_pid=
	temporary_start=
	prepared=0
	trap 'interrupt_start' HUP INT TERM

	tty="$("$PROG" tty)" || {
		abort_start "failed to find an unused Orbi Bluetooth UART; disable any getty or respawning UART owner"
		return 1
	}
	valid_tty "$tty" || {
		abort_start "the helper returned an invalid UART path"
		return 1
	}
	respawning_uart_owner_configured "$tty"
	owner_rc=$?
	if [ "$owner_rc" -eq 0 ]; then
		abort_start "disable the respawning owner of $tty in $INITTAB before retrying"
		return 1
	fi
	if [ "$owner_rc" -gt 1 ]; then
		abort_start "failed to inspect $INITTAB for a respawning UART owner"
		return 1
	fi

	start_temporary_attach "$tty" || {
		abort_start "failed to start the first temporary hciattach"
		return 1
	}
	wait_for_hci || {
		abort_start "the first temporary HCI did not become ready"
		return 1
	}
	"$PROG" prepare || {
		abort_start "the ANA_FREQ prepare step failed"
		return 1
	}
	prepared=1
	detach_temporary_attach || {
		abort_start "failed to detach the prepared temporary HCI"
		return 1
	}

	start_temporary_attach "$tty" || {
		abort_start "failed to start the verification hciattach"
		return 1
	}
	wait_for_hci || {
		abort_start "the verification HCI did not become ready"
		return 1
	}
	"$PROG" verify || {
		abort_start "the ANA_FREQ verification step failed"
		return 1
	}
	detach_temporary_attach || {
		abort_start "failed to detach the verified temporary HCI"
		return 1
	}

	trap - HUP INT TERM
	register_final_attach "$tty" || {
		abort_start "failed to register the final hciattach instance"
		return 1
	}
}

rc_procd() {
	local action_rc close_rc method="set"

	[ -n "$2" ] && method="add"
	procd_open_service "$(basename "${basescript:-$initscript}")" "$initscript"
	"$@"
	action_rc=$?
	procd_close_service "$method"
	close_rc=$?
	[ "$action_rc" -eq 0 ] || return "$action_rc"
	if [ "$close_rc" -ne 0 ]; then
		mark_reboot_required ||
			setup_error "failed to record the reboot-required state"
		release_sequence_lock
		setup_error "failed to register the final procd service"
		return 1
	fi
	prepared=0
	release_sequence_lock
	return 0
}

start() {
	procd_lock

	if [ -e "$INSTALL_SKIP" ] || [ -L "$INSTALL_SKIP" ]; then
		consume_install_skip
		return $?
	fi
	if [ -e "$REBOOT_MARKER" ] || [ -L "$REBOOT_MARKER" ]; then
		setup_error "a previous setup sequence failed after prepare; reboot before retrying"
		return 1
	fi
	service_is_running >/dev/null 2>&1 && return 0
	if bluetoothd_running; then
		setup_error "stop bluetoothd before starting this service"
		return 1
	fi

	rc_procd start_service "$@" || return 1
	if eval "type service_started" 2>/dev/null >/dev/null; then
		service_started
	fi
}

boot() {
	start "$@"
}

trace() {
	TRACE_SYSCALLS=1
	start "$@"
}

info() {
	json_init
	json_add_string name "$(basename "${basescript:-$initscript}")"
	json_add_boolean verbose "1"
	_procd_ubus_call list
}

stop_service() {
	if bluetoothd_running; then
		setup_error "stop bluetoothd before stopping this service"
		return 1
	fi
}

service_stopped() {
	wait_for_hci_absent
}

stop() {
	procd_lock
	stop_service "$@" || return 1
	procd_kill "$(basename "${basescript:-$initscript}")" "$1"
	if eval "type service_stopped" 2>/dev/null >/dev/null; then
		service_stopped
	fi
}

restart() {
	if bluetoothd_running; then
		setup_error "stop bluetoothd before restarting this service"
		return 1
	fi
	stop "$@" || return 1
	start "$@"
}

reload() {
	setup_error "reload is not supported; stop bluetoothd and use restart"
	return 1
}

running() {
	service_is_running "$@"
}

status() {
	_procd_status "$(basename "${basescript:-$initscript}")" "$1"
}
