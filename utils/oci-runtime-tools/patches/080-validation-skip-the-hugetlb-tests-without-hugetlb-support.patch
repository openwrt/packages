From dcde22446ff823a75dd176db3ef42c3288a1f74a Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Wed, 21 Oct 2026 12:49:40 +0100
Subject: [PATCH] validation: skip the hugetlb tests without hugetlb support

A kernel built without huge pages or without the hugetlb cgroup
controller cannot apply hugepage limits, so no runtime can pass the
hugetlb tests there; they failed on reading /sys/kernel/mm/hugepages.
Skip both tests unless /proc/cgroups lists the hugetlb controller as
enabled and the kernel offers at least one huge page size.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 .../linux_cgroups_hugetlb.go                  | 19 ++++---
 .../linux_cgroups_relative_hugetlb.go         | 14 ++++--
 validation/util/linux_resources_hugetlb.go    | 50 +++++++++++++++++++
 .../util/linux_resources_hugetlb_test.go      | 33 ++++++++++++
 4 files changed, 105 insertions(+), 11 deletions(-)
 create mode 100644 validation/util/linux_resources_hugetlb.go
 create mode 100644 validation/util/linux_resources_hugetlb_test.go

--- a/validation/linux_cgroups_hugetlb/linux_cgroups_hugetlb.go
+++ b/validation/linux_cgroups_hugetlb/linux_cgroups_hugetlb.go
@@ -2,6 +2,7 @@ package main
 
 import (
 	"fmt"
+	"os"
 	"runtime"
 
 	"github.com/mndrix/tap-go"
@@ -10,16 +11,11 @@ import (
 	"github.com/opencontainers/runtime-tools/validation/util"
 )
 
-func testHugetlbCgroups() error {
+func testHugetlbCgroups(pageSizes []string) error {
 	t := tap.New()
 	t.Header(0)
 	defer t.AutoPlan()
 
-	pageSizes, err := cgroups.GetHugePageSize()
-	if err != nil {
-		t.Fail(fmt.Sprintf("error when getting hugepage sizes: %+v", err))
-	}
-
 	// When setting the limit just for checking if writing works, the amount of memory
 	// requested does not matter, as all insigned integers will be accepted.
 	// Use 2GiB as an example
@@ -92,7 +88,16 @@ func main() {
 		util.Fatal(fmt.Errorf("linux-specific cgroup test"))
 	}
 
-	if err := testHugetlbCgroups(); err != nil {
+	pageSizes, err := util.GetHugetlbPageSizes()
+	if err != nil {
+		util.Fatal(fmt.Errorf("error when getting hugepage sizes: %+v", err))
+	}
+	if len(pageSizes) == 0 {
+		util.Skip("no huge pages or hugetlb cgroup controller on the host", nil)
+		os.Exit(0)
+	}
+
+	if err := testHugetlbCgroups(pageSizes); err != nil {
 		util.Fatal(err)
 	}
 
