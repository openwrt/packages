#!/bin/sh /etc/rc.common

START=99

USE_PROCD=1
PROG=/usr/bin/telldus-mqtt
SCRIPTS=/usr/share/telldus-mqtt
CONFFILE=/var/etc/telldus-mqtt.json
STATUSFILE=/var/run/telldus-mqtt.json
CONFFILE_HOMEASSISTANT=/etc/telldus-mqtt/telldus-mqtt-homeassistant.json
# Made by the uci-defaults script if the tellstick.conf import failed
IMPORT_PENDING=/etc/telldus-mqtt/tellstick-import-pending

log() {
	[ -n "$1" ] && echo "$1" | logger -t telldus-mqtt
}

# Import tellstick.conf again, now with the TellStick serial of the
# status file. The serial is known after the daemon ran one time.
retry_import() {
	local serial out

	[ -f "$IMPORT_PENDING" ] || return
	serial=$(jsonfilter -i "$STATUSFILE" -e '@.gateway.serial' 2>/dev/null)
	[ -n "$serial" ] || return
	if out=$(ucode $SCRIPTS/telldus-mqtt-tellstick2uci.uc /etc/tellstick.conf /etc/config "$serial" 2>&1); then
		rm -f "$IMPORT_PENDING"
	fi
	log "$out"
}

start_service() {
	local enabled out

	config_load telldus-mqtt
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	retry_import

	# Switches: write tellstick.conf. telldusd reads it only at start.
	out=$(ucode $SCRIPTS/telldus-mqtt-uci2tellstick.uc /etc/tellstick.conf /etc/config 2>&1) || log "$out"
	if echo "$out" | grep -qx changed; then
		log "tellstick.conf changed, restart telldusd"
		/etc/init.d/telldusd restart
	fi

	mkdir -p /var/etc
	if ! out=$(ucode $SCRIPTS/telldus-mqtt-uci2json.uc $CONFFILE /etc/config 2>&1); then
		log "$out"
		log "cannot make $CONFFILE, not started"
		return 1
	fi
	log "$out"

	procd_open_instance
	procd_set_param command $PROG
	procd_append_param command --nodaemon # foreground required by procd
	procd_append_param command --config $CONFFILE --status $STATUSFILE
	procd_set_param file $CONFFILE # restart if the file changes on reload
	procd_append_param file $CONFFILE_HOMEASSISTANT
	procd_set_param respawn  # respawn the service if it exits
	procd_set_param stdout 1 # forward stdout of the command to logd
	procd_set_param stderr 1 # same for stderr
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger telldus-mqtt
}
