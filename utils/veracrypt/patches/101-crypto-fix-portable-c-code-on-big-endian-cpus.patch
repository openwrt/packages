+	uint32 x0 = TWOFISH_LOAD(in_blk, 0) ^ rk[4];
+	uint32 x1 = TWOFISH_LOAD(in_blk, 1) ^ rk[5];
+	uint32 x2 = TWOFISH_LOAD(in_blk, 2) ^ rk[6];
+	uint32 x3 = TWOFISH_LOAD(in_blk, 3) ^ rk[7];
 	uint32 f0, f1;
 
