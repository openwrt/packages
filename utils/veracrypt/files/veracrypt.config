# VeraCrypt volumes. luci-app-veracrypt edits the same sections.

config settings 'main'
	# Timeout in seconds for operations started from a web interface.
	option timeout '300'
	# option token_lib '/usr/lib/libykcs11.so'

# On demand: "/etc/init.d/veracrypt start data" asks for the password on a
# terminal; LuCI asks for it in the browser.
# config volume 'data'
#	option auto_mount '0'
#	option volume '/mnt/sda1/data.hc'
#	option mountpoint '/mnt/data'
#	option pim '0'
#	option mount_options 'nokernelcrypto'
#	option read_only '0'

# Unattended mount at boot and when the disk appears (off by default; the
# threat model is yours). password_file holds the password in plain text,
# its first line is used: it must be a root-only file (chmod 600) below
# directories only root can write to, e.g. /etc/veracrypt/passwords or a
# file a script writes at runtime to /tmp/veracrypt (chmod 700). Keyfiles
# can live elsewhere, e.g. on a USB stick that is mounted when needed; the
# volume is mounted once it is present. Security token keyfiles need the
# PIN, which cannot be passed safely without a terminal: use
# "/etc/init.d/veracrypt start <name>" or LuCI for them. Never put the
# password itself in UCI. Add files on the router to /etc/sysupgrade.conf
# to keep them across a sysupgrade.
# config volume 'backup'
#	option auto_mount '1'
#	option volume '/dev/sda2'
#	option mountpoint '/mnt/backup'
#	option password_file '/etc/veracrypt/passwords/backup'
#	option keyfiles '/etc/veracrypt/keyfiles/backup.key'
#	option pim '0'
#	option hash 'sha-512'
#	option mount_options 'nokernelcrypto'
#	option read_only '0'

# Keyfiles only, with an intentionally empty password (never implied):
#	option empty_password '1'
