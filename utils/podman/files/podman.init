#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
NAME=podman
PROG=/usr/bin/podman
CONF_DIR=/var/etc/containers
GRAPHROOT=/var/lib/containers/storage

toml_list_item() {
	printf '  "%s",\n' "$1"
}

generate_storage_conf() {
	local conf="$CONF_DIR/storage.conf"
	local driver runroot graphroot imagestore mountopt

	config_get driver storage driver overlay
	config_get runroot storage runroot /run/containers/storage
	config_get graphroot storage graphroot "$GRAPHROOT"
	config_get imagestore storage imagestore
	config_get mountopt storage mountopt nodev

	mkdir -p "$CONF_DIR"
	{
		echo "[storage]"
		echo "driver = \"$driver\""
		echo "runroot = \"$runroot\""
		echo "graphroot = \"$graphroot\""
		if [ -n "$imagestore" ]; then
			echo "imagestore = \"$imagestore\""
		fi
		echo
		echo "[storage.options]"
		echo "additionalimagestores = ["
		config_list_foreach storage additionalimagestores toml_list_item
		echo "]"
		echo
		echo "[storage.options.overlay]"
		echo "mountopt = \"$mountopt\""
	} > "$conf.tmp"
	mv "$conf.tmp" "$conf"
}

# podman only reads the generated storage.conf, if it is linked from
# /etc/containers. A storage.conf which is not our link is never touched,
# as it was created by the user.
link_storage_conf() {
	local use_uci="$1"
	local link=/etc/containers/storage.conf
	local conf="$CONF_DIR/storage.conf"

	if [ "$(readlink "$link")" = "$conf" ]; then
		if [ "$use_uci" = 0 ]; then
			rm -f "$link"
		fi
		return
	fi

	if [ -e "$link" ] || [ -L "$link" ]; then
		if [ "$use_uci" = 1 ]; then
			logger -t "$NAME" -p daemon.warn \
				"$link is not ours, uci config is ignored"
		fi
		return
	fi

	if [ "$use_uci" = 1 ]; then
		ln -s "$conf" "$link"
	fi
}

# Check that all fstab mount points and uvol volumes below which graphroot
# is located are ready. Without them the containers would end up on the
# tmpfs.
graphroot_mounted() {
	local graphroot="$1"

	if procd_mountpoints_ready "$graphroot"; then
		return 0
	fi

	logger -t "$NAME" -p daemon.warn \
		"mount points of $graphroot are not ready, start delayed"

	return 1
}

# Print the filesystem type of the mount on which graphroot is located.
# graphroot might not exist yet, so use its nearest existing parent.
graphroot_fstype() {
	local path="$1"
	local dev mountpoint type rest
	local match=""
	local fstype=""

	# graphroot is created by podman on the first start. A directory that
	# does not exist yet cannot be a mount point, it will be created on the
	# filesystem of its parent. So strip the last path component until an
	# existing directory is found. Stop on an empty path, as it does not
	# get any shorter and would loop forever.
	while [ -n "$path" ] && [ ! -d "$path" ]; do
		path="${path%/*}"
	done

	# /proc/mounts contains the resolved paths, so resolve symlinks like
	# /var -> /tmp. An empty path means that only / is left.
	path="$(readlink -f "${path:-/}")"

	# The order in /proc/mounts does not follow the path hierarchy, e.g.
	# the root overlay is listed after /tmp. So the longest mount point
	# which contains the path is the one on which it is located.
	while read -r dev mountpoint type rest; do
		case "${path}/" in
		"${mountpoint%/}/"*)
			if [ ${#mountpoint} -ge ${#match} ]; then
				match="$mountpoint"
				fstype="$type"
			fi
			;;
		esac
	done < /proc/mounts

	echo "$fstype"
}

# Check graphroot of the uci storage config before podman is started.
graphroot_ready() {
	local graphroot
	local fstype

	config_get graphroot storage graphroot "$GRAPHROOT"

	graphroot_mounted "$graphroot" || return 1

	fstype="$(graphroot_fstype "$graphroot")"
	case "$fstype" in
	tmpfs)
		logger -t "$NAME" -p daemon.warn \
			"$graphroot is on tmpfs, containers are lost on reboot"
		;;
	*)
		logger -t "$NAME" -p daemon.info \
			"$graphroot is on $fstype, containers are persistent"
		;;
	esac

	return 0
}

start_service() {
	local use_uci

	config_load podman
	config_get_bool use_uci storage use_uci 0

	link_storage_conf "$use_uci"

	if [ "$use_uci" = 1 ]; then
		generate_storage_conf
		graphroot_ready || return 0
	fi

	[ -d /run/podman ] || mkdir -p /run/podman
	procd_open_instance "podman"
	procd_set_param command "$PROG" system service --time=0
	procd_append_param command $command
	procd_close_instance

	# Close the procd lock fd 1000. Otherwise it is inherited by conmon,
	# which keeps running and holds the lock of this init script forever.
	${PROG} start --all --filter restart-policy=always 1000>&-
}

stop_service() {
	${PROG} pod stop -a
	${PROG} container stop -a
}

# The storage configuration is only read when podman starts, so a reload
# has to restart the service including all containers.
reload_service() {
	restart
}

service_triggers() {
	local use_uci
	local graphroot

	config_load podman
	config_get_bool use_uci storage use_uci 0
	config_get graphroot storage graphroot "$GRAPHROOT"

	procd_add_reload_trigger podman

	if [ "$use_uci" = 1 ]; then
		procd_add_restart_mount_trigger "$graphroot"
	fi
}
