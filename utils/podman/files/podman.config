config storage 'storage'
	option use_uci '1'
	option driver 'overlay'
	option runroot '/run/containers/storage'
	option graphroot '/var/lib/containers/storage'
	option mountopt 'nodev'
#	option imagestore '/srv/podman/images'
#	list additionalimagestores '/srv/podman/ro-images'

#config kube 'web'
#	option enabled '1'
