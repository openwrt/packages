+GstCaps *
+gst_v4l2_decoder_probe_sink_caps (GstV4l2Decoder * self,
+    GstStaticPadTemplate * tmpl, guint32 pixelformat)
+{
+  struct v4l2_frmsizeenum size = {
+    .pixel_format = pixelformat,
+  };
+  gint max_width, max_height;
+  GstCaps *caps;
+  gint ret;
+
+  caps = gst_static_pad_template_get_caps (tmpl);
+  if (self->doc_mode)
+    return caps;
+
+  ret = ioctl (self->video_fd, VIDIOC_ENUM_FRAMESIZES, &size);
+  if (ret < 0 || size.type == V4L2_FRMSIZE_TYPE_DISCRETE) {
+    GST_DEBUG_OBJECT (self, "No frame size range for %" GST_FOURCC_FORMAT,
+        GST_FOURCC_ARGS (pixelformat));
+    return caps;
+  }
+
+  max_width = MIN (size.stepwise.max_width, G_MAXINT);
+  max_height = MIN (size.stepwise.max_height, G_MAXINT);
+
+  /* set_sink_fmt() accepts sizes the driver raises, only the maximum binds */
+  caps = gst_caps_make_writable (caps);
+  gst_caps_set_simple (caps, "width", GST_TYPE_INT_RANGE, 1, max_width,
+      "height", GST_TYPE_INT_RANGE, 1, max_height, NULL);
+
+  GST_DEBUG_OBJECT (self, "Probed sink caps: %" GST_PTR_FORMAT, caps);
+
+  return caps;
+}
+
