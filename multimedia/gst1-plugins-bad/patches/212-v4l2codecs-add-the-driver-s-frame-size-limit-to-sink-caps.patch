--- a/sys/v4l2codecs/gstv4l2codecalphadecodebin.c
+++ b/sys/v4l2codecs/gstv4l2codecalphadecodebin.c
@@ -232,6 +232,31 @@ gst_v4l2_codec_alpha_decode_bin_init (Gs
 }
 
 void
+gst_v4l2_codec_alpha_decode_bin_add_sink_template (GstElementClass * klass,
+    GstStaticPadTemplate * tmpl, const gchar * decoder_name)
+{
+  GstElementClass *decoder_class;
+  GstPadTemplate *decoder_tmpl;
+  GstCaps *alpha_caps, *decoder_caps, *caps;
+
+  decoder_class = g_type_class_ref (g_type_from_name (decoder_name));
+  decoder_tmpl = gst_element_class_get_pad_template (decoder_class, "sink");
+
+  alpha_caps = gst_static_pad_template_get_caps (tmpl);
+  decoder_caps = gst_pad_template_get_caps (decoder_tmpl);
+  caps = gst_caps_intersect (alpha_caps, decoder_caps);
+
+  gst_element_class_add_pad_template (klass,
+      gst_pad_template_new (tmpl->name_template, GST_PAD_SINK, GST_PAD_ALWAYS,
+          caps));
+
+  gst_caps_unref (caps);
+  gst_caps_unref (decoder_caps);
+  gst_caps_unref (alpha_caps);
+  g_type_class_unref (decoder_class);
+}
