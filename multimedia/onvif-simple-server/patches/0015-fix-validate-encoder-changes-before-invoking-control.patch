+static int children_supported(ezxml_t node, const char *const *names)
+{
+    const char *namespace;
+    const char *name;
+    ezxml_t child;
+    ezxml_t sibling;
+    int i;
+
+    for (child = node ? node->child : NULL; child; child = child->ordered) {
+        namespace = xml_namespace_get(child);
+        if (!namespace || strcmp(namespace, "http://www.onvif.org/ver10/schema"))
+            return 0;
+        name = strchr(child->name, ':');
+        name = name ? name + 1 : child->name;
+        for (i = 0; names[i] && strcmp(names[i], name); i++)
+            ;
+        if (!names[i])
+            return 0;
+        for (sibling = child->ordered; sibling; sibling = sibling->ordered) {
+            name = strchr(sibling->name, ':');
+            name = name ? name + 1 : sibling->name;
+            if (!strcmp(names[i], name))
+                return 0;
+        }
+    }
+    return 1;
+}
+
+static int configuration_supported(ezxml_t node, int index, int version)
+{
+    static const char *const names[] = {
+        "Name", "UseCount", "Encoding", "Resolution", "Quality", "RateControl",
+        "H264", "Multicast", "SessionTimeout", NULL
+    };
+    static const char *const rate_names[] = {
+        "FrameRateLimit", "EncodingInterval", "BitrateLimit", NULL
+    };
+    static const char *const resolution_names[] = { "Width", "Height", NULL };
+    static const char *const h264_names[] = { "GovLength", "H264Profile", NULL };
+    const char *value;
+    const char *attribute;
+    ezxml_t multicast;
+    ezxml_t rate;
+    int i;
+
+    if (version == 1 && service_ctx.profiles[index].type == H265)
+        return 0;
+    if (!children_supported(node, names) ||
+        !children_supported(get_element_in_element_ptr("Resolution", node), resolution_names) ||
+        !children_supported(get_element_in_element_ptr("H264", node), h264_names))
+        return 0;
+    for (i = 0; node->attr[i]; i += 2) {
+        attribute = node->attr[i];
+        if (!strcmp(attribute, "token") || !strncmp(attribute, "xmlns", strlen("xmlns")) ||
+            (version == 2 && (!strcmp(attribute, "GovLength") || !strcmp(attribute, "Profile"))))
+            continue;
+        return 0;
+    }
+    value = get_element_in_element("Name", node);
+    if (value && strcmp(value, service_ctx.profiles[index].name))
+        return 0;
+    value = get_element_in_element("UseCount", node);
+    if (value && strcmp(value, "1"))
+        return 0;
+    value = get_element_in_element("SessionTimeout", node);
+    if (value && strcmp(value, "PT0S"))
+        return 0;
+    rate = get_element_in_element_ptr("RateControl", node);
+    if (!children_supported(rate, rate_names))
+        return 0;
+    for (i = 0; rate && rate->attr[i]; i += 2)
+        if (strncmp(rate->attr[i], "xmlns", strlen("xmlns")))
+            return 0;
+    multicast = get_element_in_element_ptr("Multicast", node);
+    if (!multicast)
+        return 1;
+    value = get_element_in_element("AutoStart", multicast);
+    if (!value || (strcmp(value, "false") && strcmp(value, "0")))
+        return 0;
+    value = get_element_in_element("Port", multicast);
+    if (!value || strcmp(value, "0"))
+        return 0;
+    value = get_element_in_element("TTL", multicast);
+    if (!value || strcmp(value, "0"))
+        return 0;
+    multicast = get_element_in_element_ptr("Address", multicast);
+    value = get_element_in_element("Type", multicast);
+    if (!value || strcmp(value, "IPv4"))
+        return 0;
+    value = get_element_in_element("IPv4Address", multicast);
+    return value && !strcmp(value, "0.0.0.0");
+}
