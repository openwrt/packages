+    def test_encoder_rejects_unsupported_changes(self):
+        with helper_configuration() as (config, path):
+            status, root = request('media2', 'GetVideoEncoderConfigurations',
+                                   '<ConfigurationToken>Profile_0_VideoEncoderToken</ConfigurationToken>', config)
+            self.assertEqual(status, 200)
+            node = root.find('.//tr2:Configurations', NS)
+            node.tag = 'Configuration'
+            original = ET.tostring(node).decode()
+            for content in [original.replace('Profile_0</', 'Renamed</'),
+                            original.replace('AutoStart>false', 'AutoStart>true'),
+                            original.replace('<Configuration ', '<Configuration Signed="true" '),
+                            original.replace('</Configuration>', '<tt:Unknown/></Configuration>')]:
+                self.assertEqual(request('media2', 'SetVideoEncoderConfiguration', content, config)[0], 500)
+                self.assertNotIn('last_set', json.loads(path.read_text()))
+            node.remove(node.find('tt:RateControl', NS))
+            del node.attrib['GovLength']
+            del node.attrib['Profile']
+            self.assertEqual(request('media2', 'SetVideoEncoderConfiguration',
+                                     ET.tostring(node).decode(), config)[0], 200)
+            applied = json.loads(path.read_text())['last_set']['configuration']
+            self.assertEqual(applied['bitrate'], 4567)
+            self.assertEqual(applied['frame_rate'], 29.97)
+            self.assertEqual(applied['gov_length'], 57)
+
