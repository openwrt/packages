+from pathlib import Path
+import os
+import select
+import socket
+import struct
+import subprocess
+import unittest
+import xml.etree.ElementTree as ET
+
+import test_discovery
+
+
+class NetworkDiscoveryTests(test_discovery.DiscoveryTests):
+    @classmethod
+    def command(cls, *arguments):
+        subprocess.run(['ip', *arguments], check=True, capture_output=True)
+
+    @classmethod
+    def interface_add(cls, name, ipv4, ipv6):
+        cls.command('link', 'add', name, 'type', 'dummy')
+        cls.command('link', 'set', name, 'multicast', 'on')
+        cls.command('address', 'add', ipv4 + '/24', 'dev', name)
+        cls.command('-6', 'address', 'add', ipv6 + '/64', 'dev', name, 'nodad')
+        cls.membership_add(name)
+        cls.command('link', 'set', name, 'up')
+
+    @classmethod
+    def membership_add(cls, name):
+        index = socket.if_nametoindex(name)
+        cls.observer4.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP,
+                                 struct.pack('=4s4si', socket.inet_aton('239.255.255.250'),
+                                             socket.inet_aton('0.0.0.0'), index))
+        cls.observer6.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_JOIN_GROUP,
+                                 struct.pack('=16sI', socket.inet_pton(socket.AF_INET6, 'ff02::c'),
+                                             index))
+
+    @classmethod
+    def setUpClass(cls):
+        mapping = Path('/proc/self/uid_map').read_text().split()
+        assert os.getuid() == 0 and int(mapping[1]) != 0, 'Run inside unshare -Urn'
+        cls.command('link', 'set', 'lo', 'up')
+        cls.observer4 = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
+        cls.observer6 = socket.socket(socket.AF_INET6, socket.SOCK_DGRAM)
+        cls.addClassCleanup(cls.observer4.close)
+        cls.addClassCleanup(cls.observer6.close)
+        for observer in [cls.observer4, cls.observer6]:
+            observer.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        cls.observer6.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
+        cls.observer4.bind(('0.0.0.0', 3702))
+        cls.observer6.bind(('::', 3702))
+        cls.interface_add('camera_one', '192.0.2.1', '2001:db8:1::1')
+        cls.interface_add('camera_two', '198.51.100.1', '2001:db8:2::1')
+        super().setUpClass()
+
+    def announcements_receive(self, addresses):
+        remaining = set(addresses)
+        while remaining:
+            ready, _, _ = select.select([self.observer4, self.observer6], [], [])
+            for observer in ready:
+                data, peer = observer.recvfrom(65535)
+                root = ET.fromstring(data)
+                if root.find('.//{*}Hello') is None:
+                    continue
+                self.assertEqual(root.findtext('.//{*}EndpointReference/{*}Address'),
+                                 'urn:uuid:' + test_discovery.IDENTITY)
+                address = peer[0]
+                host = f'[{address}]' if ':' in address else address
+                self.assertEqual(root.findtext('.//{*}XAddrs'),
+                                 f'http://{host}:8080/onvif/device_service')
+                remaining.discard(address)
+
+    def test_all_interfaces_announced(self):
+        self.announcements_receive(['192.0.2.1', '198.51.100.1',
+                                    '2001:db8:1::1', '2001:db8:2::1'])
+
+    def test_dynamic_addresses_and_interfaces(self):
+        self.interface_add('camera_three', '203.0.113.1', '2001:db8:3::1')
+        self.announcements_receive(['203.0.113.1', '2001:db8:3::1'])
+        self.command('-6', 'address', 'add', '2001:db8:1::2/64', 'dev', 'camera_one')
+        self.announcements_receive(['2001:db8:1::2'])
+        self.command('link', 'delete', 'camera_three')
+        self.probe(socket.AF_INET, '192.0.2.1', '192.0.2.1')
+
+    def test_multicast_probe_ingress(self):
+        for name, ipv4, ipv6 in [('camera_one', '192.0.2.1', '2001:db8:1::1'),
+                                 ('camera_two', '198.51.100.1', '2001:db8:2::1')]:
+            self.probe(socket.AF_INET, ipv4, ipv4, '239.255.255.250',
+                       socket.if_nametoindex(name))
+            self.probe(socket.AF_INET6, ipv6, f'[{ipv6}]', 'ff02::c',
+                       socket.if_nametoindex(name))
+
+
+if __name__ == '__main__':
+    unittest.main()
