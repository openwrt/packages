 #### IPv6 / dual-stack WS-Discovery
 
-IPv6 is auto-detected.
-
-- Uses a single `AF_INET6` dual-stack UDP socket (`IPV6_V6ONLY=0`) bound to `:::3702`
-- Joins the IPv4 WSD multicast group `239.255.255.250:3702` via `MCAST_JOIN_GROUP` (RFC 3678)
-- Joins the IPv6 WSD multicast group `FF02::C:3702` (WS-Discovery 1.1)
-- Each incoming Probe is dispatched by address family: IPv4-mapped senders (`::ffff:x.x.x.x`) get the IPv4 xaddr; native IPv6 senders get the IPv6 xaddr6
-
-IPv6 is gracefully degraded: if the IPv6 multicast join fails, the server continues in IPv4-only mode.
-
-Auto-detection for IPv6 scans interfaces via `getifaddrs`, preferring a global unicast address over link-local. The routing-table connect trick used for IPv4 does not work here: Linux requires `sin6_scope_id != 0` for link-local multicast destinations such as `FF02::C`. On multi-homed systems use `-i`.
-
-Note: `onvif_simple_server` IPv6 advertising is tracked separately.
+Discovery joins the IPv4 and IPv6 multicast groups on every active,
+multicast-capable interface, excluding loopback. Each usable address sends
+an announcement with the shared device UUID. Linux routing notifications
+update memberships and announce newly usable addresses, including addresses
+that complete IPv6 duplicate-address detection after startup.
+
+Probe replies use packet metadata to select the receiving interface and
+local address. Unicast probes retain their destination address; multicast
+probes use a local address on the receiving interface. IPv6 addresses in
+service URLs are bracketed. CGI service URLs use the HTTP connection's
+`SERVER_ADDR`, supplied by the web server.
 
 ### onvif_notify_server
 onvif_notify_server checks the files related to the events and sends the notify message when an event is fired.
--- /dev/null
+++ b/discovery_net.c
@@ -0,0 +1,495 @@
+#define _GNU_SOURCE
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <linux/rtnetlink.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <net/if.h>
+#include <ifaddrs.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <errno.h>
+
+#include "discovery_net.h"
+
+#define DISCOVERY_PORT 3702
+#define DISCOVERY_IPV4 "239.255.255.250"
+#define DISCOVERY_IPV6 "ff02::c"
+
+struct discovery_network {
+    struct discovery_address *addresses;
+    char *interface;
+    int ipv4;
+    int ipv6;
+    int events;
+};
+
+static void addresses_free(struct discovery_address *address)
+{
+    struct discovery_address *next;
+
+    while (address) {
+        next = address->next;
+        free(address);
+        address = next;
+    }
+}
+
+void discovery_network_close(struct discovery_network *network)
+{
+    if (network->ipv4 >= 0)
+        close(network->ipv4);
+    if (network->ipv6 >= 0)
+        close(network->ipv6);
+    if (network->events >= 0)
+        close(network->events);
+    addresses_free(network->addresses);
+    free(network->interface);
+    free(network);
+}
+
+static int socket_open(int family)
+{
+    const struct sockaddr *address;
+    struct sockaddr_in6 ipv6;
+    struct sockaddr_in ipv4;
+    socklen_t length;
+    int enabled = 1;
+    int descriptor;
+    int saved;
+
+    descriptor = socket(family, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (descriptor < 0)
+        return -1;
+    if (setsockopt(descriptor, SOL_SOCKET, SO_REUSEADDR, &enabled, sizeof(enabled)))
+        goto error;
+    if (family == AF_INET) {
+        memset(&ipv4, 0, sizeof(ipv4));
+        ipv4.sin_family = AF_INET;
+        ipv4.sin_port = htons(DISCOVERY_PORT);
+        address = (struct sockaddr *)&ipv4;
+        length = sizeof(ipv4);
+        if (setsockopt(descriptor, IPPROTO_IP, IP_PKTINFO, &enabled, sizeof(enabled)))
+            goto error;
+    } else {
+        memset(&ipv6, 0, sizeof(ipv6));
+        ipv6.sin6_family = AF_INET6;
+        ipv6.sin6_port = htons(DISCOVERY_PORT);
+        address = (struct sockaddr *)&ipv6;
+        length = sizeof(ipv6);
+        if (setsockopt(descriptor, IPPROTO_IPV6, IPV6_V6ONLY, &enabled, sizeof(enabled)) ||
+            setsockopt(descriptor, IPPROTO_IPV6, IPV6_RECVPKTINFO, &enabled, sizeof(enabled)))
+            goto error;
+    }
+    if (bind(descriptor, address, length))
+        goto error;
+    return descriptor;
+
+error:
+    saved = errno;
+    close(descriptor);
+    errno = saved;
+    return -1;
+}
+
+struct discovery_network *discovery_network_open(const char *interface)
+{
+    struct discovery_network *network;
+    struct sockaddr_nl address;
+    int saved;
+
+    network = calloc(1, sizeof(*network));
+    if (!network)
+        return NULL;
+    network->ipv4 = -1;
+    network->ipv6 = -1;
+    network->events = -1;
+    if (interface) {
+        network->interface = strdup(interface);
+        if (!network->interface)
+            goto error;
+    }
+    network->ipv4 = socket_open(AF_INET);
+    if (network->ipv4 < 0 && errno != EAFNOSUPPORT && errno != EPROTONOSUPPORT)
+        goto error;
+    network->ipv6 = socket_open(AF_INET6);
+    if (network->ipv6 < 0 && errno != EAFNOSUPPORT && errno != EPROTONOSUPPORT)
+        goto error;
+    if (network->ipv4 < 0 && network->ipv6 < 0)
+        goto error;
+    network->events = socket(AF_NETLINK, SOCK_RAW | SOCK_CLOEXEC, NETLINK_ROUTE);
+    if (network->events < 0)
+        goto error;
+    memset(&address, 0, sizeof(address));
+    address.nl_family = AF_NETLINK;
+    address.nl_groups = RTMGRP_LINK | RTMGRP_IPV4_IFADDR | RTMGRP_IPV6_IFADDR;
+    if (bind(network->events, (struct sockaddr *)&address, sizeof(address)))
+        goto error;
+    return network;
+
+error:
+    saved = errno;
+    discovery_network_close(network);
+    errno = saved;
+    return NULL;
+}
+
+static int address_present(const struct discovery_address *list,
+                           const struct discovery_address *address, int membership)
+{
+    const struct sockaddr_in6 *ipv6;
+    const struct sockaddr_in *ipv4;
+    const void *candidate;
+    const void *wanted;
+    size_t length;
+
+    if (address->address.ss_family == AF_INET) {
+        ipv4 = (const struct sockaddr_in *)&address->address;
+        wanted = &ipv4->sin_addr;
+        length = sizeof(ipv4->sin_addr);
+    } else {
+        ipv6 = (const struct sockaddr_in6 *)&address->address;
+        wanted = &ipv6->sin6_addr;
+        length = sizeof(ipv6->sin6_addr);
+    }
+    for (; list; list = list->next) {
+        if (list->interface != address->interface ||
+            list->address.ss_family != address->address.ss_family)
+            continue;
+        if (membership)
+            return 1;
+        if (list->address.ss_family == AF_INET) {
+            ipv4 = (const struct sockaddr_in *)&list->address;
+            candidate = &ipv4->sin_addr;
+        } else {
+            ipv6 = (const struct sockaddr_in6 *)&list->address;
+            candidate = &ipv6->sin6_addr;
+        }
+        if (!memcmp(wanted, candidate, length))
+            return 1;
+    }
+    return 0;
+}
+
+static int address_ready(const struct sockaddr *address)
+{
+    const struct sockaddr_in6 *ipv6;
+    const struct sockaddr_in *ipv4;
+    int descriptor;
+    int status;
+    int saved;
+
+    if (address->sa_family == AF_INET) {
+        ipv4 = (const struct sockaddr_in *)address;
+        return ipv4->sin_addr.s_addr != INADDR_ANY &&
+               ipv4->sin_addr.s_addr != INADDR_BROADCAST &&
+               !IN_MULTICAST(ntohl(ipv4->sin_addr.s_addr));
+    }
+    ipv6 = (const struct sockaddr_in6 *)address;
+    if (IN6_IS_ADDR_UNSPECIFIED(&ipv6->sin6_addr) || IN6_IS_ADDR_MULTICAST(&ipv6->sin6_addr))
+        return 0;
+    descriptor = socket(AF_INET6, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+    if (descriptor < 0)
+        return -1;
+    status = bind(descriptor, address, sizeof(*ipv6));
+    saved = errno;
+    close(descriptor);
+    errno = saved;
+    if (!status)
+        return 1;
+    return errno == EADDRNOTAVAIL || errno == ENODEV ? 0 : -1;
+}
+
+static int addresses_read(struct discovery_network *network, struct discovery_address **result)
+{
+    struct discovery_address *address;
+    struct discovery_address *list;
+    struct ifaddrs *interfaces;
+    struct ifaddrs *interface;
+    int family;
+    int ready;
+    int saved;
+
+    if (getifaddrs(&interfaces))
+        return -1;
+    list = NULL;
+    for (interface = interfaces; interface; interface = interface->ifa_next) {
+        if (!interface->ifa_addr || !(interface->ifa_flags & IFF_UP) ||
+            !(interface->ifa_flags & IFF_MULTICAST) || (interface->ifa_flags & IFF_LOOPBACK))
+            continue;
+        if (network->interface && strcmp(network->interface, interface->ifa_name))
+            continue;
+        family = interface->ifa_addr->sa_family;
+        if ((family != AF_INET && family != AF_INET6) ||
+            (family == AF_INET && network->ipv4 < 0) ||
+            (family == AF_INET6 && network->ipv6 < 0))
+            continue;
+        ready = address_ready(interface->ifa_addr);
+        if (ready < 0)
+            goto error;
+        if (!ready)
+            continue;
+        address = calloc(1, sizeof(*address));
+        if (!address)
+            goto error;
+        memcpy(&address->address, interface->ifa_addr,
+               family == AF_INET ? sizeof(struct sockaddr_in) : sizeof(struct sockaddr_in6));
+        address->interface = if_nametoindex(interface->ifa_name);
+        if (!address->interface) {
+            free(address);
+            continue;
+        }
+        address->next = list;
+        list = address;
+    }
+    freeifaddrs(interfaces);
+    *result = list;
+    return 0;
+
+error:
+    saved = errno;
+    freeifaddrs(interfaces);
+    addresses_free(list);
+    errno = saved;
+    return -1;
+}
+
+static int membership_set(struct discovery_network *network,
+                          const struct discovery_address *address, int join)
+{
+    struct ipv6_mreq ipv6;
+    struct ip_mreqn ipv4;
+
+    if (address->address.ss_family == AF_INET) {
+        memset(&ipv4, 0, sizeof(ipv4));
+        inet_pton(AF_INET, DISCOVERY_IPV4, &ipv4.imr_multiaddr);
+        ipv4.imr_ifindex = address->interface;
+        return setsockopt(network->ipv4, IPPROTO_IP,
+                          join ? IP_ADD_MEMBERSHIP : IP_DROP_MEMBERSHIP, &ipv4, sizeof(ipv4));
+    }
+    memset(&ipv6, 0, sizeof(ipv6));
+    inet_pton(AF_INET6, DISCOVERY_IPV6, &ipv6.ipv6mr_multiaddr);
+    ipv6.ipv6mr_interface = address->interface;
+    return setsockopt(network->ipv6, IPPROTO_IPV6,
+                      join ? IPV6_JOIN_GROUP : IPV6_LEAVE_GROUP, &ipv6, sizeof(ipv6));
+}
+
+int discovery_network_refresh(struct discovery_network *network,
+                              discovery_announce_fn announce, void *data)
+{
+    struct discovery_address *addresses;
+    struct discovery_address *address;
+    struct discovery_address *old;
+
+    if (addresses_read(network, &addresses))
+        return -1;
+    old = network->addresses;
+    for (address = old; address; address = address->next) {
+        if (address_present(address->next, address, 1) || address_present(addresses, address, 1))
+            continue;
+        if (membership_set(network, address, 0) && errno != ENODEV && errno != EADDRNOTAVAIL) {
+            addresses_free(addresses);
+            return -1;
+        }
+    }
+    for (address = addresses; address; address = address->next) {
+        if (address_present(address->next, address, 1) || address_present(old, address, 1))
+            continue;
+        if (membership_set(network, address, 1)) {
+            addresses_free(addresses);
+            return -1;
+        }
+    }
+    network->addresses = addresses;
+    for (address = addresses; address; address = address->next)
+        if (!address_present(old, address, 0))
+            announce(network, address, data);
+    addresses_free(old);
+    return 0;
+}
+
+void discovery_network_announce(struct discovery_network *network,
+                                discovery_announce_fn announce, void *data)
+{
+    const struct discovery_address *address;
+
+    for (address = network->addresses; address; address = address->next)
+        announce(network, address, data);
+}
+
+int discovery_network_send(struct discovery_network *network,
+                           const struct discovery_address *local,
+                           const struct sockaddr *destination, socklen_t length,
+                           const char *buffer, size_t size)
+{
+    union {
+        char data[CMSG_SPACE(sizeof(struct in6_pktinfo)) + CMSG_SPACE(sizeof(struct in_pktinfo))];
+        struct cmsghdr alignment;
+    } control;
+    const struct sockaddr_in6 *ipv6;
+    const struct sockaddr_in *ipv4;
+    struct in6_pktinfo *info6;
+    struct in_pktinfo *info4;
+    struct cmsghdr *header;
+    struct msghdr message;
+    struct iovec vector;
+    int descriptor;
+
+    memset(&message, 0, sizeof(message));
+    memset(&control, 0, sizeof(control));
+    vector.iov_base = (void *)buffer;
+    vector.iov_len = size;
+    message.msg_name = (void *)destination;
+    message.msg_namelen = length;
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.data;
+    if (local->address.ss_family == AF_INET) {
+        descriptor = network->ipv4;
+        message.msg_controllen = CMSG_SPACE(sizeof(*info4));
+        header = CMSG_FIRSTHDR(&message);
+        header->cmsg_level = IPPROTO_IP;
+        header->cmsg_type = IP_PKTINFO;
+        header->cmsg_len = CMSG_LEN(sizeof(*info4));
+        info4 = (struct in_pktinfo *)CMSG_DATA(header);
+        ipv4 = (const struct sockaddr_in *)&local->address;
+        info4->ipi_ifindex = local->interface;
+        info4->ipi_spec_dst = ipv4->sin_addr;
+    } else {
+        descriptor = network->ipv6;
+        message.msg_controllen = CMSG_SPACE(sizeof(*info6));
+        header = CMSG_FIRSTHDR(&message);
+        header->cmsg_level = IPPROTO_IPV6;
+        header->cmsg_type = IPV6_PKTINFO;
+        header->cmsg_len = CMSG_LEN(sizeof(*info6));
+        info6 = (struct in6_pktinfo *)CMSG_DATA(header);
+        ipv6 = (const struct sockaddr_in6 *)&local->address;
+        info6->ipi6_ifindex = local->interface;
+        info6->ipi6_addr = ipv6->sin6_addr;
+    }
+    return sendmsg(descriptor, &message, 0) < 0 ? -1 : 0;
+}
+
+static int packet_address_set(struct discovery_network *network,
+                              struct discovery_packet *packet, const struct msghdr *message)
+{
+    const struct discovery_address *candidate;
+    const struct discovery_address *selected;
+    const struct sockaddr_in6 *peer;
+    struct sockaddr_in6 *ipv6;
+    struct sockaddr_in *ipv4;
+    const struct in6_pktinfo *info6;
+    const struct in_pktinfo *info4;
+    struct cmsghdr *header;
+
+    for (header = CMSG_FIRSTHDR(message); header;
+         header = CMSG_NXTHDR((struct msghdr *)message, header)) {
+        if (header->cmsg_level == IPPROTO_IP && header->cmsg_type == IP_PKTINFO &&
+            header->cmsg_len >= CMSG_LEN(sizeof(*info4))) {
+            info4 = (const struct in_pktinfo *)CMSG_DATA(header);
+            ipv4 = (struct sockaddr_in *)&packet->local.address;
+            ipv4->sin_family = AF_INET;
+            ipv4->sin_addr = IN_MULTICAST(ntohl(info4->ipi_addr.s_addr)) ?
+                            info4->ipi_spec_dst : info4->ipi_addr;
+            packet->local.interface = info4->ipi_ifindex;
+            return 0;
+        }
+        if (header->cmsg_level != IPPROTO_IPV6 || header->cmsg_type != IPV6_PKTINFO ||
+            header->cmsg_len < CMSG_LEN(sizeof(*info6)))
+            continue;
+        info6 = (const struct in6_pktinfo *)CMSG_DATA(header);
+        ipv6 = (struct sockaddr_in6 *)&packet->local.address;
+        ipv6->sin6_family = AF_INET6;
+        ipv6->sin6_addr = info6->ipi6_addr;
+        packet->local.interface = info6->ipi6_ifindex;
+        if (!IN6_IS_ADDR_MULTICAST(&ipv6->sin6_addr))
+            return 0;
+        peer = (const struct sockaddr_in6 *)&packet->peer;
+        selected = NULL;
+        for (candidate = network->addresses; candidate; candidate = candidate->next) {
+            if (candidate->interface != packet->local.interface ||
+                candidate->address.ss_family != AF_INET6)
+                continue;
+            if (!selected)
+                selected = candidate;
+            ipv6 = (struct sockaddr_in6 *)&candidate->address;
+            if (!!IN6_IS_ADDR_LINKLOCAL(&ipv6->sin6_addr) ==
+                !!IN6_IS_ADDR_LINKLOCAL(&peer->sin6_addr)) {
+                selected = candidate;
+                break;
+            }
+        }
+        if (!selected)
+            return -1;
+        packet->local = *selected;
+        packet->local.next = NULL;
+        return 0;
+    }
+    return -1;
+}
+
+int discovery_network_receive(struct discovery_network *network, char *buffer,
+                              size_t length, struct discovery_packet *packet)
+{
+    union {
+        char data[CMSG_SPACE(sizeof(struct in6_pktinfo)) + CMSG_SPACE(sizeof(struct in_pktinfo))];
+        struct cmsghdr alignment;
+    } control;
+    struct msghdr message;
+    struct iovec vector;
+    ssize_t received;
+    fd_set descriptors;
+    int descriptor;
+    int maximum;
+    int status;
+
+    FD_ZERO(&descriptors);
+    FD_SET(network->events, &descriptors);
+    maximum = network->events;
+    if (network->ipv4 >= 0) {
+        FD_SET(network->ipv4, &descriptors);
+        if (network->ipv4 > maximum)
+            maximum = network->ipv4;
+    }
+    if (network->ipv6 >= 0) {
+        FD_SET(network->ipv6, &descriptors);
+        if (network->ipv6 > maximum)
+            maximum = network->ipv6;
+    }
+    status = select(maximum + 1, &descriptors, NULL, NULL, NULL);
+    if (status < 0)
+        return -1;
+    if (FD_ISSET(network->events, &descriptors)) {
+        received = recv(network->events, buffer, length, 0);
+        if (received < 0 && errno != ENOBUFS)
+            return -1;
+        return 0;
+    }
+    descriptor = network->ipv4 >= 0 && FD_ISSET(network->ipv4, &descriptors) ?
+                 network->ipv4 : network->ipv6;
+    memset(packet, 0, sizeof(*packet));
+    memset(&message, 0, sizeof(message));
+    vector.iov_base = buffer;
+    vector.iov_len = length - 1;
+    message.msg_name = &packet->peer;
+    message.msg_namelen = sizeof(packet->peer);
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.data;
+    message.msg_controllen = sizeof(control);
+    received = recvmsg(descriptor, &message, 0);
+    if (received < 0)
+        return -1;
+    if (message.msg_flags & (MSG_TRUNC | MSG_CTRUNC)) {
+        errno = EMSGSIZE;
+        return -1;
+    }
+    buffer[received] = '\0';
+    packet->peer_length = message.msg_namelen;
+    if (packet_address_set(network, packet, &message)) {
+        errno = EADDRNOTAVAIL;
+        return -1;
+    }
+    return 1;
+}
