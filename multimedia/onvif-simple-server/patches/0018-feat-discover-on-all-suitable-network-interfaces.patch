+from collections import deque
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import threading
+import unittest
+import uuid
+import xml.etree.ElementTree as ET
+
+ROOT = Path(__file__).resolve().parent.parent
+IDENTITY = 'b47bd8ea-7b8b-58c7-8354-88dbaddf57aa'
+
+
+class DiscoveryTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.directory = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.directory.cleanup)
+        cls.messages = deque(maxlen=100)
+        cls.ready = threading.Event()
+        cls.server = subprocess.Popen(
+            [str(ROOT / 'wsd_simple_server'), '-f', '-d', '5', '-u', IDENTITY,
+             '-p', str(Path(cls.directory.name) / 'pid'), '-t', str(ROOT / 'wsd_files'),
+             '-x', 'http://%s:8080/onvif/device_service'],
+            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
+        cls.addClassCleanup(cls.stop_server)
+        cls.reader = threading.Thread(target=cls.messages_read, daemon=True)
+        cls.reader.start()
+        cls.ready.wait()
+        if cls.server.poll() is not None:
+            raise AssertionError(list(cls.messages))
+
+    @classmethod
+    def messages_read(cls):
+        for message in cls.server.stderr:
+            cls.messages.append(message)
+            if 'Starting main loop.' in message:
+                cls.ready.set()
+        cls.ready.set()
+
+    @classmethod
+    def stop_server(cls):
+        cls.server.terminate()
+        cls.server.wait()
+        cls.reader.join()
+        cls.server.stderr.close()
+
+    def probe(self, family, address, host, group=None, interface=None):
+        identifier = 'urn:uuid:' + str(uuid.uuid4())
+        body = (
+            '<s:Envelope xmlns:s="http://www.w3.org/2003/05/soap-envelope" '
+            'xmlns:a="http://schemas.xmlsoap.org/ws/2004/08/addressing" '
+            'xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery">'
+            f'<s:Header><a:MessageID>{identifier}</a:MessageID>'
+            '<a:To>urn:schemas-xmlsoap-org:ws:2005:04:discovery</a:To>'
+            '<a:Action>http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe</a:Action>'
+            '</s:Header><s:Body><d:Probe/></s:Body></s:Envelope>')
+        with socket.socket(family, socket.SOCK_DGRAM) as client:
+            destination = (address, 3702)
+            if group is not None:
+                client.bind((address, 0))
+                if family == socket.AF_INET:
+                    client.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_IF,
+                                      socket.inet_aton(address))
+                    destination = (group, 3702)
+                else:
+                    client.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_MULTICAST_IF, interface)
+                    destination = (group, 3702, 0, interface)
+            client.sendto(body.encode(), destination)
+            data, peer = client.recvfrom(65535)
+        root = ET.fromstring(data)
+        self.assertEqual(peer[0], address)
+        self.assertEqual(root.findtext('.//{*}RelatesTo'), identifier)
+        self.assertEqual(root.findtext('.//{*}XAddrs'),
+                         f'http://{host}:8080/onvif/device_service')
+        self.assertEqual(root.findtext('.//{*}EndpointReference/{*}Address'),
+                         'urn:uuid:' + IDENTITY)
+
+    def test_ipv4_connection_addresses(self):
+        for address in ['127.0.0.1', '127.0.0.2']:
+            self.probe(socket.AF_INET, address, address)
+
+    def test_ipv6_connection_address(self):
+        self.probe(socket.AF_INET6, '::1', '[::1]')
+
+
+if __name__ == '__main__':
+    unittest.main()
