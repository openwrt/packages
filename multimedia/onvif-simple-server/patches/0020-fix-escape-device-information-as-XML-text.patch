 class CGITests(unittest.TestCase):
+    def test_device_information_xml_text(self):
+        fields = {
+            'manufacturer': ('Manufacturer', 'Vendor & Partners'),
+            'model': ('Model', 'Camera <one> "special"'),
+            'firmware_ver': ('FirmwareVersion', 'OS > 1 & < 2'),
+            'serial_num': ('SerialNumber', 'serial&<123>'),
+            'hardware_id': ('HardwareId', 'board_%MODEL% & "revision"'),
+        }
+        config = configuration(1)
+        config.update({key: value for key, (name, value) in fields.items()})
+        text = ('ifs=lo\nname=Profile_0\nwidth=640\nheight=480\ntype=H264\n'
+                'audio_encoder=NONE\n' +
+                ''.join(f'{key}={value}\n' for key, (name, value) in fields.items()))
+        for settings in [config, text]:
+            status, root = request('device', 'GetDeviceInformation', config=settings)
+            self.assertEqual(status, 200)
+            for name, value in fields.values():
+                self.assertEqual(root.findtext('.//{*}' + name), value)
+        config.update(manufacturer='%MODEL%', model='%HARDWARE_ID%')
+        status, root = request('device', 'GetDeviceInformation', config=config)
+        self.assertEqual(status, 200)
+        self.assertEqual(root.findtext('.//{*}Manufacturer'), '%MODEL%')
+        self.assertEqual(root.findtext('.//{*}Model'), '%HARDWARE_ID%')
+
