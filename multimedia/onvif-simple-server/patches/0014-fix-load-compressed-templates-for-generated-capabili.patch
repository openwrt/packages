-    if (file == NULL) {
-        log_error("Unable to open file %s", filename);
-        return -1;
-    }
-    if (gzip_d(file, filename) != 0) {
-        log_error("Unable to decompress file %s", filename);
-        fclose(file);
-        return -2;
-    }
-    rewind(file);
-#else
-    file = fopen(filename, "r");
-    if (!file) {
-        log_error("Unable to open file %s", filename);
-        return -3;
-    }
-#endif
-
