--- /dev/null
+++ b/test/test_compressed.py
@@ -0,0 +1,27 @@
+import gzip
+from pathlib import Path
+import tempfile
+import unittest
+
+from test_cgi import request, ROOT
+
+
+class CompressedTests(unittest.TestCase):
+    def test_capability_templates(self):
+        with tempfile.TemporaryDirectory() as directory:
+            for source in ROOT.glob('*_files/*.xml'):
+                target = Path(directory) / source.relative_to(ROOT)
+                target.parent.mkdir(exist_ok=True)
+                target.with_suffix('.xml.gz').write_bytes(gzip.compress(source.read_bytes()))
+            for service, operation, content in [
+                ('device', 'GetServices', '<IncludeCapability>true</IncludeCapability>'),
+                ('device', 'GetCapabilities', ''),
+                ('media', 'GetServiceCapabilities', ''),
+                ('media2', 'GetServiceCapabilities', '')]:
+                with self.subTest(service=service, operation=operation):
+                    self.assertEqual(request(service, operation, content,
+                                             template_dir=directory)[0], 200)
+
+
+if __name__ == '__main__':
+    unittest.main()
--- a/utils.c
+++ b/utils.c
@@ -346,6 +346,25 @@ long cat_soap_fault(char* out, const cha
  * @param ... The argument list to replace: src1, dst1, src2, dst2, etc...
  * @return the number of processed bytes
  */
+FILE *template_open(char *filename)
+{
+    FILE *file;
+
+#ifdef USE_ZLIB
+    file = tmpfile();
+    if (!file)
+        return NULL;
+    if (gzip_d(file, filename)) {
+        fclose(file);
+        return NULL;
+    }
+    rewind(file);
+#else
+    file = fopen(filename, "r");
+#endif
+    return file;
+}
+
 long cat(char *out, char *filename, int num, ...)
 {
     va_list valist;
@@ -360,26 +379,7 @@ long cat(char *out, char *filename, int
     // Reset SOAP fault flag for normal file operations
