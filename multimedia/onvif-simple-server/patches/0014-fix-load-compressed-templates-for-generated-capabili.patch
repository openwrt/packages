--- a/soap.c
+++ b/soap.c
@@ -59,6 +59,19 @@ ezxml_t soap_response_create(int version
     return soap_member_add(body, version, name);
 }
 
+ezxml_t soap_template_load(char *filename)
+{
+    ezxml_t document;
+    FILE *file;
+
+    file = template_open(filename);
+    if (!file)
+        return NULL;
+    document = ezxml_parse_fp(file);
+    fclose(file);
+    return document;
+}
+
 int soap_response_send(ezxml_t response)
 {
     ezxml_t envelope;
--- a/soap.h
+++ b/soap.h
@@ -9,6 +9,7 @@ ezxml_t soap_number_add(ezxml_t parent,
 void soap_range_add(ezxml_t parent, const char *name, double minimum, double maximum);
 ezxml_t soap_member_add(ezxml_t parent, int version, const char *name);
 ezxml_t soap_response_create(int version, const char *operation);
+ezxml_t soap_template_load(char *filename);
 int soap_response_send(ezxml_t response);
 
 #endif
