 media_capabilities.c    |  2 +-
 soap.c                  | 13 +++++++++++++
 soap.h                  |  1 +
 test/README.md          |  3 +++
 test/test_cgi.py        |  4 ++--
 test/test_compressed.py | 27 +++++++++++++++++++++++++++
 utils.c                 | 40 ++++++++++++++++++++--------------------
 utils.h                 |  1 +
 9 files changed, 69 insertions(+), 24 deletions(-)
 create mode 100644 test/test_compressed.py

--- a/device_advertisement.c
+++ b/device_advertisement.c
@@ -147,7 +147,7 @@ int device_advertisement_send(int servic
         return send_fault("device_service", "Receiver", "ter:ActionNotSupported", "ter:NoSuchService",
                           "No such service", "The requested service category is unavailable");
     }
-    envelope = ezxml_parse_file(filename);
+    envelope = soap_template_load(filename);
     if (!envelope || *ezxml_error(envelope)) {
         ezxml_free(envelope);
         return send_action_failed_fault("device_service", -1);
--- a/media_capabilities.c
+++ b/media_capabilities.c
