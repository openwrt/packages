+import json
+import os
+from pathlib import Path
+import unittest
+import xml.etree.ElementTree as ET
+
+from lxml import etree
+import xmlschema
+
+from test_cgi import configuration, helper_configuration, request, NS
+
+XS = '{http://www.w3.org/2001/XMLSchema}'
+SCHEMA_DIR = Path(os.environ['ONVIF_SCHEMA_DIR'])
+
+
+def schema_load(service):
+    paths = {'media': 'ver10/media/wsdl/media.wsdl',
+             'media2': 'ver20/media/wsdl/media.wsdl',
+             'imaging': 'ver20/imaging/wsdl/imaging.wsdl'}
+    path = SCHEMA_DIR / 'wsdl' / paths[service]
+    parser = etree.XMLParser(no_network=True)
+    document = etree.parse(str(path), parser)
+    node = document.find('.//' + XS + 'schema')
+    catalogue = json.loads((SCHEMA_DIR / 'catalogue.json').read_text())
+    return xmlschema.XMLSchema11(etree.tostring(node), base_url=str(path.parent),
+                                 uri_mapper=catalogue, allow='local')
+
+
+class SchemaTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.schemas = {service: schema_load(service) for service in ['media', 'media2', 'imaging']}
+
+    def validate(self, service, operation, content='', config=None):
+        status, root = request(service, operation, content, config)
+        self.assertEqual(status, 200)
+        payload = root.find('s:Body', NS)[0]
+        self.schemas[service].validate(ET.tostring(payload))
+        return root
+
+    def test_media(self):
+        config = configuration(5)
+        config.update(source_width=3840, source_height=2160, source_framerate=30)
+        for i, codec in enumerate(['JPEG', 'H264', 'H264', 'H265', 'H264']):
+            config['profiles'][i]['type'] = codec
+            config['profiles'][i]['encoding_profile'] = 'Main' if codec == 'H265' else 'High'
+        config['profiles'][0]['snapurl'] = 'http://%s/snapshot.jpg'
+        for service in ['media', 'media2']:
+            for operation, content in [
+                ('GetProfiles', '<Type>All</Type>'),
+                ('GetVideoEncoderConfigurations', ''),
+                ('GetVideoEncoderConfigurationOptions', ''),
+                ('GetVideoSourceConfigurations', ''),
+                ('GetVideoSourceConfigurationOptions', ''),
+                ('GetServiceCapabilities', ''),
+                ('GetStreamUri', '<ProfileToken>Profile_0</ProfileToken>'),
+                ('GetSnapshotUri', '<ProfileToken>Profile_0</ProfileToken>')]:
+                with self.subTest(service=service, operation=operation):
+                    self.validate(service, operation, content, config)
+        self.validate('media', 'GetVideoSources', config=config)
+        self.validate('media2', 'GetVideoSourceModes',
+                      '<VideoSourceToken>VideoSourceToken</VideoSourceToken>', config)
+
+    def test_encoder_helper(self):
+        with helper_configuration() as (config, path):
+            for service in ['media', 'media2']:
+                self.validate(service, 'GetProfiles', '<Type>All</Type>', config)
+                self.validate(service, 'GetVideoEncoderConfigurationOptions', config=config)
+
+    def test_imaging_helper(self):
+        with helper_configuration() as (config, path):
+            config['imaging_helper'] = config.pop('encoder_helper')
+            path.write_text(json.dumps({'settings': {'brightness': 45,
+                                                   'exposure': {'mode': 'MANUAL', 'gain': 12,
+                                                                'exposure_time': 10000},
+                                                   'white_balance': {'mode': 'AUTO'}},
+                                        'options': {'exposure': {'mode': ['AUTO', 'MANUAL'],
+                                                                 'gain': {'min': 0, 'max': 40}},
+                                                    'white_balance': {'mode': ['AUTO', 'MANUAL'],
+                                                                      'cr_gain': {'min': 0.1, 'max': 4}}}}))
+            source = '<VideoSourceToken>VideoSourceToken</VideoSourceToken>'
+            self.validate('imaging', 'GetImagingSettings', source, config)
+            self.validate('imaging', 'GetOptions', source, config)
+            self.validate('imaging', 'GetServiceCapabilities', config=config)
+
+
+if __name__ == '__main__':
+    unittest.main()
