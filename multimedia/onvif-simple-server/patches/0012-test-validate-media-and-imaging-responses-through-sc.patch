+import http.client
+import json
+import os
+from pathlib import Path
+import shlex
+import socket
+import subprocess
+import tempfile
+import time
+import unittest
+import xml.etree.ElementTree as ET
+
+from test_cgi import configuration, NS, ROOT
+
+
+class HTTPTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.directory = tempfile.TemporaryDirectory()
+        cls.addClassCleanup(cls.directory.cleanup)
+        directory = Path(cls.directory.name)
+        config = directory / 'config.json'
+        config.write_text(json.dumps(configuration(4)))
+        endpoints = directory / 'onvif'
+        endpoints.mkdir()
+        for service in ['device', 'media', 'media2', 'imaging']:
+            script = endpoints / f'{service}_service'
+            command = [str(ROOT / 'onvif_simple_server'), '-c', str(config),
+                       f'{service}_service']
+            script.write_text('#!/bin/sh\nexport ONVIF_LOG_FILE=-\ncd ' +
+                              shlex.quote(str(ROOT)) + '\nexec ' + shlex.join(command) + '\n')
+            script.chmod(0o755)
+        with socket.socket() as listener:
+            listener.bind(('127.0.0.1', 0))
+            cls.port = listener.getsockname()[1]
+        command = json.loads(os.environ['UHTTPD_COMMAND'])
+        command += ['-f', '-p', f'127.0.0.1:{cls.port}', '-h', str(directory), '-x', '/onvif']
+        cls.server = subprocess.Popen(command, env=dict(os.environ, ONVIF_LOG_FILE='-'),
+                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+        cls.addClassCleanup(cls.stop_server)
+        deadline = time.monotonic() + 5
+        while time.monotonic() < deadline:
+            try:
+                with socket.create_connection(('127.0.0.1', cls.port), timeout=0.1):
+                    return
+            except OSError:
+                time.sleep(0.01)
+        raise AssertionError('uhttpd did not start')
+
+    @classmethod
+    def stop_server(cls):
+        cls.server.terminate()
+        cls.server.wait(timeout=5)
+
+    def post(self, operation):
+        body = (f'<s:Envelope xmlns:s="{NS["s"]}"><s:Body>'
+                f'<tr2:{operation} xmlns:tr2="{NS["tr2"]}"><tr2:Type>All</tr2:Type>'
+                f'</tr2:{operation}></s:Body></s:Envelope>')
+        connection = http.client.HTTPConnection('127.0.0.1', self.port, timeout=5)
+        self.addCleanup(connection.close)
+        connection.request('POST', '/onvif/media2_service', body.encode(),
+                           {'Content-Type': 'application/soap+xml; charset=utf-8'})
+        response = connection.getresponse()
+        data = response.read()
+        try:
+            root = ET.fromstring(data)
+        except ET.ParseError:
+            self.fail((response.status, data.decode(errors='replace')))
+        return response.status, root
+
+    def test_profiles(self):
+        status, root = self.post('GetProfiles')
+        self.assertEqual(status, 200)
+        self.assertEqual(len(root.findall('.//tr2:Profiles', NS)), 4)
+
+    def test_fault(self):
+        status, root = self.post('UnknownOperation')
+        self.assertEqual(status, 500)
+        self.assertIsNotNone(root.find('.//s:Fault', NS))
+
+
+if __name__ == '__main__':
+    unittest.main()
