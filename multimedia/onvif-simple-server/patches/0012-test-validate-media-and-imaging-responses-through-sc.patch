+import hashlib
+import json
+from pathlib import Path
+import sys
+from urllib.parse import urljoin
+from urllib.request import urlopen
+import xml.etree.ElementTree as ET
+
+REVISION = '68ee1b540a40f848c9599eba2c55b87547c588d6'
+root = Path(sys.argv[1]).resolve()
+sources = {
+    'https://www.w3.org/2005/05/xmlmime': root / 'external/xmlmime.xsd',
+    'https://www.w3.org/2003/05/soap-envelope': root / 'external/soap-envelope.xsd',
+    'http://docs.oasis-open.org/wsn/b-2.xsd': root / 'external/b-2.xsd',
+    'https://www.w3.org/2004/08/xop/include': root / 'external/xop.xsd',
+}
+for name in ['ver10/schema/onvif.xsd', 'ver10/schema/common.xsd',
+             'ver10/media/wsdl/media.wsdl', 'ver20/media/wsdl/media.wsdl',
+             'ver20/imaging/wsdl/imaging.wsdl']:
+    url = f'https://raw.githubusercontent.com/onvif/specs/{REVISION}/wsdl/{name}'
+    sources[url] = root / 'wsdl' / name
+pending = list(sources)
+seen = set()
+while pending:
+    url = pending.pop(0)
+    if url in seen:
+        continue
+    seen.add(url)
+    path = sources[url]
+    if not path.exists():
+        data = urlopen(url.replace('http://', 'https://'), timeout=20).read()
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_bytes(data)
+    document = ET.parse(path)
+    schemas = [document.getroot(), *document.findall('.//{http://www.w3.org/2001/XMLSchema}schema')]
+    for schema in schemas:
+        for node in schema:
+            location = node.get('schemaLocation')
+            if not location:
+                continue
+            dependency = urljoin(url, location)
+            if dependency not in sources:
+                sources[dependency] = root / 'external' / dependency.split('/')[-1]
+            pending.append(dependency)
+    print(path)
+(root / 'catalogue.json').write_text(json.dumps({u: str(p) for u, p in sources.items()}))
+(root / 'manifest.json').write_text(json.dumps({
+    'revision': REVISION,
+    'sha256': {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
+               for p in sources.values()}}, indent=2))
