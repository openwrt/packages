+extern service_context_t service_ctx;
+
+struct imaging_field {
+    const char *key;
+    const char *name;
+    const struct imaging_field *children;
+};
+
+static const struct imaging_field exposure_fields[] = {
+    { "mode", "Mode", NULL },
+    { "min_exposure_time", "MinExposureTime", NULL },
+    { "max_exposure_time", "MaxExposureTime", NULL },
+    { "min_gain", "MinGain", NULL },
+    { "max_gain", "MaxGain", NULL },
+    { "min_iris", "MinIris", NULL },
+    { "max_iris", "MaxIris", NULL },
+    { "exposure_time", "ExposureTime", NULL },
+    { "gain", "Gain", NULL },
+    { "iris", "Iris", NULL },
+    { NULL, NULL, NULL }
+};
+
+static const struct imaging_field white_balance_fields[] = {
+    { "mode", "Mode", NULL },
+    { "cr_gain", "CrGain", NULL },
+    { "cb_gain", "CbGain", NULL },
+    { NULL, NULL, NULL }
+};
+
+static const struct imaging_field imaging_fields[] = {
+    { "brightness", "Brightness", NULL },
+    { "colour_saturation", "ColorSaturation", NULL },
+    { "contrast", "Contrast", NULL },
+    { "exposure", "Exposure", exposure_fields },
+    { "sharpness", "Sharpness", NULL },
+    { "white_balance", "WhiteBalance", white_balance_fields },
+    { NULL, NULL, NULL }
+};
+
+static int number_read(json_object *value, double *number)
+{
+    if (!json_object_is_type(value, json_type_double) &&
+        !json_object_is_type(value, json_type_int))
+        return -1;
+    *number = json_object_get_double(value);
+    return isfinite(*number) && fabs(*number) <= FLT_MAX ? 0 : -1;
+}
+
+static int mode_add(ezxml_t parent, json_object *value, int options)
+{
+    json_object *entry;
+    const char *mode;
+    size_t count;
+    size_t i;
+
+    if (options && !json_object_is_type(value, json_type_array))
+        return -1;
+    count = options ? json_object_array_length(value) : 1;
+    if (!count || count > 2)
+        return -1;
+    for (i = 0; i < count; i++) {
+        entry = options ? json_object_array_get_idx(value, i) : value;
+        if (!json_object_is_type(entry, json_type_string))
+            return -1;
+        mode = json_object_get_string(entry);
+        if (strcmp(mode, "AUTO") && strcmp(mode, "MANUAL"))
+            return -1;
+        soap_child_add(parent, "tt:Mode", mode);
+    }
+    return 0;
+}
+
+static int numeric_add(ezxml_t parent, const char *name, json_object *value, int options)
+{
+    json_object *minimum_value;
+    json_object *maximum_value;
+    double minimum;
+    double maximum;
+
+    if (!options) {
+        if (number_read(value, &minimum))
+            return -1;
+        soap_number_add(parent, name, minimum);
+        return 0;
+    }
+    if (!json_object_is_type(value, json_type_object) ||
+        !json_object_object_get_ex(value, "min", &minimum_value) ||
+        !json_object_object_get_ex(value, "max", &maximum_value) ||
+        number_read(minimum_value, &minimum) || number_read(maximum_value, &maximum) ||
+        maximum < minimum)
+        return -1;
+    soap_range_add(parent, name, minimum, maximum);
+    return 0;
+}
+
+static int fields_add(ezxml_t parent, json_object *object,
+                      const struct imaging_field *fields, int options)
+{
+    const struct imaging_field *field;
+    json_object *value;
+    char name[64];
+    int found;
+
+    if (!json_object_is_type(object, json_type_object))
+        return -1;
+    found = 0;
+    for (field = fields; field->key; field++) {
+        if (!json_object_object_get_ex(object, field->key, &value))
+            continue;
+        found++;
+        snprintf(name, sizeof(name), "tt:%s", field->name);
+        if (options && fields == white_balance_fields && !strcmp(field->key, "cr_gain"))
+            snprintf(name, sizeof(name), "tt:YrGain");
+        if (options && fields == white_balance_fields && !strcmp(field->key, "cb_gain"))
+            snprintf(name, sizeof(name), "tt:YbGain");
+        if (field->children) {
+            if (fields_add(soap_child_add(parent, name, NULL), value, field->children, options))
+                return -1;
+        } else if (!strcmp(field->key, "mode")) {
+            if (mode_add(parent, value, options))
+                return -1;
+        } else if (numeric_add(parent, name, value, options)) {
+            return -1;
+        }
+    }
+    if (found != json_object_object_length(object))
+        return -1;
+    if (fields != imaging_fields && !json_object_object_get_ex(object, "mode", &value))
+        return -1;
+    return 0;
+}
+
+static json_object *fields_parse(ezxml_t node, const struct imaging_field *fields)
+{
+    const struct imaging_field *field;
+    const char *namespace;
+    const char *name;
+    json_object *object;
+    json_object *value;
+    ezxml_t child;
+    char *end;
+    double number;
+
+    if (!node)
+        return NULL;
+    object = json_object_new_object();
+    for (child = node->child; child; child = child->ordered) {
+        namespace = xml_namespace_get(child);
+        if (!namespace || strcmp(namespace, "http://www.onvif.org/ver10/schema"))
+            goto invalid;
+        name = strchr(child->name, ':');
+        name = name ? name + 1 : child->name;
+        for (field = fields; field->key && strcmp(field->name, name); field++)
+            ;
+        if (!field->key || json_object_object_get_ex(object, field->key, &value))
+            goto invalid;
+        if (field->children)
+            value = fields_parse(child, field->children);
+        else if (!strcmp(field->key, "mode"))
+            value = json_object_new_string(child->txt);
+        else {
+            number = strtod(child->txt, &end);
+            if (!*child->txt || *end || !isfinite(number))
+                goto invalid;
+            value = json_object_new_double(number);
+        }
+        if (!value)
+            goto invalid;
+        json_object_object_add(object, field->key, value);
+    }
+    return object;
+invalid:
+    json_object_put(object);
+    return NULL;
+}
+
+static enum helper_status imaging_call(const char *operation, json_object **reply)
+{
+    enum helper_status status;
+    const char *persistence;
+    json_object *request;
+    json_object *settings;
+    ezxml_t validation;
+
+    request = json_object_new_object();
+    json_object_object_add(request, "token", json_object_new_string("VideoSourceToken"));
+    if (!strcmp(operation, "set")) {
+        settings = fields_parse(get_element_ptr(NULL, "ImagingSettings", "Body"), imaging_fields);
+        validation = ezxml_new("settings");
+        if (!settings || !json_object_object_length(settings) ||
+            fields_add(validation, settings, imaging_fields, 0)) {
+            json_object_put(settings);
+            json_object_put(request);
+            ezxml_free(validation);
+            return HELPER_INVALID;
+        }
+        ezxml_free(validation);
+        json_object_object_add(request, "settings", settings);
+        persistence = get_element("ForcePersistence", "Body");
+        if (persistence && strcmp(persistence, "true") && strcmp(persistence, "1") &&
+            strcmp(persistence, "false") && strcmp(persistence, "0")) {
+            json_object_put(request);
+            return HELPER_INVALID;
+        }
+        json_object_object_add(request, "force_persistence", json_object_new_boolean(
+            persistence && (!strcmp(persistence, "true") || !strcmp(persistence, "1"))));
+    }
+    status = helper_call(service_ctx.imaging_helper, operation, request, reply);
+    json_object_put(request);
+    return status;
+}
+
+int imaging_dispatch(const char *operation)
+{
+    enum helper_status status;
+    const char *token;
+    const char *action;
+    json_object *reply;
+    json_object *value;
+    ezxml_t response;
+    ezxml_t member;
+    int options;
+    int setter;
+
+    if (!service_ctx.imaging_helper)
+        return send_action_not_supported_fault("imaging_service");
+    if (!strcmp(operation, "GetServiceCapabilities")) {
+        response = soap_response_create(3, operation);
+        soap_member_add(response, 3, "Capabilities");
+        return soap_response_send(response);
+    }
+    options = !strcmp(operation, "GetOptions");
+    setter = !strcmp(operation, "SetImagingSettings");
+    if (!options && !setter && strcmp(operation, "GetImagingSettings"))
+        return send_action_not_supported_fault("imaging_service");
+    token = get_element("VideoSourceToken", "Body");
+    if (!token || strcmp(token, "VideoSourceToken"))
+        return send_fault("imaging_service", "Sender", "ter:InvalidArgVal", "ter:NoSource",
+                          "Unknown source", "The requested video source does not exist");
+    action = options ? "options" : setter ? "set" : "get";
+    status = imaging_call(action, &reply);
+    if (status != HELPER_OK)
+        return helper_fault("imaging_service", status);
+    response = soap_response_create(3, operation);
+    member = setter ? ezxml_new("settings") : soap_member_add(response, 3,
+             options ? "ImagingOptions" : "ImagingSettings");
+    status = HELPER_FAILED;
+    if (json_object_object_get_ex(reply, "revision", &value) &&
+        json_object_is_type(value, json_type_string) && *json_object_get_string(value) &&
+        json_object_object_get_ex(reply, options ? "options" : "settings", &value) &&
+        !fields_add(member, value, imaging_fields, options))
+        status = HELPER_OK;
+    json_object_put(reply);
+    if (setter)
+        ezxml_free(member);
+    if (status == HELPER_OK)
+        return soap_response_send(response);
+    ezxml_free(response->parent->parent);
+    return helper_fault("imaging_service", status);
+}
