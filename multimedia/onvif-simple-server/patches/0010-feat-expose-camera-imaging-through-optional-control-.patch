+++ b/device_advertisement.c
@@ -0,0 +1,164 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <stdio.h>
+#include <string.h>
+
+#include "device_advertisement.h"
+#include "ezxml_wrapper.h"
+#include "fault.h"
+#include "onvif_simple_server.h"
+#include "soap.h"
+#include "utils.h"
+
+extern service_context_t service_ctx;
+
+struct template_value {
+    const char *key;
+    const char *value;
+};
+
+static void template_fill(ezxml_t node, const struct template_value *values)
+{
+    ezxml_t child;
+    int i;
+    int j;
+
+    for (i = 0; values[i].key; i++) {
+        if (!strcmp(node->txt, values[i].key))
+            ezxml_set_txt_d(node, values[i].value);
+        for (j = 0; node->attr[j]; j += 2)
+            if (!strcmp(node->attr[j + 1], values[i].key))
+                ezxml_set_attr_d(node, node->attr[j], values[i].value);
+    }
+    for (child = node->child; child; child = child->ordered)
+        template_fill(child, values);
+}
+
+static void imaging_service_add(ezxml_t response, const char *address, int include)
+{
+    ezxml_t service;
+    ezxml_t version;
+    ezxml_t capabilities;
+
+    service = ezxml_add_child_d(response, "tds:Service", strlen(response->txt));
+    soap_child_add(service, "tds:Namespace", "http://www.onvif.org/ver20/imaging/wsdl");
+    soap_child_add(service, "tds:XAddr", address);
+    if (include) {
+        capabilities = soap_child_add(service, "tds:Capabilities", NULL);
+        soap_child_add(capabilities, "timg:Capabilities", NULL);
+    }
+    version = soap_child_add(service, "tds:Version", NULL);
+    soap_number_add(version, "tt:Major", 2);
+    soap_number_add(version, "tt:Minor", 0);
+}
+
+static void imaging_capabilities_add(ezxml_t response, const char *address)
+{
+    ezxml_t capabilities;
+    ezxml_t imaging;
+    ezxml_t media;
+
+    capabilities = get_element_in_element_ptr("Capabilities", response);
+    media = get_element_in_element_ptr("Media", capabilities);
+    imaging = ezxml_add_child_d(capabilities, "tt:Imaging",
+                                media && media->off ? media->off - 1 : 0);
+    soap_child_add(imaging, "tt:XAddr", address);
+}
+
+int device_advertisement_send(int services)
+{
+    char device[MAX_LEN], media[MAX_LEN], media2[MAX_LEN], ptz[MAX_LEN];
+    char events[MAX_LEN], deviceio[MAX_LEN], imaging[MAX_LEN];
+    char audio_sources[16], audio_outputs[16], relay_outputs[16];
+    char filename[MAX_LEN];
+    char port[8];
+    const char *category;
+    const char *cap;
+    ezxml_t envelope;
+    ezxml_t response;
+    int audio_input;
+    int audio_output;
+    int include;
+    int i;
+    struct template_value values[] = {
+        { "%DEVICE_SERVICE_ADDRESS%", device },
+        { "%MEDIA_SERVICE_ADDRESS%", media },
+        { "%MEDIA2_SERVICE_ADDRESS%", media2 },
+        { "%PTZ_SERVICE_ADDRESS%", ptz },
+        { "%EVENTS_SERVICE_ADDRESS%", events },
+        { "%DEVICEIO_SERVICE_ADDRESS%", deviceio },
+        { "%EVENTS_BASESUBSCRIPTION%", "false" },
+        { "%EVENTS_PULLPOINT%", "false" },
+        { "%AUDIO_SOURCES%", audio_sources },
+        { "%AUDIO_OUTPUTS%", audio_outputs },
+        { "%RELAY_OUTPUTS%", relay_outputs },
+        { NULL, NULL }
+    };
+
+    port[0] = '\0';
+    if (service_ctx.port != 80)
+        snprintf(port, sizeof(port), ":%d", service_ctx.port);
+    snprintf(device, sizeof(device), "http://%s%s/onvif/device_service", service_ctx.address_url, port);
+    snprintf(media, sizeof(media), "http://%s%s/onvif/media_service", service_ctx.address_url, port);
+    snprintf(media2, sizeof(media2), "http://%s%s/onvif/media2_service", service_ctx.address_url, port);
+    snprintf(ptz, sizeof(ptz), "http://%s%s/onvif/ptz_service", service_ctx.address_url, port);
+    snprintf(events, sizeof(events), "http://%s%s/onvif/events_service", service_ctx.address_url, port);
+    snprintf(deviceio, sizeof(deviceio), "http://%s%s/onvif/deviceio_service", service_ctx.address_url, port);
+    snprintf(imaging, sizeof(imaging), "http://%s%s/onvif/imaging_service", service_ctx.address_url, port);
+    audio_input = 0;
+    audio_output = 0;
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        audio_input |= service_ctx.profiles[i].audio_encoder != AUDIO_NONE;
+        audio_output |= service_ctx.profiles[i].audio_decoder != AUDIO_NONE;
+    }
+    snprintf(audio_sources, sizeof(audio_sources), "%d", audio_input);
+    snprintf(audio_outputs, sizeof(audio_outputs), "%d", audio_output);
+    snprintf(relay_outputs, sizeof(relay_outputs), "%d", service_ctx.relay_outputs_num);
+    if (service_ctx.events_enable == EVENTS_BASESUBSCRIPTION || service_ctx.events_enable == EVENTS_BOTH)
+        values[6].value = "true";
+    if (service_ctx.events_enable == EVENTS_PULLPOINT || service_ctx.events_enable == EVENTS_BOTH)
+        values[7].value = "true";
+    category = get_element("Category", "Body");
+    cap = get_element("IncludeCapability", "Body");
+    include = cap && (!strcmp(cap, "true") || !strcmp(cap, "1"));
+    if (services)
+        snprintf(filename, sizeof(filename), "device_service_files/GetServices_%s%s_%s.xml",
+                 include ? "with_capabilities_" : "",
+                 service_ctx.ptz_node.enable ? "ptz" : "no_ptz",
+                 service_ctx.adv_enable_media2 ? "media2" : "no_media2");
+    else if (!category || !strcmp(category, "All"))
+        snprintf(filename, sizeof(filename), "device_service_files/GetCapabilities_%s.xml",
+                 service_ctx.ptz_node.enable ? "ptz" : "no_ptz");
+    else if (!strcmp(category, "Imaging") && service_ctx.imaging_helper) {
+        envelope = ezxml_new("SOAP-ENV:Envelope");
+        ezxml_set_attr(envelope, "xmlns:SOAP-ENV", "http://www.w3.org/2003/05/soap-envelope");
+        ezxml_set_attr(envelope, "xmlns:tds", "http://www.onvif.org/ver10/device/wsdl");
+        ezxml_set_attr(envelope, "xmlns:tt", "http://www.onvif.org/ver10/schema");
+        response = soap_child_add(envelope, "SOAP-ENV:Body", NULL);
+        response = soap_child_add(response, "tds:GetCapabilitiesResponse", NULL);
+        soap_child_add(response, "tds:Capabilities", NULL);
+        imaging_capabilities_add(response, imaging);
+        return soap_response_send(response);
+    } else if (!strcmp(category, "Device") || !strcmp(category, "Media") ||
+               !strcmp(category, "Events") ||
+               (!strcmp(category, "PTZ") && service_ctx.ptz_node.enable)) {
+        snprintf(filename, sizeof(filename), "device_service_files/Get%sCapabilities.xml", category);
+    } else {
+        return send_fault("device_service", "Receiver", "ter:ActionNotSupported", "ter:NoSuchService",
+                          "No such service", "The requested service category is unavailable");
+    }
+    envelope = ezxml_parse_file(filename);
+    if (!envelope || *ezxml_error(envelope)) {
+        ezxml_free(envelope);
+        return send_action_failed_fault("device_service", -1);
+    }
+    template_fill(envelope, values);
+    response = envelope->child->child;
+    if (service_ctx.imaging_helper) {
+        ezxml_set_attr(envelope, "xmlns:timg", "http://www.onvif.org/ver20/imaging/wsdl");
+        if (services)
+            imaging_service_add(response, imaging, include);
+        else if (!category || !strcmp(category, "All"))
+            imaging_capabilities_add(response, imaging);
+    }
+    return soap_response_send(response);
+}
