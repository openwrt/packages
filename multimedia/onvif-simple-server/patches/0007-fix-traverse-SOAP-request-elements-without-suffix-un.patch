+    static const struct {
+        const char *service;
+        const char *namespace;
+    } services[] = {
+        { "device_service", "http://www.onvif.org/ver10/device/wsdl" },
+        { "media_service", "http://www.onvif.org/ver10/media/wsdl" },
+        { "media2_service", "http://www.onvif.org/ver20/media/wsdl" },
+        { "ptz_service", "http://www.onvif.org/ver20/ptz/wsdl" },
+        { "events_service", "http://www.onvif.org/ver10/events/wsdl" },
+        { "deviceio_service", "http://www.onvif.org/ver10/deviceIO/wsdl" },
+        { "imaging_service", "http://www.onvif.org/ver20/imaging/wsdl" }
+    };
+    size_t i;
+
+    if (!namespace)
+        return 0;
+    for (i = 0; i < sizeof(services) / sizeof(services[0]); i++)
+        if (!strcmp(service, services[i].service))
+            return !strcmp(namespace, services[i].namespace);
+    return 0;
+}
