--- /dev/null
+++ b/test/test_xml.c
@@ -0,0 +1,33 @@
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "ezxml_wrapper.h"
+
+int main(void)
+{
+    char request[] = "<s:Envelope xmlns:s='http://www.w3.org/2003/05/soap-envelope'>"
+        "<s:Header><a/></s:Header><s:Body><m:Set xmlns:m='urn:test'>"
+        "<a/><b/><m:Value>42</m:Value><m:Next>43</m:Next>"
+        "</m:Set></s:Body></s:Envelope>";
+    char malformed[] = "<x>";
+    ezxml_t operation;
+
+    init_xml(request, strlen(request));
+    assert(!strcmp(get_method(1), "Set"));
+    assert(!strcmp(get_method_namespace(), "urn:test"));
+    operation = get_element_ptr(NULL, "Set", "Body");
+    assert(operation);
+    assert(!strcmp(get_element_in_element("Value", operation), "42"));
+    assert(!strcmp(get_element_in_element("Next", operation), "43"));
+    assert(get_element_in_element_ptr("Next", operation));
+    assert(!get_element_in_element("Missing", operation));
+    assert(!get_element("Value", "Header"));
+    close_xml();
+    init_xml(malformed, strlen(malformed));
+    assert(!get_method(1));
+    assert(!get_element("Value", "Body"));
+    close_xml();
+    puts("XML navigation: passed");
+    return 0;
+}
