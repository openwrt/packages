+    def test_encoder_helper_get_options_set(self):
+        with helper_configuration() as (config, path):
+            for service in ['media', 'media2']:
+                status, root = request(service, 'GetProfiles', '<Type>All</Type>', config)
+                self.assertEqual(status, 200)
