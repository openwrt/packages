+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <limits.h>
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "control_helper.h"
+#include "encoder_control.h"
+#include "ezxml_wrapper.h"
+#include "media_profiles.h"
+#include "onvif_simple_server.h"
+#include "soap.h"
+#include "utils.h"
+
+extern service_context_t service_ctx;
+
+static int integer_get(json_object *object, const char *key, int *number, int minimum)
+{
+    json_object *value;
+    int64_t integer;
+
+    if (!json_object_object_get_ex(object, key, &value) ||
+        !json_object_is_type(value, json_type_int))
+        return -1;
+    integer = json_object_get_int64(value);
+    if (integer < minimum || integer > INT_MAX)
+        return -1;
+    *number = integer;
+    return 0;
+}
+
+static int number_get(json_object *object, const char *key, double *number)
+{
+    json_object *value;
+
+    if (!json_object_object_get_ex(object, key, &value) ||
+        (!json_object_is_type(value, json_type_double) &&
+         !json_object_is_type(value, json_type_int)))
+        return -1;
+    *number = json_object_get_double(value);
+    return isfinite(*number) ? 0 : -1;
+}
+
+static int profile_update(stream_profile_t *profile, json_object *object)
+{
+    stream_profile_t candidate;
+    json_object *value;
+    const char *codec;
+    const char *encoding_profile;
+
+    candidate = *profile;
+    if (!json_object_object_get_ex(object, "type", &value) ||
+        !json_object_is_type(value, json_type_string))
+        return -1;
+    codec = json_object_get_string(value);
+    if (!strcmp(codec, "H264"))
+        candidate.type = H264;
+    else if (!strcmp(codec, "H265"))
+        candidate.type = H265;
+    else if (!strcmp(codec, "JPEG"))
+        candidate.type = JPEG;
+    else
+        return -1;
+    if (integer_get(object, "width", &candidate.width, 1) ||
+        integer_get(object, "height", &candidate.height, 1) ||
+        integer_get(object, "bitrate", &candidate.bitrate, 0) ||
+        number_get(object, "frame_rate", &candidate.frame_rate) ||
+        candidate.frame_rate <= 0 || candidate.frame_rate > INT_MAX ||
+        number_get(object, "quality", &candidate.quality) || candidate.quality < 0)
+        return -1;
+    encoding_profile = profile->encoding_profile;
+    if (candidate.type != JPEG) {
+        if (integer_get(object, "gov_length", &candidate.gov_length, 1) ||
+            !json_object_object_get_ex(object, "encoding_profile", &value) ||
+            !json_object_is_type(value, json_type_string))
+            return -1;
+        encoding_profile = json_object_get_string(value);
+        if (candidate.type == H264 && strcmp(encoding_profile, "Baseline") &&
+            strcmp(encoding_profile, "Main") && strcmp(encoding_profile, "High") &&
+            strcmp(encoding_profile, "Extended"))
+            return -1;
+        if (candidate.type == H265 && strcmp(encoding_profile, "Main") &&
+            strcmp(encoding_profile, "Main10"))
+            return -1;
+    }
+    if (json_object_object_get_ex(object, "encoding_interval", &value) &&
+        integer_get(object, "encoding_interval", &candidate.encoding_interval, 1))
+        return -1;
+    candidate.encoding_profile = strdup(encoding_profile);
+    if (!candidate.encoding_profile)
+        return -1;
+    free(profile->encoding_profile);
+    *profile = candidate;
+    return 0;
+}
+
+static int revision_valid(json_object *data)
+{
+    json_object *value;
+
+    return json_object_object_get_ex(data, "revision", &value) &&
+        json_object_is_type(value, json_type_string) && *json_object_get_string(value);
+}
+
+static int range_get(json_object *object, const char *key, double *minimum,
+                     double *maximum, int integer)
+{
+    json_object *range;
+
+    if (!json_object_object_get_ex(object, key, &range) ||
+        number_get(range, "min", minimum) || number_get(range, "max", maximum) ||
+        *minimum < 0 || *maximum < *minimum || *maximum > INT_MAX ||
+        (integer && (*minimum != (int)*minimum || *maximum != (int)*maximum)))
+        return -1;
+    return 0;
+}
+
+static int option_add(ezxml_t response, ezxml_t common, json_object *object, int version)
+{
+    json_object *value, *entries, *entry;
+    const char *codec;
+    const char *profile;
+    char numbers[MAX_LEN];
+    char profiles[MAX_LEN];
+    ezxml_t options;
+    ezxml_t encoder;
+    ezxml_t resolution;
+    double minimum;
+    double maximum;
+    double rate;
+    double previous;
+    size_t used;
+    size_t i;
+    int width;
+    int height;
+    int written;
+
+    if (!json_object_object_get_ex(object, "type", &value) ||
+        !json_object_is_type(value, json_type_string))
+        return -1;
+    codec = json_object_get_string(value);
+    if (strcmp(codec, "JPEG") && strcmp(codec, "H264") && strcmp(codec, "H265"))
+        return -1;
+    if (version == 1 && !strcmp(codec, "H265"))
+        return 0;
+    options = version == 1 ? common : soap_member_add(response, version, "Options");
+    if (range_get(object, "quality", &minimum, &maximum, version == 1))
+        return -1;
+    if (version == 2)
+        soap_child_add(options, "tt:Encoding", codec);
+    if (version == 2 || !options->child)
+        soap_range_add(options, "tt:QualityRange", minimum, maximum);
+    else {
+        snprintf(numbers, sizeof(numbers), "%.9g", minimum);
+        if (strcmp(get_element_in_element("Min", options->child), numbers))
+            return -1;
+        snprintf(numbers, sizeof(numbers), "%.9g", maximum);
+        if (strcmp(get_element_in_element("Max", options->child), numbers))
+            return -1;
+    }
+    encoder = options;
+    if (version == 1) {
+        snprintf(numbers, sizeof(numbers), "tt:%s", codec);
+        if (get_element_in_element_ptr(codec, options))
+            return -1;
+        encoder = soap_child_add(options, numbers, NULL);
+    }
+    if (!json_object_object_get_ex(object, "resolutions", &entries) ||
+        !json_object_is_type(entries, json_type_array) || !json_object_array_length(entries))
+        return -1;
+    for (i = 0; i < json_object_array_length(entries); i++) {
+        entry = json_object_array_get_idx(entries, i);
+        if (integer_get(entry, "width", &width, 1) || integer_get(entry, "height", &height, 1))
+            return -1;
+        resolution = soap_child_add(encoder, "tt:ResolutionsAvailable", NULL);
+        soap_number_add(resolution, "tt:Width", width);
+        soap_number_add(resolution, "tt:Height", height);
+    }
+    if (strcmp(codec, "JPEG")) {
+        if (range_get(object, "gov_length", &minimum, &maximum, 1) || minimum < 1)
+            return -1;
+        if (version == 1)
+            soap_range_add(encoder, "tt:GovLengthRange", minimum, maximum);
+        else {
+            snprintf(numbers, sizeof(numbers), "%.0f %.0f", minimum, maximum);
+            ezxml_set_attr_d(options, "GovLengthRange", numbers);
+        }
+    }
+    if (!json_object_object_get_ex(object, "frame_rates", &entries) ||
+        !json_object_is_type(entries, json_type_array) || !json_object_array_length(entries))
+        return -1;
+    used = 0;
+    previous = INT_MAX;
+    maximum = 0;
+    minimum = INT_MAX;
+    for (i = 0; i < json_object_array_length(entries); i++) {
+        entry = json_object_array_get_idx(entries, i);
+        if (!json_object_is_type(entry, json_type_int) &&
+            !json_object_is_type(entry, json_type_double))
+            return -1;
+        rate = json_object_get_double(entry);
+        if (!isfinite(rate) || rate <= 0 || rate > previous)
+            return -1;
+        previous = rate;
+        if (ceil(rate) > maximum)
+            maximum = ceil(rate);
+        if (ceil(rate) < minimum)
+            minimum = ceil(rate);
+        written = snprintf(numbers + used, sizeof(numbers) - used, "%s%.9g", i ? " " : "", rate);
+        if (written < 0 || (size_t)written >= sizeof(numbers) - used)
+            return -1;
+        used += written;
+    }
+    if (version == 1) {
+        soap_range_add(encoder, "tt:FrameRateRange", minimum, maximum);
+        if (range_get(object, "encoding_interval", &minimum, &maximum, 1) || minimum < 1)
+            return -1;
+        soap_range_add(encoder, "tt:EncodingIntervalRange", minimum, maximum);
+    } else {
+        ezxml_set_attr_d(options, "FrameRatesSupported", numbers);
+        if (range_get(object, "bitrate", &minimum, &maximum, 1))
+            return -1;
+        soap_range_add(encoder, "tt:BitrateRange", minimum, maximum);
+    }
+    if (!strcmp(codec, "JPEG"))
+        return 0;
+    if (!json_object_object_get_ex(object, "encoding_profiles", &entries) ||
+        !json_object_is_type(entries, json_type_array) || !json_object_array_length(entries))
+        return -1;
+    used = 0;
+    for (i = 0; i < json_object_array_length(entries); i++) {
+        entry = json_object_array_get_idx(entries, i);
+        if (!json_object_is_type(entry, json_type_string))
+            return -1;
+        profile = json_object_get_string(entry);
+        if (!strcmp(codec, "H264") && strcmp(profile, "Baseline") &&
+            strcmp(profile, "Main") && strcmp(profile, "High") && strcmp(profile, "Extended"))
+            return -1;
+        if (!strcmp(codec, "H265") && strcmp(profile, "Main") && strcmp(profile, "Main10"))
+            return -1;
+        if (version == 1)
+            soap_child_add(encoder, "tt:H264ProfilesSupported", profile);
+        written = snprintf(profiles + used, sizeof(profiles) - used, "%s%s", i ? " " : "", profile);
+        if (written < 0 || (size_t)written >= sizeof(profiles) - used)
+            return -1;
+        used += written;
+    }
+    if (version == 2)
+        ezxml_set_attr_d(options, "ProfilesSupported", profiles);
+    return 0;
+}
+
+static enum helper_status encoder_options(int version)
+{
+    json_object *request, *reply, *entries;
+    const char *configuration_token;
+    const char *profile_token;
+    enum helper_status status;
+    ezxml_t response;
+    ezxml_t common;
+    size_t i;
+
+    configuration_token = get_element("ConfigurationToken", "Body");
+    profile_token = get_element("ProfileToken", "Body");
+    if ((configuration_token && media_profile_find(configuration_token, "_VideoEncoderToken") < 0) ||
+        (profile_token && media_profile_find(profile_token, "") < 0))
+        return HELPER_NOT_FOUND;
+    request = json_object_new_object();
+    if (configuration_token)
+        json_object_object_add(request, "token", json_object_new_string(configuration_token));
+    if (profile_token)
+        json_object_object_add(request, "profile_token", json_object_new_string(profile_token));
+    status = helper_call(service_ctx.encoder_helper, "options", request, &reply);
+    json_object_put(request);
+    if (status != HELPER_OK)
+        return status;
+    response = soap_response_create(version, "GetVideoEncoderConfigurationOptions");
+    common = version == 1 ? soap_member_add(response, version, "Options") : NULL;
+    status = HELPER_FAILED;
+    if (!revision_valid(reply) || !json_object_object_get_ex(reply, "options", &entries) ||
+        !json_object_is_type(entries, json_type_array) || !json_object_array_length(entries))
+        goto out;
+    for (i = 0; i < json_object_array_length(entries); i++)
+        if (option_add(response, common, json_object_array_get_idx(entries, i), version))
+            goto out;
+    if (common && !common->child) {
+        status = HELPER_UNSUPPORTED;
+        goto out;
+    }
+    soap_response_send(response);
+    response = NULL;
+    status = HELPER_OK;
+out:
+    if (response)
+        ezxml_free(response->parent->parent);
+    json_object_put(reply);
+    return status;
+}
+
+static enum helper_status encoder_refresh(void)
+{
+    stream_profile_t *profiles;
+    json_object *request, *tokens, *reply, *entries, *entry, *token;
+    enum helper_status status;
+    char name[MAX_LEN];
+    unsigned char *seen;
+    size_t i;
+    int index;
+
+    request = json_object_new_object();
+    tokens = json_object_new_array();
+    for (i = 0; i < (size_t)service_ctx.profiles_num; i++) {
+        snprintf(name, sizeof(name), "%s_VideoEncoderToken", service_ctx.profiles[i].name);
+        json_object_array_add(tokens, json_object_new_string(name));
+    }
+    json_object_object_add(request, "tokens", tokens);
+    status = helper_call(service_ctx.encoder_helper, "get", request, &reply);
+    json_object_put(request);
+    if (status != HELPER_OK)
+        return status;
+    profiles = NULL;
+    seen = NULL;
+    status = HELPER_FAILED;
+    if (!revision_valid(reply) || !json_object_object_get_ex(reply, "profiles", &entries) ||
+        !json_object_is_type(entries, json_type_array) ||
+        json_object_array_length(entries) != (size_t)service_ctx.profiles_num)
+        goto out;
+    profiles = calloc(service_ctx.profiles_num, sizeof(*profiles));
+    seen = calloc(service_ctx.profiles_num, sizeof(*seen));
+    if (service_ctx.profiles_num && (!profiles || !seen))
+        goto out;
+    for (i = 0; i < (size_t)service_ctx.profiles_num; i++) {
+        profiles[i] = service_ctx.profiles[i];
+        profiles[i].encoding_profile = strdup(service_ctx.profiles[i].encoding_profile);
+        if (!profiles[i].encoding_profile)
+            goto out;
+    }
+    for (i = 0; i < json_object_array_length(entries); i++) {
+        entry = json_object_array_get_idx(entries, i);
+        if (!json_object_object_get_ex(entry, "token", &token) ||
+            !json_object_is_type(token, json_type_string))
+            goto out;
+        index = media_profile_find(json_object_get_string(token), "_VideoEncoderToken");
+        if (index < 0 || seen[index] || profile_update(&profiles[index], entry))
+            goto out;
+        seen[index] = 1;
+    }
+    for (i = 0; i < (size_t)service_ctx.profiles_num; i++)
+        free(service_ctx.profiles[i].encoding_profile);
+    free(service_ctx.profiles);
+    service_ctx.profiles = profiles;
+    profiles = NULL;
+    status = HELPER_OK;
+out:
+    if (profiles)
+        for (i = 0; i < (size_t)service_ctx.profiles_num; i++)
+            free(profiles[i].encoding_profile);
+    free(profiles);
+    free(seen);
+    json_object_put(reply);
+    return status;
+}
+
+static int xml_number_add(json_object *object, const char *key,
+                          ezxml_t node, const char *name, int integer)
+{
+    const char *text;
+    char *end;
+    double value;
+
+    text = get_element_in_element(name, node);
+    if (!text || !*text)
+        return -1;
+    value = strtod(text, &end);
+    if (*end || !isfinite(value) || value < 0 || value > INT_MAX ||
+        (integer && value != (int)value))
+        return -1;
+    json_object_object_add(object, key, integer ? json_object_new_int(value) :
+                           json_object_new_double(value));
+    return 0;
+}
+
+static json_object *configuration_parse(ezxml_t node, int version)
+{
+    const char *encoding_profile;
+    const char *codec;
+    const char *gov;
+    json_object *object;
+    ezxml_t resolution;
+    ezxml_t rate;
+    ezxml_t h264;
+    char *end;
+    long length;
+
+    codec = get_element_in_element("Encoding", node);
+    resolution = get_element_in_element_ptr("Resolution", node);
+    rate = get_element_in_element_ptr("RateControl", node);
+    if (!codec || !resolution || !rate)
+        return NULL;
+    object = json_object_new_object();
+    json_object_object_add(object, "type", json_object_new_string(codec));
+    if (xml_number_add(object, "width", resolution, "Width", 1) ||
+        xml_number_add(object, "height", resolution, "Height", 1) ||
+        xml_number_add(object, "bitrate", rate, "BitrateLimit", 1) ||
+        xml_number_add(object, "frame_rate", rate, "FrameRateLimit", version == 1) ||
+        xml_number_add(object, "quality", node, "Quality", 0))
+        goto invalid;
+    if (version == 1 && xml_number_add(object, "encoding_interval", rate,
+                                      "EncodingInterval", 1))
+        goto invalid;
+    if (!strcmp(codec, "JPEG"))
+        return object;
+    h264 = get_element_in_element_ptr("H264", node);
+    if (version == 1) {
+        encoding_profile = get_element_in_element("H264Profile", h264);
+        if (strcmp(codec, "H264") || !encoding_profile ||
+            xml_number_add(object, "gov_length", h264, "GovLength", 1))
+            goto invalid;
+    } else {
+        encoding_profile = get_attribute(node, "Profile");
+        gov = get_attribute(node, "GovLength");
+        if (!gov || !*gov)
+            goto invalid;
+        length = strtol(gov, &end, 10);
+        if (*end || length < 1 || length > INT_MAX)
+            goto invalid;
+        json_object_object_add(object, "gov_length", json_object_new_int(length));
+    }
+    if (!encoding_profile)
+        goto invalid;
+    json_object_object_add(object, "encoding_profile", json_object_new_string(encoding_profile));
+    return object;
+invalid:
+    json_object_put(object);
+    return NULL;
+}
+
+static enum helper_status encoder_set(int version)
+{
+    stream_profile_t candidate;
+    json_object *request, *configuration, *reply, *effective;
+    const char *persistence;
+    const char *token;
+    enum helper_status status;
+    ezxml_t node;
+    int index;
+
+    node = get_element_ptr(NULL, "Configuration", "Body");
+    token = get_attribute(node, "token");
+    index = media_profile_find(token, "_VideoEncoderToken");
+    if (index < 0)
+        return HELPER_NOT_FOUND;
+    configuration = configuration_parse(node, version);
+    if (!configuration)
+        return HELPER_INVALID;
+    candidate = service_ctx.profiles[index];
+    candidate.encoding_profile = strdup(candidate.encoding_profile);
+    if (!candidate.encoding_profile) {
+        json_object_put(configuration);
+        return HELPER_FAILED;
+    }
+    if (profile_update(&candidate, configuration)) {
+        free(candidate.encoding_profile);
+        json_object_put(configuration);
+        return HELPER_INVALID;
+    }
+    free(candidate.encoding_profile);
+    request = json_object_new_object();
+    json_object_object_add(request, "token", json_object_new_string(token));
+    json_object_object_add(request, "configuration", configuration);
+    persistence = get_element("ForcePersistence", "Body");
+    if (persistence && strcmp(persistence, "true") && strcmp(persistence, "1") &&
+        strcmp(persistence, "false") && strcmp(persistence, "0")) {
+        json_object_put(request);
+        return HELPER_INVALID;
+    }
+    json_object_object_add(request, "force_persistence", json_object_new_boolean(1));
+    status = helper_call(service_ctx.encoder_helper, "set", request, &reply);
+    json_object_put(request);
+    if (status != HELPER_OK)
+        return status;
+    if (!revision_valid(reply) || !json_object_object_get_ex(reply, "configuration", &effective) ||
+        profile_update(&service_ctx.profiles[index], effective))
+        status = HELPER_FAILED;
+    json_object_put(reply);
+    return status;
+}
+
+int encoder_control_dispatch(const char *operation, int version)
+{
+    enum helper_status status;
+    const char *service;
+    int setter;
+
+    if (!service_ctx.encoder_helper)
+        return 0;
+    setter = !strcmp(operation, "SetVideoEncoderConfiguration");
+    if (!setter && strncmp(operation, "Get", strlen("Get")))
+        return 0;
+    service = version == 1 ? "media_service" : "media2_service";
+    if (!strcmp(operation, "GetVideoEncoderConfigurationOptions")) {
+        status = encoder_options(version);
+        if (status == HELPER_UNSUPPORTED)
+            return 0;
+        if (status != HELPER_OK)
+            helper_fault(service, status);
+        return 1;
+    }
+    if (setter) {
+        status = encoder_set(version);
+        if (status == HELPER_OK)
+            soap_response_send(soap_response_create(version, operation));
+        else
+            helper_fault(service, status);
+        return 1;
+    }
+    status = encoder_refresh();
+    if (status == HELPER_OK || status == HELPER_UNSUPPORTED)
+        return 0;
+    helper_fault(service, status);
+    return 1;
+}
