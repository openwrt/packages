+#!/usr/bin/env python3
+import json
+from pathlib import Path
+import sys
+
+path = Path(__file__).with_suffix('.json')
+state = json.loads(path.read_text())
+request = json.load(sys.stdin)
+assert request['version'] == 1
+assert request['operation'] == sys.argv[1]
+data = request['data']
+operation = request['operation']
+status = state.get('status', 'ok')
+result = {'revision': state.get('revision', 'test-revision')}
+if operation == 'get':
+    result['profiles'] = state.get('profiles', [])
+elif operation == 'options':
+    result['options'] = state.get('options', [])
+elif operation == 'set':
+    state['last_set'] = data
+    configuration = data['configuration']
+    for profile in state.get('profiles', []):
+        if profile['token'] == data['token']:
+            profile.update(configuration)
+    path.write_text(json.dumps(state))
+    result['configuration'] = configuration
+if state.get('bad_reply'):
+    result = {}
+print(json.dumps({'version': 1, 'status': status, 'data': result}))
