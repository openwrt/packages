+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <stdio.h>
+#include <string.h>
+
+#include "ezxml_wrapper.h"
+#include "media_profiles.h"
+#include "onvif_simple_server.h"
+#include "fault.h"
+#include "soap.h"
+#include "utils.h"
+
+extern service_context_t service_ctx;
+
+static int profile_find(const char *token, const char *suffix)
+{
+    char name[MAX_LEN];
+    int i;
+
+    if (!token)
+        return -1;
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        snprintf(name, sizeof(name), "%s%s", service_ctx.profiles[i].name, suffix);
+        if (!strcmp(name, token))
+            return i;
+    }
+    return -1;
+}
+
+static void multicast_add(ezxml_t parent)
+{
+    ezxml_t multicast;
+    ezxml_t address;
+
+    multicast = soap_child_add(parent, "tt:Multicast", NULL);
+    address = soap_child_add(multicast, "tt:Address", NULL);
+    soap_child_add(address, "tt:Type", "IPv4");
+    soap_child_add(address, "tt:IPv4Address", "0.0.0.0");
+    soap_number_add(multicast, "tt:Port", 0);
+    soap_number_add(multicast, "tt:TTL", 0);
+    soap_child_add(multicast, "tt:AutoStart", "false");
+}
+
+static void source_configuration_add(ezxml_t node)
+{
+    stream_profile_t *source;
+    char number[MAX_LEN];
+    ezxml_t bounds;
+    int i;
+
+    source = NULL;
+    for (i = 0; i < service_ctx.profiles_num; i++)
+        if (!source || (long long)service_ctx.profiles[i].width * service_ctx.profiles[i].height >
+            (long long)source->width * source->height)
+            source = &service_ctx.profiles[i];
+    ezxml_set_attr(node, "token", "VideoSourceConfigToken");
+    soap_child_add(node, "tt:Name", "VideoSourceConfig");
+    soap_number_add(node, "tt:UseCount", service_ctx.profiles_num);
+    soap_child_add(node, "tt:SourceToken", "VideoSourceToken");
+    bounds = soap_child_add(node, "tt:Bounds", NULL);
+    ezxml_set_attr(bounds, "x", "0");
+    ezxml_set_attr(bounds, "y", "0");
+    snprintf(number, sizeof(number), "%d", source ? source->width : 0);
+    ezxml_set_attr_d(bounds, "width", number);
+    snprintf(number, sizeof(number), "%d", source ? source->height : 0);
+    ezxml_set_attr_d(bounds, "height", number);
+}
+
+static void encoder_configuration_add(ezxml_t node, int index, int version)
+{
+    stream_profile_t *profile;
+    char name[MAX_LEN];
+    char codec[MAX_LEN];
+    ezxml_t resolution;
+    ezxml_t rate;
+    ezxml_t h264;
+
+    profile = &service_ctx.profiles[index];
+    snprintf(name, sizeof(name), "%s_VideoEncoderToken", profile->name);
+    ezxml_set_attr_d(node, "token", name);
+    soap_child_add(node, "tt:Name", profile->name);
+    soap_number_add(node, "tt:UseCount", 1);
+    set_video_codec(codec, sizeof(codec), profile->type, version);
+    soap_child_add(node, "tt:Encoding", codec);
+    resolution = soap_child_add(node, "tt:Resolution", NULL);
+    soap_number_add(resolution, "tt:Width", profile->width);
+    soap_number_add(resolution, "tt:Height", profile->height);
+    soap_number_add(node, "tt:Quality", 100);
+    rate = soap_child_add(node, "tt:RateControl", NULL);
+    soap_number_add(rate, "tt:FrameRateLimit", profile->framerate);
+    if (version == 1)
+        soap_number_add(rate, "tt:EncodingInterval", 1);
+    soap_number_add(rate, "tt:BitrateLimit", profile->bitrate);
+    if (version == 1) {
+        h264 = soap_child_add(node, "tt:H264", NULL);
+        soap_number_add(h264, "tt:GovLength", 40);
+        soap_child_add(h264, "tt:H264Profile", index ? "Main" : "High");
+    } else {
+        ezxml_set_attr(node, "GovLength", "40");
+        ezxml_set_attr(node, "Profile", index ? "Main" : "High");
+    }
+    multicast_add(node);
+    if (version == 1)
+        soap_child_add(node, "tt:SessionTimeout", "PT0S");
+}
+
+static int type_requested(const char *name)
+{
+    ezxml_t type;
+
+    type = get_element_ptr(NULL, "Type", "Body");
+    for (; type; type = type->next)
+        if (!strcmp(type->txt, "All") || !strcmp(type->txt, name))
+            return 1;
+    return 0;
+}
+
+static void profile_add(ezxml_t node, int index, int version)
+{
+    stream_profile_t *profile;
+    ezxml_t configurations;
+    ezxml_t child;
+    char codec[MAX_LEN];
+    char name[MAX_LEN];
+
+    profile = &service_ctx.profiles[index];
+    ezxml_set_attr_d(node, "token", profile->name);
+    ezxml_set_attr(node, "fixed", "true");
+    child = soap_member_add(node, version, "Name");
+    ezxml_set_txt_d(child, profile->name);
+    configurations = version == 1 ? node : soap_member_add(node, version, "Configurations");
+    if (version == 1 || type_requested("VideoSource")) {
+        child = soap_child_add(configurations, version == 1 ?
+                               "tt:VideoSourceConfiguration" : "tr2:VideoSource", NULL);
+        source_configuration_add(child);
+    }
+    if (version == 1 || type_requested("VideoEncoder")) {
+        child = soap_child_add(configurations, version == 1 ?
+                               "tt:VideoEncoderConfiguration" : "tr2:VideoEncoder", NULL);
+        encoder_configuration_add(child, index, version);
+    }
+    if (profile->audio_encoder != AUDIO_NONE &&
+        (version == 1 || type_requested("AudioSource"))) {
+        child = soap_child_add(configurations, version == 1 ?
+                               "tt:AudioSourceConfiguration" : "tr2:AudioSource", NULL);
+        ezxml_set_attr(child, "token", "AudioSourceConfigToken");
+        soap_child_add(child, "tt:Name", "AudioSourceConfig");
+        soap_number_add(child, "tt:UseCount", service_ctx.profiles_num);
+        soap_child_add(child, "tt:SourceToken", "AudioSourceToken");
+    }
+    if (profile->audio_encoder != AUDIO_NONE &&
+        (version == 1 || type_requested("AudioEncoder"))) {
+        child = soap_child_add(configurations, version == 1 ?
+                               "tt:AudioEncoderConfiguration" : "tr2:AudioEncoder", NULL);
+        snprintf(name, sizeof(name), "%s_AudioEncoderToken", profile->name);
+        ezxml_set_attr_d(child, "token", name);
+        soap_child_add(child, "tt:Name", profile->name);
+        soap_number_add(child, "tt:UseCount", 1);
+        set_audio_codec(codec, sizeof(codec), profile->audio_encoder, version);
+        soap_child_add(child, "tt:Encoding", codec);
+        soap_number_add(child, "tt:Bitrate", 50);
+        soap_number_add(child, "tt:SampleRate", 16);
+        multicast_add(child);
+        soap_child_add(child, "tt:SessionTimeout", "PT0S");
+    }
+    if (service_ctx.ptz_node.enable && (version == 1 || type_requested("PTZ"))) {
+        child = soap_child_add(configurations, version == 1 ?
+                               "tt:PTZConfiguration" : "tr2:PTZ", NULL);
+        ezxml_set_attr(child, "token", "PTZCfgToken");
+        soap_child_add(child, "tt:Name", "PTZCfg");
+        soap_number_add(child, "tt:UseCount", service_ctx.profiles_num);
+        soap_child_add(child, "tt:NodeToken", "PTZNodeToken");
+    }
+}
+
+static void uri_add(ezxml_t response, int index, int version, int snapshot)
+{
+    stream_profile_t *profile;
+    char uri[MAX_LEN];
+    const char *format;
+    ezxml_t member;
+
+    profile = &service_ctx.profiles[index];
+    format = snapshot ? profile->snapurl : profile->url;
+    if (!format)
+        return;
+    snprintf(uri, sizeof(uri), format, service_ctx.address_url);
+    if (version == 2 || snapshot) {
+        member = soap_member_add(response, version, snapshot ? "MediaUri" : "Uri");
+        if (version == 2) {
+            ezxml_set_txt_d(member, uri);
+            return;
+        }
+    } else {
+        member = soap_member_add(response, version, "MediaUri");
+    }
+    soap_child_add(member, "tt:Uri", uri);
+    soap_child_add(member, "tt:InvalidAfterConnect", "false");
+    soap_child_add(member, "tt:InvalidAfterReboot", "false");
+    soap_child_add(member, "tt:Timeout", "PT0S");
+}
+
+int media_profiles_dispatch(const char *operation, int version)
+{
+    const char *profile_token;
+    const char *configuration_token;
+    const char *service;
+    ezxml_t response;
+    ezxml_t member;
+    int index;
+    int i;
+    int profiles;
+    int uri;
+
+    profiles = !strcmp(operation, "GetProfiles") || !strcmp(operation, "GetProfile");
+    uri = !strcmp(operation, "GetStreamUri") || !strcmp(operation, "GetSnapshotUri");
+    if (!profiles && !uri && strcmp(operation, "GetVideoEncoderConfigurations") &&
+        strcmp(operation, "GetVideoEncoderConfiguration") &&
+        strcmp(operation, "GetCompatibleVideoEncoderConfigurations"))
+        return 0;
+    service = version == 1 ? "media_service" : "media2_service";
+    profile_token = get_element("ProfileToken", "Body");
+    if (version == 2 && profiles)
+        profile_token = get_element("Token", "Body");
+    configuration_token = get_element("ConfigurationToken", "Body");
+    index = profile_token ? profile_find(profile_token, "") : -1;
+    if (profile_token && index < 0) {
+        send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:NoProfile",
+                   "No profile", "The requested profile does not exist");
+        return 1;
+    }
+    if (configuration_token)
+        index = profile_find(configuration_token, "_VideoEncoderToken");
+    if (configuration_token && index < 0) {
+        send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:NoConfig",
+                   "No configuration", "The requested configuration does not exist");
+        return 1;
+    }
+    if ((uri || !strcmp(operation, "GetProfile") ||
+         !strcmp(operation, "GetVideoEncoderConfiguration")) && index < 0) {
+        send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:NoProfile",
+                   "Missing token", "A valid token is required");
+        return 1;
+    }
+    response = soap_response_create(version, operation);
+    if (uri) {
+        uri_add(response, index, version, !strcmp(operation, "GetSnapshotUri"));
+        soap_response_send(response);
+        return 1;
+    }
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        if (index >= 0 && index != i)
+            continue;
+        member = soap_member_add(response, version, profiles ?
+                                 (!strcmp(operation, "GetProfile") ? "Profile" : "Profiles") :
+                                 (!strcmp(operation, "GetVideoEncoderConfiguration") ?
+                                  "Configuration" : "Configurations"));
+        if (profiles)
+            profile_add(member, i, version);
+        else
+            encoder_configuration_add(member, i, version);
+    }
+    soap_response_send(response);
+    return 1;
+}
