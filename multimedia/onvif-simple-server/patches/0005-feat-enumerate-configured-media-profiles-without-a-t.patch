+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <stdio.h>
+#include <string.h>
+
+#include "soap.h"
+#include "utils.h"
+
+ezxml_t soap_child_add(ezxml_t parent, const char *name, const char *text)
+{
+    ezxml_t child;
+
+    child = ezxml_add_child_d(parent, name, 0);
+    if (text)
+        ezxml_set_txt_d(child, text);
+    return child;
+}
+
+ezxml_t soap_number_add(ezxml_t parent, const char *name, double value)
+{
+    char number[MAX_LEN];
+
+    snprintf(number, sizeof(number), "%.9g", value);
+    return soap_child_add(parent, name, number);
+}
+
+ezxml_t soap_member_add(ezxml_t parent, int version, const char *name)
+{
+    char qualified[MAX_LEN];
+
+    snprintf(qualified, sizeof(qualified), "%s:%s",
+             version == 1 ? "trt" : "tr2", name);
+    return soap_child_add(parent, qualified, NULL);
+}
+
+ezxml_t soap_response_create(int version, const char *operation)
+{
+    char name[MAX_LEN];
+    ezxml_t envelope;
+    ezxml_t body;
+
+    envelope = ezxml_new("s:Envelope");
+    ezxml_set_attr(envelope, "xmlns:s", "http://www.w3.org/2003/05/soap-envelope");
+    ezxml_set_attr(envelope, "xmlns:tt", "http://www.onvif.org/ver10/schema");
+    ezxml_set_attr(envelope, "xmlns:trt", "http://www.onvif.org/ver10/media/wsdl");
+    ezxml_set_attr(envelope, "xmlns:tr2", "http://www.onvif.org/ver20/media/wsdl");
+    ezxml_set_attr(envelope, "xmlns:timg", "http://www.onvif.org/ver20/imaging/wsdl");
+    body = soap_child_add(envelope, "s:Body", NULL);
+    snprintf(name, sizeof(name), "%sResponse", operation);
+    return soap_member_add(body, version, name);
+}
+
+int soap_response_send(ezxml_t response)
+{
+    ezxml_t envelope;
+    char *xml;
+    int result;
+
+    envelope = response;
+    while (envelope->parent)
+        envelope = envelope->parent;
+    xml = ezxml_toxml(envelope);
+    output_http_headers(strlen(xml));
+    result = fputs(xml, stdout);
+    free(xml);
+    ezxml_free(envelope);
+    return result;
+}
