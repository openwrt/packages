+++ b/control_helper.c
@@ -0,0 +1,249 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <sys/wait.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <signal.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "control_helper.h"
+#include "onvif_simple_server.h"
+#include "fault.h"
+
+#define HELPER_MESSAGE_SIZE (16 * 1024)
+#define MSEC_PER_SEC 1000
+#define NSEC_PER_MSEC 1000000
+
+extern service_context_t service_ctx;
+
+static volatile sig_atomic_t notify_fd = -1;
+static volatile sig_atomic_t cancelled;
+
+static void child_notify(int signo)
+{
+    int saved_errno;
+    char event;
+
+    saved_errno = errno;
+    event = 0;
+    if (signo == SIGTERM)
+        cancelled = 1;
+    if (notify_fd >= 0)
+        (void)write(notify_fd, &event, sizeof(event));
+    errno = saved_errno;
+}
+
+static long long uptime_ms(void)
+{
+    struct timespec now;
+
+#ifdef CLOCK_BOOTTIME
+    clock_gettime(CLOCK_BOOTTIME, &now);
+#else
+    clock_gettime(CLOCK_MONOTONIC, &now);
+#endif
+    return (long long)now.tv_sec * MSEC_PER_SEC + now.tv_nsec / NSEC_PER_MSEC;
+}
+
+static int pipe_create(int descriptors[2])
+{
+    int i;
+
+    if (pipe(descriptors))
+        return -1;
+    for (i = 0; i < 2; i++) {
+        if (fcntl(descriptors[i], F_SETFD, FD_CLOEXEC) < 0 ||
+            fcntl(descriptors[i], F_SETFL, O_NONBLOCK) < 0) {
+            close(descriptors[0]);
+            close(descriptors[1]);
+            return -1;
+        }
+    }
+    return 0;
+}
+
+static int helper_exchange(const char *path, const char *operation,
+                           const char *request, char *response)
+{
+    struct sigaction action, old_child, old_term, old_pipe;
+    struct pollfd descriptors[3];
+    int input[2], output[2], notification[2];
+    size_t written, received, request_length;
+    long long deadline, remaining;
+    int finished, status, timeout, ok;
+    char events[HELPER_MESSAGE_SIZE];
+    ssize_t count;
+    pid_t child;
+
+    if (pipe_create(input))
+        return -1;
+    if (pipe_create(output)) {
+        close(input[0]);
+        close(input[1]);
+        return -1;
+    }
+    if (pipe_create(notification)) {
+        close(input[0]);
+        close(input[1]);
+        close(output[0]);
+        close(output[1]);
+        return -1;
+    }
+    memset(&action, 0, sizeof(action));
+    sigemptyset(&action.sa_mask);
+    action.sa_handler = child_notify;
+    notify_fd = notification[1];
+    cancelled = 0;
+    sigaction(SIGCHLD, &action, &old_child);
+    sigaction(SIGTERM, &action, &old_term);
+    action.sa_handler = SIG_IGN;
+    sigaction(SIGPIPE, &action, &old_pipe);
+    child = fork();
+    if (child == 0) {
+        dup2(input[0], STDIN_FILENO);
+        dup2(output[1], STDOUT_FILENO);
+        fcntl(STDIN_FILENO, F_SETFL, 0);
+        fcntl(STDOUT_FILENO, F_SETFL, 0);
+        execl(path, path, operation, (char *)NULL);
+        _exit(127);
+    }
+    close(input[0]);
+    close(output[1]);
+    descriptors[0].fd = input[1];
+    descriptors[0].events = POLLOUT;
+    descriptors[1].fd = output[0];
+    descriptors[1].events = POLLIN;
+    descriptors[2].fd = notification[0];
+    descriptors[2].events = POLLIN;
+    request_length = strlen(request);
+    deadline = service_ctx.helper_timeout_ms ? uptime_ms() + service_ctx.helper_timeout_ms : 0;
+    written = received = 0;
+    finished = status = ok = 0;
+    while (child > 0 && !cancelled) {
+        if (!finished && waitpid(child, &status, WNOHANG) == child)
+            finished = 1;
+        if (finished && descriptors[1].fd < 0) {
+            ok = WIFEXITED(status) && WEXITSTATUS(status) == 0;
+            break;
+        }
+        remaining = deadline ? deadline - uptime_ms() : -1;
+        if (deadline && remaining <= 0)
+            break;
+        timeout = remaining;
+        if (poll(descriptors, sizeof(descriptors) / sizeof(descriptors[0]), timeout) < 0) {
+            if (errno == EINTR)
+                continue;
+            break;
+        }
+        if (descriptors[2].revents)
+            (void)read(notification[0], events, sizeof(events));
+        if (descriptors[0].fd >= 0 && descriptors[0].revents) {
+            count = write(descriptors[0].fd, request + written, request_length - written);
+            if (count > 0)
+                written += count;
+            if (written == request_length || (count < 0 && errno != EAGAIN && errno != EINTR)) {
+                close(descriptors[0].fd);
+                descriptors[0].fd = -1;
+            }
+        }
+        if (descriptors[1].fd < 0 || !descriptors[1].revents)
+            continue;
+        count = read(descriptors[1].fd, response + received, HELPER_MESSAGE_SIZE - received);
+        if (count > 0) {
+            received += count;
+            if (received == HELPER_MESSAGE_SIZE)
+                break;
+        } else if (count == 0) {
+            close(descriptors[1].fd);
+            descriptors[1].fd = -1;
+        } else if (errno != EAGAIN && errno != EINTR) {
+            break;
+        }
+    }
+    if (child > 0 && !finished) {
+        kill(child, SIGKILL);
+        while (waitpid(child, &status, 0) < 0 && errno == EINTR)
+            ;
+    }
+    if (descriptors[0].fd >= 0)
+        close(descriptors[0].fd);
+    if (descriptors[1].fd >= 0)
+        close(descriptors[1].fd);
+    notify_fd = -1;
+    close(notification[0]);
+    close(notification[1]);
+    sigaction(SIGCHLD, &old_child, NULL);
+    sigaction(SIGTERM, &old_term, NULL);
+    sigaction(SIGPIPE, &old_pipe, NULL);
+    response[received] = '\0';
+    return ok ? 0 : -1;
+}
+
+enum helper_status helper_call(const char *path, const char *operation,
+                               json_object *data, json_object **result)
+{
+    static const char *statuses[] = { "ok", "unsupported", "not_found", "invalid", "busy", "failed" };
+    char response[HELPER_MESSAGE_SIZE + 1];
+    struct json_tokener *tokener;
+    json_object *request, *reply, *value;
+    const char *request_text;
+    enum helper_status status;
+    size_t i;
+
+    *result = NULL;
+    if (!path || !*path)
+        return HELPER_UNSUPPORTED;
+    request = json_object_new_object();
+    json_object_object_add(request, "version", json_object_new_int(1));
+    json_object_object_add(request, "operation", json_object_new_string(operation));
+    json_object_object_add(request, "data", json_object_get(data));
+    request_text = json_object_to_json_string_ext(request, JSON_C_TO_STRING_PLAIN);
+    status = HELPER_FAILED;
+    if (strlen(request_text) >= HELPER_MESSAGE_SIZE ||
+        helper_exchange(path, operation, request_text, response)) {
+        json_object_put(request);
+        return status;
+    }
+    json_object_put(request);
+    tokener = json_tokener_new();
+    json_tokener_set_flags(tokener, JSON_TOKENER_STRICT);
+    reply = json_tokener_parse_ex(tokener, response, strlen(response) + 1);
+    if (json_tokener_get_error(tokener) != json_tokener_success ||
+        !json_object_is_type(reply, json_type_object))
+        goto out;
+    if (!json_object_object_get_ex(reply, "version", &value) ||
+        !json_object_is_type(value, json_type_int) || json_object_get_int(value) != 1)
+        goto out;
+    if (!json_object_object_get_ex(reply, "status", &value) ||
+        !json_object_is_type(value, json_type_string))
+        goto out;
+    for (i = 0; i < sizeof(statuses) / sizeof(statuses[0]); i++)
+        if (!strcmp(json_object_get_string(value), statuses[i]))
+            status = i;
+    if (status == HELPER_OK) {
+        if (!json_object_object_get_ex(reply, "data", &value) ||
+            !json_object_is_type(value, json_type_object))
+            status = HELPER_FAILED;
+        else
+            *result = json_object_get(value);
+    }
+out:
+    json_object_put(reply);
+    json_tokener_free(tokener);
+    return status;
+}
+
+int helper_fault(const char *service, enum helper_status status)
+{
+    if (status == HELPER_UNSUPPORTED)
+        return send_action_not_supported_fault((char *)service);
+    if (status == HELPER_NOT_FOUND)
+        return send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:NoConfig",
+                          "Unknown token", "The requested configuration does not exist");
+    if (status == HELPER_INVALID)
+        return send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:ConfigModify",
+                          "Invalid settings", "The requested settings are not supported");
+    return send_action_failed_fault((char *)service, status);
+}
