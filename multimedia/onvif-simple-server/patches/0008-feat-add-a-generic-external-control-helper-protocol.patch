@@ -0,0 +1,40 @@
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+
+with tempfile.TemporaryDirectory() as directory:
+    helper = Path(directory) / 'control helper; literal'
+    helper.write_text('''#!/usr/bin/env python3
+import json, os, sys, time
+request = json.load(sys.stdin)
+assert request['version'] == 1
+assert request['operation'] == sys.argv[1]
+operation = sys.argv[1]
+if operation == 'oversized':
+    print('x' * 20000)
+elif operation == 'malformed':
+    print('{} trailing')
+elif operation == 'timeout':
+    time.sleep(60)
+elif operation == 'exit':
+    sys.exit(1)
+else:
+    status = 'invalid' if operation == 'invalid' else 'ok'
+    print(json.dumps({'version': 1, 'status': status, 'data': request['data']}))
+    if operation == 'close':
+        sys.stdout.flush()
+        os.close(1)
+        time.sleep(0.01)
+''')
+    helper.chmod(0o700)
+    for operation, expected in [('echo', 0), ('invalid', 3), ('malformed', 5),
+                                ('oversized', 5), ('timeout', 5), ('exit', 5),
+                                ('close', 0)]:
+        timeout = '50' if operation == 'timeout' else '1000'
+        result = subprocess.check_output(['./test/test_helper', str(helper), operation,
+                                          timeout], timeout=3).decode().splitlines()
+        assert int(result[0]) == expected, (operation, result)
+        if expected == 0:
+            assert json.loads(result[1])['value'] == ";$(false) & quoted ' data"
+print('External helper transport: 7 passed')
