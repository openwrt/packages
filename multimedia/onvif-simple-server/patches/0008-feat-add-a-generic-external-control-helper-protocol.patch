+
+int main(int argc, char **argv)
+{
+    json_object *data;
+    json_object *result;
+    enum helper_status status;
+
+    if (argc != 4)
+        return 1;
+    service_ctx.helper_timeout_ms = atoi(argv[3]);
+    data = json_object_new_object();
+    json_object_object_add(data, "value", json_object_new_string(";$(false) & quoted ' data"));
+    status = helper_call(argv[1], argv[2], data, &result);
+    printf("%d\n", status);
+    if (result)
+        puts(json_object_to_json_string_ext(result, JSON_C_TO_STRING_PLAIN));
+    json_object_put(data);
+    json_object_put(result);
+    return 0;
+}
