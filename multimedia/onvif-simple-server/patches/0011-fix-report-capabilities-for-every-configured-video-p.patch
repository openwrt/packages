+static void media1_options_add(ezxml_t response, int index)
+{
+    stream_profile_t *profile;
+    ezxml_t options;
+    ezxml_t encoder;
+    ezxml_t resolution;
+    char codec[16];
+    char name[32];
+    double quality_min;
+    double quality_max;
+    double rate_min;
+    double rate_max;
+    int interval_min;
+    int interval_max;
+    int gov_min;
+    int gov_max;
+    int type;
+    int i;
+    int j;
+
+    quality_min = 0;
+    quality_max = 0;
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        profile = &service_ctx.profiles[i];
+        if ((index >= 0 && index != i) || profile->type == H265)
+            continue;
+        if (quality_max == 0 || floor(profile->quality) < quality_min)
+            quality_min = floor(profile->quality);
+        if (ceil(profile->quality) > quality_max)
+            quality_max = ceil(profile->quality);
+    }
+    options = soap_member_add(response, 1, "Options");
+    soap_range_add(options, "tt:QualityRange", quality_min, quality_max);
+    for (type = JPEG; type <= H264; type++) {
+        encoder = NULL;
+        rate_min = 0;
+        rate_max = 0;
+        interval_min = 0;
+        interval_max = 0;
+        gov_min = 0;
+        gov_max = 0;
+        for (i = 0; i < service_ctx.profiles_num; i++) {
+            profile = &service_ctx.profiles[i];
+            if ((index >= 0 && index != i) || profile->type != type)
+                continue;
+            if (!encoder) {
+                set_video_codec(codec, sizeof(codec), type, 1);
+                snprintf(name, sizeof(name), "tt:%s", codec);
+                encoder = soap_child_add(options, name, NULL);
+            }
+            resolution = soap_child_add(encoder, "tt:ResolutionsAvailable", NULL);
+            soap_number_add(resolution, "tt:Width", profile->width);
+            soap_number_add(resolution, "tt:Height", profile->height);
+            if (!rate_min || ceil(media_profile_framerate(profile)) < rate_min)
+                rate_min = ceil(media_profile_framerate(profile));
+            if (ceil(media_profile_framerate(profile)) > rate_max)
+                rate_max = ceil(media_profile_framerate(profile));
+            if (!interval_min || profile->encoding_interval < interval_min)
+                interval_min = profile->encoding_interval;
+            if (profile->encoding_interval > interval_max)
+                interval_max = profile->encoding_interval;
+            if (!gov_min || profile->gov_length < gov_min)
+                gov_min = profile->gov_length;
+            if (profile->gov_length > gov_max)
+                gov_max = profile->gov_length;
+        }
+        if (!encoder)
+            continue;
+        if (type != JPEG)
+            soap_range_add(encoder, "tt:GovLengthRange", gov_min, gov_max);
+        soap_range_add(encoder, "tt:FrameRateRange", rate_min, rate_max);
+        soap_range_add(encoder, "tt:EncodingIntervalRange", interval_min, interval_max);
+        for (i = 0; i < service_ctx.profiles_num && type != JPEG; i++) {
+            profile = &service_ctx.profiles[i];
+            if ((index >= 0 && index != i) || profile->type != type)
+                continue;
+            for (j = 0; j < i; j++)
+                if ((index < 0 || index == j) && service_ctx.profiles[j].type == type &&
+                    !strcmp(service_ctx.profiles[j].encoding_profile, profile->encoding_profile))
+                    break;
+            if (j == i)
+                soap_child_add(encoder, type == H264 ? "tt:H264ProfilesSupported" :
+                               "tt:Mpeg4ProfilesSupported", type == H264 ?
+                               profile->encoding_profile : "SP");
+        }
+    }
+}
