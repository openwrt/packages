@@ -0,0 +1,143 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+#include <stdio.h>
+#include <string.h>
+
+#include "ezxml_wrapper.h"
+#include "fault.h"
+#include "media_capabilities.h"
+#include "media_profiles.h"
+#include "onvif_simple_server.h"
+#include "soap.h"
+#include "utils.h"
+
+extern service_context_t service_ctx;
+
+void media_capabilities_update(ezxml_t node)
+{
+    char configurations[MAX_LEN];
+    char number[32];
+    const char *namespace;
+    ezxml_t child;
+    int snapshot;
+    int input;
+    int output;
+    int count;
+    int i;
+
+    namespace = xml_namespace_get(node);
+    snapshot = 0;
+    input = 0;
+    output = 0;
+    count = 0;
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        snapshot |= service_ctx.profiles[i].snapurl && *service_ctx.profiles[i].snapurl;
+        input |= service_ctx.profiles[i].audio_encoder != AUDIO_NONE;
+        output |= service_ctx.profiles[i].audio_decoder != AUDIO_NONE;
+        count += !namespace || strcmp(namespace, "http://www.onvif.org/ver10/media/wsdl") ||
+                 service_ctx.profiles[i].type != H265;
+    }
+    if (ezxml_attr(node, "MaximumNumberOfProfiles")) {
+        snprintf(number, sizeof(number), "%d", count);
+        ezxml_set_attr_d(node, "MaximumNumberOfProfiles", number);
+    }
+    if (ezxml_attr(node, "ConfigurationsSupported")) {
+        snprintf(configurations, sizeof(configurations), "VideoSource VideoEncoder%s%s%s",
+                 input ? " AudioSource AudioEncoder" : "",
+                 output ? " AudioOutput AudioDecoder" : "",
+                 service_ctx.ptz_node.enable ? " PTZ" : "");
+        ezxml_set_attr_d(node, "ConfigurationsSupported", configurations);
+    }
+    if (ezxml_attr(node, "SnapshotUri"))
+        ezxml_set_attr(node, "SnapshotUri", snapshot ? "true" : "false");
+    if (ezxml_attr(node, "WebRTC"))
+        ezxml_set_attr(node, "WebRTC", "0");
+    for (child = node->child; child; child = child->ordered)
+        media_capabilities_update(child);
+}
+
+int media_capabilities_send(int version)
+{
+    ezxml_t envelope;
+
+    envelope = ezxml_parse_file(version == 1 ? "media_service_files/GetServiceCapabilities.xml" :
+                                "media2_service_files/GetServiceCapabilities.xml");
+    if (!envelope || *ezxml_error(envelope)) {
+        ezxml_free(envelope);
+        return send_action_failed_fault(version == 1 ? "media_service" : "media2_service", -1);
+    }
+    media_capabilities_update(envelope);
+    return soap_response_send(envelope);
+}
+
+int media_guaranteed_instances_send(void)
+{
+    const char *token;
+    ezxml_t response;
+    int jpeg;
+    int h264;
+    int mpeg4;
+    int i;
+
+    token = get_element("ConfigurationToken", "Body");
+    if (!token || strcmp(token, "VideoSourceConfigToken"))
+        return send_fault("media_service", "Sender", "ter:InvalidArgVal", "ter:NoConfig",
+                          "Unknown configuration", "The source configuration does not exist");
+    jpeg = 0;
+    h264 = 0;
+    mpeg4 = 0;
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        jpeg += service_ctx.profiles[i].type == JPEG;
+        h264 += service_ctx.profiles[i].type == H264;
+        mpeg4 += service_ctx.profiles[i].type == MPEG4;
+    }
+    response = soap_response_create(1, "GetGuaranteedNumberOfVideoEncoderInstances");
+    soap_number_add(response, "trt:TotalNumber", jpeg + h264 + mpeg4);
+    soap_number_add(response, "trt:JPEG", jpeg);
+    soap_number_add(response, "trt:H264", h264);
+    soap_number_add(response, "trt:MPEG4", mpeg4);
+    return soap_response_send(response);
+}
+
+int media_source_modes_send(void)
+{
+    const char *token;
+    ezxml_t response;
+    ezxml_t mode;
+    ezxml_t resolution;
+    char encodings[MAX_LEN];
+    char codec[16];
+    double framerate;
+    int height;
+    int width;
+    int type;
+    int found;
+    int i;
+
+    token = get_element("VideoSourceToken", "Body");
+    if (!token || strcmp(token, "VideoSourceToken"))
+        return send_fault("media2_service", "Sender", "ter:InvalidArgVal", "ter:NoVideoSource",
+                          "Unknown source", "The requested video source does not exist");
+    media_source_info(&width, &height, &framerate);
+    response = soap_response_create(2, "GetVideoSourceModes");
+    mode = soap_member_add(response, 2, "VideoSourceModes");
+    ezxml_set_attr(mode, "Enabled", "true");
+    ezxml_set_attr(mode, "token", "VideoSourceModeToken");
+    soap_number_add(mode, "tr2:MaxFramerate", framerate);
+    resolution = soap_child_add(mode, "tr2:MaxResolution", NULL);
+    soap_number_add(resolution, "tt:Width", width);
+    soap_number_add(resolution, "tt:Height", height);
+    encodings[0] = '\0';
+    for (type = JPEG; type <= H265; type++) {
+        found = 0;
+        for (i = 0; i < service_ctx.profiles_num; i++)
+            found |= service_ctx.profiles[i].type == type;
+        if (!found)
+            continue;
+        set_video_codec(codec, sizeof(codec), type, 2);
+        snprintf(encodings + strlen(encodings), sizeof(encodings) - strlen(encodings),
+                 "%s%s", *encodings ? " " : "", codec);
+    }
+    soap_child_add(mode, "tr2:Encodings", encodings);
+    soap_child_add(mode, "tr2:Reboot", "false");
+    return soap_response_send(response);
+}
