+int uuid_string_set(char *destination, const char *value)
+{
+    int i;
+
+    if (!value || strlen(value) != UUID_LEN)
+        return -1;
+    for (i = 0; i < UUID_LEN; i++) {
+        if (i == 8 || i == 13 || i == 18 || i == 23) {
+            if (value[i] != '-')
+                return -1;
+        } else if (!isxdigit((unsigned char)value[i])) {
+            return -1;
+        }
+    }
+    for (i = 0; i < UUID_LEN; i++)
+        destination[i] = tolower((unsigned char)value[i]);
+    destination[UUID_LEN] = '\0';
+    return 0;
+}
+
