+static void test_configured_uuid(void)
+{
+    char uuid[UUID_LEN + 2];
+
+    uuid[UUID_LEN + 1] = 'x';
+    CHECK("configured UUID accepted",
+          uuid_string_set(uuid, "B47BD8EA-7B8B-58C7-8354-88DBADDF57AA") == 0);
+    CHECK("configured UUID canonicalised",
+          !strcmp(uuid, "b47bd8ea-7b8b-58c7-8354-88dbaddf57aa"));
+    CHECK("configured UUID canary preserved", uuid[UUID_LEN + 1] == 'x');
+    CHECK("short UUID rejected", uuid_string_set(uuid, "1234") < 0);
+    CHECK("UUID separators checked",
+          uuid_string_set(uuid, "b47bd8ea_7b8b-58c7-8354-88dbaddf57aa") < 0);
+    CHECK("UUID hexadecimal checked",
+          uuid_string_set(uuid, "z47bd8ea-7b8b-58c7-8354-88dbaddf57aa") < 0);
+}
