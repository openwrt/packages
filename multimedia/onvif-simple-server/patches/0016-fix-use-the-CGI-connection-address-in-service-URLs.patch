+static int service_address_resolve(void)
+{
+    unsigned char binary[sizeof(struct in6_addr)];
+    char netmask[INET_ADDRSTRLEN];
+    char interface[IFNAMSIZ];
+    const char *remote;
+    const char *local;
+
+    local = getenv("SERVER_ADDR");
+    if (local && *local) {
+        if (inet_pton(AF_INET, local, binary) != 1 &&
+            inet_pton(AF_INET6, local, binary) != 1) {
+            log_error("Invalid SERVER_ADDR.");
+            return -2;
+        }
+        snprintf(service_ctx.address, sizeof(service_ctx.address), "%s", local);
+    } else if (service_ctx.ifs) {
+        if (get_ip_address(service_ctx.address, netmask, service_ctx.ifs) < 0) {
+            log_error("Cannot get IP address from interface %s.", service_ctx.ifs);
+            return -2;
+        }
+    } else {
+        remote = getenv("REMOTE_ADDR");
+        if (!remote || detect_local_address(remote, service_ctx.address,
+                                            sizeof(service_ctx.address))) {
+            log_error("Cannot determine local address.");
+            return -2;
+        }
+    }
+    if (!service_ctx.ifs) {
+        if (get_ifname_by_addr(service_ctx.address, interface, sizeof(interface)))
+            snprintf(interface, sizeof(interface), "%s", DEFAULT_IFS);
+        service_ctx.ifs = strdup(interface);
+        if (!service_ctx.ifs)
+            return -2;
+    }
+    if (strchr(service_ctx.address, ':'))
+        snprintf(service_ctx.address_url, sizeof(service_ctx.address_url),
+                 "[%s]", service_ctx.address);
+    else
+        snprintf(service_ctx.address_url, sizeof(service_ctx.address_url),
+                 "%s", service_ctx.address);
+    return 0;
+}
