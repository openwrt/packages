 class CGITests(unittest.TestCase):
+    def test_socket_local_addresses(self):
+        text = ('ifs=lo\nname=Profile_0\nwidth=640\nheight=480\ntype=H264\n'
+                'url=rtsp://%s:8554/test\naudio_encoder=NONE\n')
+        for config in [configuration(1), text]:
+            for address, host in [('192.0.2.10', '192.0.2.10'),
+                                  ('2001:db8::10', '[2001:db8::10]')]:
+                status, root = request('media', 'GetStreamUri',
+                                       '<ProfileToken>Profile_0</ProfileToken>',
+                                       config, server_address=address)
+                self.assertEqual(status, 200)
+                self.assertTrue(root.findtext('.//{*}Uri').startswith(f'rtsp://{host}:8554/'))
+                status, root = request('device', 'GetServices', config=config,
+                                       server_address=address)
+                self.assertEqual(status, 200)
+                self.assertTrue(all(f'://{host}' in node.text
+                                    for node in root.findall('.//{*}XAddr')))
