 class CGITests(unittest.TestCase):
+    def test_text_encoder_parameters(self):
+        config = ('ifs=lo\nname=Profile_0\nwidth=640\nheight=480\n'
+                  'type=H264\nencoding_profile=Baseline\ngov_length=61\n'
+                  'quality=42\nbitrate=1234\nframerate=25\naudio_encoder=NONE\n')
+        status, root = request('media', 'GetProfiles', config=config)
+        self.assertEqual(status, 200)
+        self.assertEqual(root.findtext('.//tt:H264Profile', namespaces=NS), 'Baseline')
+        self.assertEqual(root.findtext('.//tt:GovLength', namespaces=NS), '61')
+        self.assertEqual(root.findtext('.//tt:BitrateLimit', namespaces=NS), '1234')
+
+    def test_encoder_parameters(self):
+        config = configuration(5)
+        encodings = ['H264', 'H264', 'H264', 'H265', 'JPEG']
+        profiles = ['Baseline', 'Main', 'High', 'Main', 'High']
+        for i, profile in enumerate(config['profiles']):
+            profile.update(type=encodings[i], encoding_profile=profiles[i],
+                           gov_length=31 + i, quality=20 + i)
+        config['profiles'][3].update(framerate=30000, framerate_den=1001)
+        for service, count in [('media', 4), ('media2', 5)]:
+            status, root = request(service, 'GetVideoEncoderConfigurations', config=config)
+            self.assertEqual(status, 200)
+            entries = root.findall('.//{*}Configurations')
+            self.assertEqual(len(entries), count)
+            for entry in entries:
+                token = entry.get('token')
+                index = int(token.split('_')[1])
+                self.assertEqual(entry.findtext('tt:Encoding', namespaces=NS), encodings[index])
+                self.assertEqual(float(entry.findtext('tt:Quality', namespaces=NS)), 20 + index)
+                if service == 'media2' and index < 4:
+                    self.assertEqual(entry.get('Profile'), profiles[index])
+                    self.assertEqual(entry.get('GovLength'), str(31 + index))
+                elif index < 3:
+                    self.assertEqual(entry.findtext('tt:H264/tt:H264Profile', namespaces=NS),
+                                     profiles[index])
+                if encodings[index] == 'JPEG':
+                    self.assertIsNone(entry.find('tt:H264', NS))
+            if service == 'media2':
+                self.assertAlmostEqual(float(entries[3].findtext('tt:RateControl/tt:FrameRateLimit',
+                                                                 namespaces=NS)), 30000 / 1001,
+                                       places=6)
+
+    def test_source_and_options(self):
+        config = configuration(12)
+        config.update(source_width=3840, source_height=2160, source_framerate=30)
+        status, root = request('media', 'GetVideoSources', config=config)
+        self.assertEqual(root.findtext('.//tt:Width', namespaces=NS), '3840')
+        for service in ['media', 'media2']:
+            status, root = request(service, 'GetVideoSourceConfigurations', config=config)
+            self.assertEqual(status, 200)
+            self.assertEqual(root.findtext('.//tt:UseCount', namespaces=NS), '12')
+            status, root = request(service, 'GetVideoEncoderConfigurationOptions',
+                                   '<ConfigurationToken>Profile_11_VideoEncoderToken'
+                                   '</ConfigurationToken>', config)
+            self.assertEqual(status, 200)
+            self.assertEqual(root.findtext('.//tt:ResolutionsAvailable/tt:Width',
+                                          namespaces=NS), '160')
+
