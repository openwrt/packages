+extern service_context_t service_ctx;
+
+static int source_operation(const char *operation)
+{
+    return !strcmp(operation, "GetVideoSources") ||
+        !strcmp(operation, "GetVideoSourceConfigurations") ||
+        !strcmp(operation, "GetVideoSourceConfiguration") ||
+        !strcmp(operation, "GetCompatibleVideoSourceConfigurations") ||
+        !strcmp(operation, "GetVideoSourceConfigurationOptions");
+}
+
+static void source_add(ezxml_t response, const char *operation, int version)
+{
+    double framerate;
+    ezxml_t member;
+    ezxml_t bounds;
+    int height;
+    int width;
+
+    media_source_info(&width, &height, &framerate);
+    if (!strcmp(operation, "GetVideoSources")) {
+        member = soap_member_add(response, version, "VideoSources");
+        ezxml_set_attr(member, "token", "VideoSourceToken");
+        soap_number_add(member, "tt:Framerate", framerate);
+        bounds = soap_child_add(member, "tt:Resolution", NULL);
+        soap_number_add(bounds, "tt:Width", width);
+        soap_number_add(bounds, "tt:Height", height);
+        return;
+    }
+    if (!strcmp(operation, "GetVideoSourceConfigurationOptions")) {
+        member = soap_member_add(response, version, "Options");
+        bounds = soap_child_add(member, "tt:BoundsRange", NULL);
+        soap_range_add(bounds, "tt:XRange", 0, 0);
+        soap_range_add(bounds, "tt:YRange", 0, 0);
+        soap_range_add(bounds, "tt:WidthRange", width, width);
+        soap_range_add(bounds, "tt:HeightRange", height, height);
+        soap_child_add(member, "tt:VideoSourceTokensAvailable", "VideoSourceToken");
+        return;
+    }
+    member = soap_member_add(response, version,
+                             !strcmp(operation, "GetVideoSourceConfiguration") ?
+                             "Configuration" : "Configurations");
+    media_source_configuration_add(member);
+}
+
+static void encoder_options_add(ezxml_t response, stream_profile_t *profile, int version)
+{
+    char number[MAX_LEN];
+    char codec[MAX_LEN];
+    ezxml_t resolution;
+    ezxml_t options;
+    ezxml_t encoder;
+    double framerate;
+
+    framerate = (double)profile->framerate / profile->framerate_den;
+    set_video_codec(codec, sizeof(codec), profile->type, version);
+    options = soap_member_add(response, version, "Options");
+    if (version == 2) {
+        snprintf(number, sizeof(number), "%.9g", framerate);
+        ezxml_set_attr_d(options, "FrameRatesSupported", number);
+        if (profile->type == H264 || profile->type == H265) {
+            snprintf(number, sizeof(number), "%d %d", profile->gov_length, profile->gov_length);
+            ezxml_set_attr_d(options, "GovLengthRange", number);
+            ezxml_set_attr_d(options, "ProfilesSupported", profile->encoding_profile);
+        }
+        soap_child_add(options, "tt:Encoding", codec);
+    }
+    soap_range_add(options, "tt:QualityRange", profile->quality, profile->quality);
+    encoder = options;
+    if (version == 1) {
+        snprintf(number, sizeof(number), "tt:%s", codec);
+        encoder = soap_child_add(options, number, NULL);
+    }
+    resolution = soap_child_add(encoder, "tt:ResolutionsAvailable", NULL);
+    soap_number_add(resolution, "tt:Width", profile->width);
+    soap_number_add(resolution, "tt:Height", profile->height);
+    if (version == 2) {
+        soap_range_add(encoder, "tt:BitrateRange", profile->bitrate, profile->bitrate);
+        return;
+    }
+    if (profile->type == H264 || profile->type == MPEG4)
+        soap_range_add(encoder, "tt:GovLengthRange", profile->gov_length, profile->gov_length);
+    framerate = ((long long)profile->framerate + profile->framerate_den - 1) /
+                profile->framerate_den;
+    soap_range_add(encoder, "tt:FrameRateRange", framerate, framerate);
+    soap_range_add(encoder, "tt:EncodingIntervalRange", profile->encoding_interval,
+                   profile->encoding_interval);
+    if (profile->type == H264)
+        soap_child_add(encoder, "tt:H264ProfilesSupported", profile->encoding_profile);
+    if (profile->type == MPEG4)
+        soap_child_add(encoder, "tt:Mpeg4ProfilesSupported", "SP");
+}
+
+int media_options_dispatch(const char *operation, int version)
+{
+    const char *configuration_token;
+    const char *profile_token;
+    const char *service;
+    ezxml_t response;
+    int source;
+    int index;
+    int i;
+
+    source = source_operation(operation);
+    if (!source && strcmp(operation, "GetVideoEncoderConfigurationOptions"))
+        return 0;
+    service = version == 1 ? "media_service" : "media2_service";
+    configuration_token = get_element("ConfigurationToken", "Body");
+    profile_token = get_element("ProfileToken", "Body");
+    index = profile_token ? media_profile_find(profile_token, "") : -1;
+    if (profile_token && index < 0) {
+        send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:NoProfile",
+                   "No profile", "The requested profile does not exist");
+        return 1;
+    }
+    if (configuration_token && source && strcmp(configuration_token, "VideoSourceConfigToken")) {
+        send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:NoConfig",
+                   "No configuration", "The requested source configuration does not exist");
+        return 1;
+    }
+    if (configuration_token && !source) {
+        index = media_profile_find(configuration_token, "_VideoEncoderToken");
+        if (index < 0) {
+            send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:NoConfig",
+                       "No configuration", "The requested encoder configuration does not exist");
+            return 1;
+        }
+    }
+    response = soap_response_create(version, operation);
+    if (source) {
+        source_add(response, operation, version);
+        soap_response_send(response);
+        return 1;
+    }
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        if (index >= 0 && index != i)
+            continue;
+        if (version == 1 && service_ctx.profiles[i].type == H265)
+            continue;
+        encoder_options_add(response, &service_ctx.profiles[i], version);
+        if (version == 1)
+            break;
+    }
+    soap_response_send(response);
+    return 1;
+}
