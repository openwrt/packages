 extern service_context_t service_ctx;
 
+#define DEFAULT_GOV_LENGTH 40
+#define DEFAULT_VIDEO_QUALITY 100
+#define DEFAULT_FRAME_RATE 30
+
+static void profile_init(stream_profile_t *profile)
+{
+    memset(profile, 0, sizeof(*profile));
+    profile->type = H264;
+    profile->framerate = DEFAULT_FRAME_RATE;
+    profile->framerate_den = 1;
+    profile->gov_length = DEFAULT_GOV_LENGTH;
+    profile->encoding_interval = 1;
+    profile->quality = DEFAULT_VIDEO_QUALITY;
+    profile->audio_encoder = AAC;
+}
+
+static int profiles_validate(void)
+{
+    stream_profile_t *profile;
+    int i;
+    int j;
+
+    if (service_ctx.source_width < 0 || service_ctx.source_height < 0 ||
+        service_ctx.source_framerate < 0 || service_ctx.source_framerate_den <= 0 ||
+        (!!service_ctx.source_width != !!service_ctx.source_height))
+        return -2;
+    for (i = 0; i < service_ctx.profiles_num; i++) {
+        profile = &service_ctx.profiles[i];
+        if (!profile->name || !*profile->name || profile->width <= 0 ||
+            profile->height <= 0 || profile->framerate <= 0 ||
+            profile->framerate_den <= 0 || profile->bitrate < 0 ||
+            profile->gov_length <= 0 || profile->encoding_interval <= 0 ||
+            !isfinite(profile->quality) || profile->quality < 0)
+            return -2;
+        for (j = 0; j < i; j++)
+            if (!strcmp(profile->name, service_ctx.profiles[j].name))
+                return -2;
+        if (!profile->encoding_profile)
+            profile->encoding_profile = strdup(profile->type == H265 ? "Main" : "High");
+        if (profile->type == H264 && strcmp(profile->encoding_profile, "Baseline") &&
+            strcmp(profile->encoding_profile, "Main") &&
+            strcmp(profile->encoding_profile, "Extended") &&
+            strcmp(profile->encoding_profile, "High"))
+            return -2;
+    }
+    return 0;
+}
