@@ -206,6 +206,35 @@ class CGITests(unittest.TestCase):
             path.write_text(original)
             self.assertEqual(request('media2', 'SetVideoEncoderConfiguration',
                                      '<Configuration token="missing"/>', config)[0], 500)
+
+    def test_encoder_setter_codecs(self):
+        with helper_configuration() as (config, path):
+            original = path.read_text()
+            for service, codec in [('media', 'H264'), ('media', 'JPEG'),
+                                   ('media2', 'H264'), ('media2', 'H265'), ('media2', 'JPEG')]:
+                state = json.loads(original)
+                state['profiles'][3].update(type=codec, encoding_profile='Main')
+                path.write_text(json.dumps(state))
+                operation = 'GetVideoEncoderConfiguration' if service == 'media' else 'GetVideoEncoderConfigurations'
+                status, root = request(service, operation,
+                                       '<ConfigurationToken>Profile_3_VideoEncoderToken</ConfigurationToken>', config)
+                self.assertEqual(status, 200)
+                node = root.find('.//{*}Configuration') if service == 'media' else root.find('.//{*}Configurations')
+                node.tag = 'Configuration'
+                node.find('tt:RateControl/tt:BitrateLimit', NS).text = '2345'
+                content = ET.tostring(node).decode()
+                status, root = request(service, 'SetVideoEncoderConfiguration', content, config)
+                self.assertEqual(status, 200, (service, codec))
+                self.assertEqual(json.loads(path.read_text())['last_set']['configuration']['bitrate'], 2345)
+                state = json.loads(path.read_text())
+                state['bad_reply'] = True
+                path.write_text(json.dumps(state))
+                self.assertEqual(request(service, 'SetVideoEncoderConfiguration', content, config)[0], 500)
+
+    def test_missing_snapshot(self):
+        for service in ['media', 'media2']:
+            self.assertEqual(request(service, 'GetSnapshotUri',
+                                     '<ProfileToken>Profile_0</ProfileToken>')[0], 500)
     def test_operation_namespace(self):
         status, root = request('media', 'GetProfiles', namespace='urn:unrelated')
         self.assertEqual(status, 500)
