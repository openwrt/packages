 static void uri_add(ezxml_t response, int index, int version, int snapshot)
@@ -279,6 +299,15 @@ int media_profiles_dispatch(const char *
     }
     response = soap_response_create(version, operation);
     if (uri) {
+        if ((!strcmp(operation, "GetSnapshotUri") &&
+             (!service_ctx.profiles[index].snapurl || !*service_ctx.profiles[index].snapurl)) ||
+            (!strcmp(operation, "GetStreamUri") &&
+             (!service_ctx.profiles[index].url || !*service_ctx.profiles[index].url))) {
+            ezxml_free(response->parent->parent);
+            send_fault((char *)service, "Sender", "ter:InvalidArgVal", "ter:IncompleteConfiguration",
+                       "Missing URI", "The requested profile has no configured URI");
+            return 1;
+        }
         uri_add(response, index, version, !strcmp(operation, "GetSnapshotUri"));
         soap_response_send(response);
         return 1;
--- a/soap.c
