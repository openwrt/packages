+int NoiseReduction::init([[maybe_unused]] IPAContext &context,
+			 const ValueNode &tuningData)
+{
+	int ret;
+
+	ret = parseLuma(tuningData);
+	if (ret)
+		return ret;
+
+	return parseChroma(tuningData);
+}
