+/**
+ * \class NoiseReduction
+ * \brief RkISP2 spatial noise reduction of the ISPP
+ *
+ * The ISPP NR stage denoises the luma with a four level wavelet filter (YNR)
+ * and the chroma with median and bilateral filters on two downscaled copies
+ * (UVNR), both steered by a luminance dependent noise sigma curve and by the
+ * ISP gain map of the frame.
+ *
+ * The calibration is per ISO step, ISO 50 being unity gain. For each frame
+ * the algorithm interpolates it at the gain of the latest ISP frame and
+ * converts it to the NR block following the Rockchip AIQ
+ * (select_ynr_params_by_ISO(), ynr_fix_transfer(),
+ * select_uvnr_params_by_ISO() and uvnr_fix_transfer() of
+ * camera_engine_rkaiq) at unity strength, so that its IQ calibration can be
+ * used as is. The calibration is converted from an IQ file with
+ * nr-iq2yaml.py.
+ *
+ * \code{.unparsed}
+ * algorithms:
+ *   - NoiseReduction:
+ *       luma:
+ *         - iso: 50
+ *           sigma-curve: [ ... ]
+ *           ...
+ *       chroma:
+ *         kernel-3x3: [ ... ]
+ *         ...
+ *         settings:
+ *           - iso: 50
+ *             step0-uvgrad-ratio: 40
+ *             ...
+ * \endcode
+ *
+ * The gain ratio and the use of the gain map come from the
+ * TemporalNoiseReduction algorithm, which programs the gain map; without it
+ * the NR runs on the global gain.
+ */
+
+LOG_DEFINE_CATEGORY(RkISP2Nr)
+
+namespace {
+
+using calibration::lerp;
+using calibration::readArray;
+using calibration::readScalar;
+using calibration::roundF;
+
+/* calibration and processing bit depths of the YNR sigma curve */
+constexpr unsigned int kCalBits = 12;
+constexpr unsigned int kSigmaBits = 10;
+constexpr unsigned int kCurveStepBits = 4;
+constexpr double kSigmaDiv = 1 << (kCalBits - kSigmaBits);
+constexpr double kLumaPointScale = 1 << (kSigmaBits - 8);
+
+/* fractional bits of the YNR register fields, from the AIQ */
+constexpr int kFracCi = 5;
+constexpr int kFracSigma = 5;
+constexpr int kFracWeight = 7;
+constexpr int kFracBfScale = 4;
+constexpr int kFracSoftness = 7;
+constexpr int kFracGrad = 4;
+constexpr int kFracStrength = 4;
+constexpr int kFracSoftThreshold = 8;
+constexpr int kFracExpLut = 7;
+constexpr int kFracLv4Gain = 4;
+constexpr long kSigmaMax = (1 << (kFracSigma + 9)) - 1;
+
+/* ynr_fix_transfer(): fixed low frequency weight comparison */
+constexpr double kWeightCompare = 0.1;
+
+/* squared distances of the five YNR high frequency edge weight taps */
+constexpr std::array<int, 5> kEdgeDist2 = { 1, 2, 4, 5, 8 };
+
+/* fractional bits of the UVNR register fields, from the AIQ */
+constexpr int kFracUvOffset = 4;
+constexpr int kFracUvGain = 4;
+constexpr int kFracUvMedian = 4;
+constexpr int kFracUvKernel = 7;
+constexpr int kFracUvBfRatio = 7;
+constexpr int kFracUvGainIso = 7;
+constexpr long kUvGainMax = 0x7f;
+constexpr long kUvGainIsoMin = 0x8;
+constexpr long kUvGainIsoMax = 0x80;
+constexpr long kUvSigmaMax = 8191;
+
+/* uvnr_fix_transfer(): log2(e) scaling of the inverse bilateral sigma */
+constexpr double kUvLog2e = 0.8493;
+constexpr int kUvLog2eBits = 6;
+constexpr int kUvImgBits = 8;
+
+long clampMax(long v, long max)
+{
+	return std::min(v, max);
+}
+
+double lumaPoint(unsigned int i)
+{
+	return i == NoiseReduction::kCurvePoints - 1
+		       ? 1 << kSigmaBits
+		       : i << (kSigmaBits - kCurveStepBits);
+}
+
+/* The luma curve ratio at \a x, linear between the curve points */
+double curveRate(double x, const NoiseReduction::Curve &pts,
+		 const NoiseReduction::Curve &ratios)
+{
+	unsigned int j = 0;
+	double t;
+
+	while (j < pts.size() && x > pts[j])
+		j++;
+
+	if (j == 0)
+		return ratios[0];
+	if (j >= pts.size())
+		return ratios.back();
+
+	t = (x - pts[j - 1]) / (pts[j] - pts[j - 1]);
+	return ratios[j - 1] + t * (ratios[j] - ratios[j - 1]);
+}
+
+unsigned int topOnePos(unsigned int v)
+{
+	unsigned int pos = 0;
+
+	while (v) {
+		pos++;
+		v >>= 1;
+	}
+
+	return pos;
+}
+
+} /* namespace */
+
+int NoiseReduction::parseLuma(const ValueNode &tuningData)
+{
+	if (!tuningData["luma"].isList()) {
+		LOG(RkISP2Nr, Error) << "No luma settings";
+		return -EINVAL;
+	}
+
+	for (const auto &node : tuningData["luma"].asList()) {
+		std::array<double, 5> curve;
+		bool ok = true;
+		Luma s;
+
+		ok &= readScalar(node, "iso", s.iso);
+		ok &= readArray(node, "sigma-curve", curve);
+		ok &= readArray(node, "ynr-lci", s.lci);
+		ok &= readArray(node, "ynr-lhci", s.lhci);
+		ok &= readArray(node, "ynr-hlci", s.hlci);
+		ok &= readArray(node, "ynr-hhci", s.hhci);
+		ok &= readArray(node, "lo-lumapoint", s.loPoint);
+		ok &= readArray(node, "lo-lumaratio", s.loRatio);
+		ok &= readScalar(node, "lo-directionstrength", s.loDirection);
+		ok &= readArray(node, "lo-bfscale", s.loBfScale);
+		ok &= readScalar(node, "imerge-ratio", s.mergeRatio);
+		ok &= readArray(node, "denoise-weight", s.loWeight);
+		ok &= readArray(node, "hi-lumapoint", s.hiPoint);
+		ok &= readArray(node, "hi-lumaratio", s.hiRatio);
+		ok &= readArray(node, "hi-bfscale", s.hiBfScale);
+		ok &= readArray(node, "hwith-d", s.hiSoftness);
+		ok &= readScalar(node, "hi-denoisestrength", s.hiStrength);
+		ok &= readScalar(node, "hi-detailminadjdnw", s.minAdjust);
+		ok &= readArray(node, "hi-denoiseweight", s.hiWeight);
+		ok &= readArray(node, "hgrad-y-level1", s.grad[0]);
+		ok &= readArray(node, "hgrad-y-level2", s.grad[1]);
+		ok &= readArray(node, "hgrad-y-level3", s.grad[2]);
+		ok &= readArray(node, "hgrad-y-level4", s.grad[3]);
+		ok &= readArray(node, "hi-soft-thresh-scale", s.softThreshold);
+		if (!ok)
+			return -EINVAL;
+
+		/* the sigma polynomial is calibrated over 12-bit luma */
+		for (unsigned int i = 0; i < kCurvePoints; i++) {
+			double x = lumaPoint(i) * (1 << (kCalBits - kSigmaBits));
+			double y = curve[4];
+			double xp = 1.0;
+
+			for (unsigned int o = 1; o <= 4; o++) {
+				xp *= x;
+				y += xp * curve[4 - o];
+			}
+			s.sigma[i] = std::max(y, 0.0);
+		}
+
+		if (!luma_.empty() && s.iso <= luma_.back().iso) {
+			LOG(RkISP2Nr, Error) << "Luma settings not sorted by iso";
+			return -EINVAL;
+		}
+		lumaIsos_.push_back(s.iso);
+		luma_.push_back(s);
+	}
+
+	if (luma_.size() < 2) {
+		LOG(RkISP2Nr, Error) << "Need two luma settings at least";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int NoiseReduction::parseChroma(const ValueNode &tuningData)
+{
+	const ValueNode &chroma = tuningData["chroma"];
+	bool ok = true;
+
+	ok &= readArray(chroma, "kernel-3x3", kernel3_);
+	ok &= readArray(chroma, "kernel-5x5", kernel5_);
+	ok &= readArray(chroma, "kernel-9x9", kernel9_);
+	ok &= readScalar(chroma, "kernel-9x9-num", kernel9Mode_);
+	if (!ok)
+		return -EINVAL;
+
+	if (!chroma["settings"].isList()) {
+		LOG(RkISP2Nr, Error) << "No chroma settings";
+		return -EINVAL;
+	}
+
+	for (const auto &node : chroma["settings"].asList()) {
+		Chroma s;
+
+		ok &= readScalar(node, "iso", s.iso);
+		ok &= readScalar(node, "step0-uvgrad-ratio", s.gradRatio);
+		ok &= readScalar(node, "step0-uvgrad-offset", s.gradOffset);
+		ok &= readScalar(node, "step1-median-ratio", s.median1);
+		ok &= readScalar(node, "step2-median-ratio", s.median2);
+		ok &= readScalar(node, "step1-bf-sigmar", s.sigmaR1);
+		ok &= readScalar(node, "step2-bf-sigmar", s.sigmaR2);
+		ok &= readScalar(node, "step3-bf-sigmar", s.sigmaR3);
+		ok &= readScalar(node, "step1-bf-uvgain", s.uvgain1);
+		ok &= readScalar(node, "step2-bf-uvgain", s.uvgain2);
+		ok &= readScalar(node, "step3-bf-uvgain", s.uvgain3);
+		ok &= readScalar(node, "step1-bf-ratio", s.bfRatio1);
+		ok &= readScalar(node, "step3-bf-ratio", s.bfRatio3);
+		if (!ok)
+			return -EINVAL;
+
+		if (s.sigmaR1 <= 0 || s.sigmaR2 <= 0 || s.sigmaR3 <= 0) {
+			LOG(RkISP2Nr, Error) << "Chroma sigmas must be positive";
+			return -EINVAL;
+		}
+
+		if (!chroma_.empty() && s.iso <= chroma_.back().iso) {
+			LOG(RkISP2Nr, Error) << "Chroma settings not sorted by iso";
+			return -EINVAL;
+		}
+		chromaIsos_.push_back(s.iso);
+		chroma_.push_back(s);
+	}
+
+	if (chroma_.size() < 2) {
+		LOG(RkISP2Nr, Error) << "Need two chroma settings at least";
+		return -EINVAL;
+	}
+
+	return 0;
+}
