+/**
+ * \brief Convert the luma calibration at an ISO to the YNR fields
+ * \param[in] iso The ISO, 50 times the gain
+ * \param[in] ratio The gain ratio of the gain map
+ * \param[out] nr The NR block
+ *
+ * Port of the AIQ select_ynr_params_by_ISO() and ynr_fix_transfer().
+ */
+void NoiseReduction::fixLuma(double iso, double ratio,
+			     struct rkispp_params_nr *nr) const
+{
+	calibration::IsoInterval in = calibration::isoInterval(lumaIsos_, iso);
+	const Luma &L = luma_[in.lo];
+	const Luma &H = luma_[in.hi];
+	double div = kSigmaDiv * std::sqrt(ratio);
+	std::array<double, kCurvePoints> sigma;
+	double r = in.r;
+	double gf;
+
+	Lvl lci = calibration::lerp(r, L.lci, H.lci);
+	Lvl lhci = calibration::lerp(r, L.lhci, H.lhci);
+	Lvl hlci = calibration::lerp(r, L.hlci, H.hlci);
+	Lvl hhci = calibration::lerp(r, L.hhci, H.hhci);
+	Lvl loBf = calibration::lerp(r, L.loBfScale, H.loBfScale);
+	Lvl loW = calibration::lerp(r, L.loWeight, H.loWeight);
+	Lvl hiBf = calibration::lerp(r, L.hiBfScale, H.hiBfScale);
+	Lvl hiSoft = calibration::lerp(r, L.hiSoftness, H.hiSoftness);
+	Lvl hiW = calibration::lerp(r, L.hiWeight, H.hiWeight);
+	Lvl sts = calibration::lerp(r, L.softThreshold, H.softThreshold);
+	Curve loPt = calibration::lerp(r, L.loPoint, H.loPoint);
+	Curve loRatio = calibration::lerp(r, L.loRatio, H.loRatio);
+	Curve hiPt = calibration::lerp(r, L.hiPoint, H.hiPoint);
+	Curve hiRatio = calibration::lerp(r, L.hiRatio, H.hiRatio);
+	double mergeRatio = lerp(r, L.mergeRatio, H.mergeRatio);
+	double mergeBound = 1.0 / mergeRatio / 2;
+	double direction = lerp(r, L.loDirection, H.loDirection);
+	double hiStrength = lerp(r, L.hiStrength, H.hiStrength);
+	double minAdjust = lerp(r, L.minAdjust, H.minAdjust);
+
+	for (double &v : loPt)
+		v *= kLumaPointScale;
+	for (double &v : hiPt)
+		v *= kLumaPointScale;
+
+	/* the AIQ halves the noise ci where the sigma gain drops below 1/2 */
+	gf = std::sqrt(calibration::kIsoUnity / iso);
+	if (gf < 0.5) {
+		for (Lvl *ci : { &lci, &lhci, &hlci, &hhci })
+			for (double &v : *ci)
+				v /= 2;
+		gf *= 2;
+	}
+	for (unsigned int i = 0; i < kCurvePoints; i++)
+		sigma[i] = lerp(r, L.sigma[i], H.sigma[i]) * gf;
+
+	for (unsigned int i = 0; i < kCurvePoints - 1; i++)
+		nr->ynr_sgm_dx[i] = topOnePos(lumaPoint(i + 1) - lumaPoint(i)) - 2;
+
+	for (unsigned int i = 0; i < kCurvePoints; i++) {
+		long base = static_cast<long>(sigma[i] * (1 << kFracSigma));
+		long lo = static_cast<long>(base * curveRate(lumaPoint(i), loPt, loRatio));
+		long hi = static_cast<long>(base * curveRate(lumaPoint(i), hiPt, hiRatio));
+
+		nr->ynr_lsgm_y[i] = std::min<double>(lo / div, kSigmaMax);
+		nr->ynr_hsgm_y[i] = std::min<double>(hi / div, kSigmaMax);
+		nr->ynr_hstv_y[i] = std::min<double>(base / div, UINT16_MAX);
+	}
+
+	for (unsigned int i = 0; i < kLevels; i++) {
+		nr->ynr_lci[i] = clampMax(lci[i] * (1 << kFracCi), 0xff);
+		nr->ynr_lhci[i] = clampMax(lhci[i] * (1 << kFracCi), 0xff);
+		nr->ynr_hlci[i] = clampMax(hlci[i] * (1 << kFracCi), 0xff);
+		nr->ynr_hhci[i] = clampMax(hhci[i] * (1 << kFracCi), 0xff);
+		nr->ynr_lgain_min[i] = clampMax(loBf[i] * (1 << kFracBfScale), 0xff);
+		nr->ynr_hgain_sgm[i] = clampMax(hiBf[i] * (1 << kFracBfScale), 0xff);
+		nr->ynr_lweit_flt[i] = std::min<uint8_t>(
+			static_cast<uint8_t>(loW[i] * (1 << kFracWeight)), 0x80);
+		nr->ynr_hweit[i] = std::min<uint16_t>(
+			static_cast<uint16_t>(hiW[i] * (1 << kFracWeight)), 0x1ff);
+	}
+
+	nr->ynr_lgain_max = static_cast<uint8_t>(direction * (1 << kFracBfScale));
+	nr->ynr_lmerge_bound = static_cast<uint8_t>(mergeBound * (1 << kFracStrength));
+	nr->ynr_lmerge_ratio = static_cast<uint8_t>(mergeRatio * (1 << kFracStrength));
+
+	for (unsigned int i = 0; i < kLevels; i++) {
+		long e = static_cast<long>(hiSoft[i] * (1 << kFracSoftness));
+
+		for (unsigned int k = 0; k < kEdgeDist2.size(); k++) {
+			double d = kEdgeDist2[k] * (1 << (2 * kFracSoftness));
+
+			nr->ynr_hweit_d[k * kLevels + i] = static_cast<uint8_t>(
+				std::exp(-d / (2.0 * e * e)) * (1 << kFracExpLut));
+		}
+	}
+
+	for (unsigned int i = 0; i < kLumaPoints; i++)
+		for (unsigned int l = 0; l < kLevels; l++)
+			nr->ynr_hgrad_y[i * kLevels + l] = static_cast<uint8_t>(
+				lerp(r, L.grad[l][i], H.grad[l][i]) * (1 << kFracGrad));
+
+	nr->ynr_hmax_adjust = static_cast<uint8_t>(minAdjust * (1 << kFracGrad));
+	nr->ynr_hstrength = clampMax(hiStrength * (1 << kFracStrength), 0xff);
+	nr->ynr_lweit_cmp[0] = roundF(kWeightCompare * (1 << kFracExpLut));
+	nr->ynr_lweit_cmp[1] = nr->ynr_lweit_cmp[0];
+	nr->ynr_lmaxgain_lv4 = clampMax(
+		roundF(std::sqrt(iso / calibration::kIsoUnity) * (1 << kFracLv4Gain)),
+		0xff);
+
+	for (unsigned int i = 0; i < RKISPP_NR_YNR_ST_SCALE_SIZE; i++)
+		nr->ynr_st_scale[i] =
+			static_cast<uint16_t>(sts[i] * (1 << kFracSoftThreshold));
+}
+
+/**
+ * \brief Convert the chroma calibration at an ISO to the UVNR fields
+ * \param[in] iso The ISO, 50 times the gain
+ * \param[in] ratio The gain ratio of the gain map
+ * \param[in] localGain True if the NR takes the gain from the gain map
+ * \param[out] nr The NR block
+ *
+ * Port of the AIQ select_uvnr_params_by_ISO() and uvnr_fix_transfer().
+ */
+void NoiseReduction::fixChroma(double iso, double ratio, bool localGain,
+			       struct rkispp_params_nr *nr) const
+{
+	calibration::IsoInterval in = calibration::isoInterval(chromaIsos_, iso);
+	const Chroma &L = chroma_[in.lo];
+	const Chroma &H = chroma_[in.hi];
+	double log2e = static_cast<long>(kUvLog2e * (1 << kUvLog2eBits)) *
+		       (1 << kUvImgBits);
+	double r = in.r;
+
+	auto li = [&](double Chroma::*m) { return lerp(r, L.*m, H.*m); };
+	auto msigma = [&](double sigma) {
+		return clampMax(static_cast<uint16_t>(log2e / sigma), kUvSigmaMax);
+	};
+	auto kernel = [](double v) {
+		return static_cast<uint8_t>(v * (1 << kFracUvKernel));
+	};
+
+	nr->uvnr_step1_en = 1;
+	nr->uvnr_step2_en = 1;
+	nr->nr_gain_en = !localGain;
+	nr->uvnr_nobig_en = 0;
+	nr->uvnr_big_en = 0;
+	nr->uvnr_sd32_self_en = 1;
+
+	nr->uvnr_gain_1sigma = static_cast<uint8_t>(li(&Chroma::gradRatio));
+	nr->uvnr_gain_offset =
+		static_cast<uint8_t>(li(&Chroma::gradOffset) * (1 << kFracUvOffset));
+	nr->uvnr_gain_uvgain[0] = clampMax(
+		static_cast<uint8_t>(li(&Chroma::uvgain1) * (1 << kFracUvGain)),
+		kUvGainMax);
+	nr->uvnr_gain_uvgain[1] = clampMax(
+		static_cast<uint8_t>(li(&Chroma::uvgain3) * (1 << kFracUvGain)),
+		kUvGainMax);
+	nr->uvnr_gain_t2gen = clampMax(
+		static_cast<uint8_t>(li(&Chroma::uvgain2) * (1 << kFracUvGain)),
+		kUvGainMax);
+	nr->uvnr_gain_iso = std::clamp<long>(
+		std::sqrt(calibration::kIsoUnity / (iso * ratio)) *
+			(1 << kFracUvGainIso),
+		kUvGainIsoMin, kUvGainIsoMax);
+
+	nr->uvnr_t1gen_m3alpha =
+		static_cast<uint8_t>(li(&Chroma::median1) * (1 << kFracUvMedian));
+	nr->uvnr_t1flt_mode = static_cast<uint8_t>(kernel9Mode_);
+	nr->uvnr_t1flt_msigma = msigma(li(&Chroma::sigmaR1));
+	nr->uvnr_t1flt_wtp =
+		static_cast<uint8_t>(li(&Chroma::bfRatio1) * (1 << kFracUvBfRatio));
+	for (unsigned int i = 0; i < kernel9_.size(); i++)
+		nr->uvnr_t1flt_wtq[i] = kernel(kernel9_[i]);
+
+	nr->uvnr_t2gen_m3alpha =
+		static_cast<uint8_t>(li(&Chroma::median2) * (1 << kFracUvMedian));
+	nr->uvnr_t2gen_msigma = msigma(li(&Chroma::sigmaR2));
+	nr->uvnr_t2gen_wtp = kernel(kernel5_[0]);
+	for (unsigned int i = 0; i < RKISPP_NR_UVNR_T2GEN_WTQ_SIZE; i++)
+		nr->uvnr_t2gen_wtq[i] = kernel(kernel5_[i + 1]);
+
+	nr->uvnr_t2flt_msigma = msigma(li(&Chroma::sigmaR3));
+	nr->uvnr_t2flt_wtp =
+		static_cast<uint8_t>(li(&Chroma::bfRatio3) * (1 << kFracUvBfRatio));
+	for (unsigned int i = 0; i < kernel3_.size(); i++)
+		nr->uvnr_t2flt_wt[i] = kernel(kernel3_[i]);
+}
+
+/**
+ * \brief Send the NR block for the gain of the latest ISP frame
+ * \param[in] context The shared IPA context
+ * \param[in] frame The ISPP frame number
+ * \param[out] params The ISPP parameters buffer
+ */
+void NoiseReduction::prepareIspp(IPAContext &context,
+				 [[maybe_unused]] const uint32_t frame,
+				 RkISPPParams *params)
+{
+	constexpr size_t header = sizeof(struct v4l2_isp_params_block_header);
+	const auto &noiseGain = context.activeState.noiseGain;
+	double gain = noiseGain.gain > 0.0 ? noiseGain.gain : 1.0;
+	double ratio = noiseGain.ratio > 0.0 ? noiseGain.ratio : 1.0;
+
+	if (!nr_ || ratio != nrRatio_ ||
+	    std::abs(gain - nrGain_) > calibration::kGainTolerance * nrGain_) {
+		struct rkispp_params_nr nr = {};
+		double iso = gain * calibration::kIsoUnity;
+
+		fixChroma(iso, ratio, noiseGain.localGain, &nr);
+		fixLuma(iso, ratio, &nr);
+		nr_ = nr;
+		nrGain_ = gain;
+		nrRatio_ = ratio;
+
+		LOG(RkISP2Nr, Debug)
+			<< "gain " << gain << " ratio " << ratio << " lsgm "
+			<< nr.ynr_lsgm_y[8] << " uv gain iso "
+			<< static_cast<unsigned int>(nr.uvnr_gain_iso);
+	}
+
+	auto block = params->block<RkISPPParamsBlocks::Nr>();
+	memcpy(reinterpret_cast<uint8_t *>(&*block) + header,
+	       reinterpret_cast<const uint8_t *>(&*nr_) + header,
+	       sizeof(*nr_) - header);
+	block.setEnabled(true);
+}
+
+REGISTER_IPA_ALGORITHM(NoiseReduction, "NoiseReduction")
+
+} /* namespace ipa::rkisp2::algorithms */
+
