+#pragma once
+
+#include <array>
+#include <optional>
+#include <vector>
+
+#include <linux/media/rockchip/rkisp2-config.h>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::rkisp2::algorithms {
+
+class Sharpen : public Algorithm
+{
+public:
+	Sharpen() = default;
+	~Sharpen() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context,
+		      const IPACameraSensorInfo &configInfo) override;
+	void prepareIspp(IPAContext &context, const uint32_t frame,
+			 RkISPPParams *params) override;
+
+	static constexpr unsigned int kLumaPoints = 8;
+
+	using Luma = std::array<double, kLumaPoints>;
+	using Kernel3 = std::array<double, 3 * 3>;
+	using Kernel5 = std::array<double, 5 * 5>;
+	using KernelMbf = std::array<double, 13 * 17>;
+
+	struct SharpSetting {
+		double iso;
+		double lratio;
+		double hratio;
+		double mRatio;
+		double hRatio;
+		Luma lumaSigma;
+		double pbfGain;
+		double pbfRatio;
+		double pbfAdd;
+		Luma clipPosM;
+		Luma clipNegM;
+		Luma clipH;
+		double mbfGain;
+		double hbfGain;
+		double hbfRatio;
+		double mbfAdd;
+		double hbfAdd;
+		double localStrength;
+	};
+
+	struct EdgeSetting {
+		double iso;
+		double edgeThed;
+		double srcWeight;
+		double alphaAdaptive;
+		double localAlpha;
+		double globalAlpha;
+		Luma noiseClip;
+		Luma dogClipPos;
+		Luma dogClipNeg;
+		Luma dogAlpha;
+		std::array<double, 5> directFilter;
+		Kernel5 dogKernel;
+	};
+
+	void fixSharp(double iso, struct rkispp_params_shp *shp) const;
+	void fixEdge(double iso, struct rkispp_params_shp *shp) const;
+
+private:
+	int parseSharp(const ValueNode &tuningData);
+	int parseEdge(const ValueNode &tuningData);
+
+	Luma lumaPoint_;
+	Kernel3 pbfCoeff_;
+	Kernel5 rfMCoeff_;
+	KernelMbf mbfCoeff_;
+	Kernel5 rfHCoeff_;
+	Kernel3 hbfCoeff_;
+	Kernel5 edgeHfCoeff_;
+	Kernel3 edgeGuideCoeff_;
+	double edgeDirMin_;
+
+	std::vector<SharpSetting> sharp_;
+	std::vector<double> sharpIsos_;
+	std::vector<EdgeSetting> edge_;
+	std::vector<double> edgeIsos_;
+
+	std::optional<struct rkispp_params_shp> shp_;
+	double shpGain_;
+};
