+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Daniel Golle
+ *
+ * RkISP2 sharpening
+ */
+
+#include "sharpen.h"
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <errno.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+#include <linux/media/rockchip/rkisp2-config.h>
+#include <linux/media/v4l2-isp.h>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+#include "calibration.h"
+
+/**
+ * \file sharpen.h
+ */
+
+namespace libcamera {
+
+namespace ipa::rkisp2::algorithms {
+
+/**
+ * \class Sharpen
+ * \brief RkISP2 sharpening of the ISPP
+ *
+ * The ISPP SHP stage sharpens the luma in a medium and a high frequency band,
+ * each through a bilateral filter with a luminance dependent sigma and
+ * clipping, and enhances edges with a difference of gaussians along the local
+ * edge direction.
+ *
+ * The calibration is per ISO step, ISO 50 being unity gain. For each frame
+ * the algorithm interpolates it at the gain of the latest ISP frame and
+ * converts it to the SHP block following the Rockchip AIQ
+ * (select_rk_sharpen_hw_params_by_ISO(), rk_Sharp_V1_fix_transfer(),
+ * select_edgefilter_params_by_ISO() and edgefilter_fix_transfer() of
+ * camera_engine_rkaiq) at unity strength, so that its IQ calibration can be
+ * used as is. The calibration is converted from an IQ file with
+ * nr-iq2yaml.py.
+ *
+ * \code{.unparsed}
+ * algorithms:
+ *   - Sharpen:
+ *       luma-point: [ 0, 16, 32, 64, 96, 160, 224, 256 ]
+ *       pbf-coeff: [ ... ]
+ *       ...
+ *       sharp:
+ *         - iso: 50
+ *           lratio: 0.2
+ *           ...
+ *       edge:
+ *         - iso: 50
+ *           edge-thed: 8
+ *           ...
+ * \endcode
+ */
+
+LOG_DEFINE_CATEGORY(RkISP2Sharpen)
+
+namespace {
+
+using calibration::lerp;
+using calibration::readArray;
+using calibration::readScalar;
+using calibration::roundF;
+
+/* fractional bits of the SHP register fields, from the AIQ */
+constexpr int kFracLratio = 8;
+constexpr int kFracHratio = 8;
+constexpr int kFracMHRatio = 2;
+constexpr int kFracPbfRatio = 7;
+constexpr int kFracLumMinM = 4;
+constexpr int kFracHbfRatio = 8;
+constexpr int kFracPbfCoeff = 6;
+constexpr int kFracMrfCoeff = 7;
+constexpr int kFracMbfCoeff = 6;
+constexpr int kFracHrfCoeff = 7;
+constexpr int kFracHbfCoeff = 6;
+constexpr int kFracDirMin = 6;
+constexpr int kFracAlpha = 8;
+constexpr int kFracDetailAlpha = 6;
+constexpr int kFracSmoothCoeff = 6;
+constexpr int kFracGausCoeff = 6;
+constexpr int kFracGuideCoeff = 4;
+constexpr int kFracDogCoeff = 6;
+constexpr int kFracSmooth4 = 8;
+
+/* rk_Sharp_V1_fix_transfer(): inverse sigma tables and their shift */
+constexpr int kSigmaDeciBits = 7;
+constexpr int kSigmaShiftOffset = 5;
+constexpr double kMaxLumaClip = 8.0;
+constexpr double kMaxFilterGain = 2.0;
+constexpr double kMaxFilterAdd = 255.0;
+constexpr long kLumMinMMin = -32;
+
+/* coefficient taps of each kernel register, in the AIQ order */
+constexpr std::array<unsigned int, 3> kTaps3 = { 4, 1, 0 };
+constexpr std::array<unsigned int, 6> kTaps5 = { 12, 7, 6, 2, 1, 0 };
+constexpr std::array<unsigned int, 12> kTapsMbf = {
+	110, 93, 92, 76, 58, 56, 25, 23, 38, 4, 69, 102
+};
+constexpr std::array<unsigned int, 3> kTapsSmooth = { 12, 11, 10 };
+
+/* row 2 of the 5x5 directional smoothing kernel */
+constexpr unsigned int kSmoothRow = 2 * 5;
+
+/*
+ * Quantise the register taps of a kernel; the first takes up the rounding of
+ * the whole kernel so that the fixed point sum matches the real one.
+ */
+template<size_t N, size_t T>
+std::array<long, T> kernelFix(const std::array<double, N> &coef,
+			      const std::array<unsigned int, T> &taps, int bits)
+{
+	std::array<long, T> out;
+	double sum = 0.0;
+	long fixSum = 0;
+
+	for (unsigned int t = 0; t < T; t++)
+		out[t] = roundF(coef[taps[t]] * (1 << bits));
+
+	for (double c : coef) {
+		sum += c;
+		fixSum += roundF(c * (1 << bits));
+	}
+
+	out[0] += static_cast<long>(sum * (1 << bits)) - fixSum;
+
+	return out;
+}
+
+/* The inverse sigma table of a bilateral filter and its shift */
+uint8_t sigmaTable(const Sharpen::Luma &lumaSigma, double gain, double add,
+		   uint8_t *table)
+{
+	long minVal = LONG_MAX;
+	int bits;
+
+	for (double ls : lumaSigma)
+		minVal = std::min(minVal, static_cast<long>(std::floor(ls * gain + add)));
+
+	bits = kSigmaDeciBits +
+	       static_cast<int>(std::floor(std::log2(std::max(minVal, 1L))));
+
+	for (unsigned int i = 0; i < lumaSigma.size(); i++)
+		table[i] = static_cast<uint8_t>(
+			roundF(1.0 / (lumaSigma[i] * gain + add) * (1 << bits)));
+
+	return bits - kSigmaShiftOffset;
+}
+
+} /* namespace */
+
+int Sharpen::parseSharp(const ValueNode &tuningData)
+{
+	if (!tuningData["sharp"].isList()) {
+		LOG(RkISP2Sharpen, Error) << "No sharp settings";
+		return -EINVAL;
+	}
+
+	for (const auto &node : tuningData["sharp"].asList()) {
+		bool ok = true;
+		SharpSetting s;
+
+		ok &= readScalar(node, "iso", s.iso);
+		ok &= readScalar(node, "lratio", s.lratio);
+		ok &= readScalar(node, "hratio", s.hratio);
+		ok &= readScalar(node, "mf-sharp-ratio", s.mRatio);
+		ok &= readScalar(node, "hf-sharp-ratio", s.hRatio);
+		ok &= readArray(node, "luma-sigma", s.lumaSigma);
+		ok &= readScalar(node, "pbf-gain", s.pbfGain);
+		ok &= readScalar(node, "pbf-ratio", s.pbfRatio);
+		ok &= readScalar(node, "pbf-add", s.pbfAdd);
+		ok &= readArray(node, "mf-clip-pos", s.clipPosM);
+		ok &= readArray(node, "mf-clip-neg", s.clipNegM);
+		ok &= readArray(node, "hf-clip", s.clipH);
+		ok &= readScalar(node, "mbf-gain", s.mbfGain);
+		ok &= readScalar(node, "hbf-gain", s.hbfGain);
+		ok &= readScalar(node, "hbf-ratio", s.hbfRatio);
+		ok &= readScalar(node, "mbf-add", s.mbfAdd);
+		ok &= readScalar(node, "hbf-add", s.hbfAdd);
+		ok &= readScalar(node, "local-sharp-strength", s.localStrength);
+		if (!ok)
+			return -EINVAL;
+
+		if (!sharp_.empty() && s.iso <= sharp_.back().iso) {
+			LOG(RkISP2Sharpen, Error) << "Sharp settings not sorted by iso";
+			return -EINVAL;
+		}
+		sharpIsos_.push_back(s.iso);
+		sharp_.push_back(s);
+	}
+
+	if (sharp_.size() < 2) {
+		LOG(RkISP2Sharpen, Error) << "Need two sharp settings at least";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+int Sharpen::parseEdge(const ValueNode &tuningData)
+{
+	if (!tuningData["edge"].isList()) {
+		LOG(RkISP2Sharpen, Error) << "No edge settings";
+		return -EINVAL;
+	}
+
+	for (const auto &node : tuningData["edge"].asList()) {
+		bool ok = true;
+		EdgeSetting s;
+
+		ok &= readScalar(node, "iso", s.iso);
+		ok &= readScalar(node, "edge-thed", s.edgeThed);
+		ok &= readScalar(node, "src-wgt", s.srcWeight);
+		ok &= readScalar(node, "alpha-adp-en", s.alphaAdaptive);
+		ok &= readScalar(node, "local-alpha", s.localAlpha);
+		ok &= readScalar(node, "global-alpha", s.globalAlpha);
+		ok &= readArray(node, "noise-clip", s.noiseClip);
+		ok &= readArray(node, "dog-clip-pos", s.dogClipPos);
+		ok &= readArray(node, "dog-clip-neg", s.dogClipNeg);
+		ok &= readArray(node, "dog-alpha", s.dogAlpha);
+		ok &= readArray(node, "direct-filter-coeff", s.directFilter);
+		ok &= readArray(node, "dog-kernel", s.dogKernel);
+		if (!ok)
+			return -EINVAL;
+
+		if (!edge_.empty() && s.iso <= edge_.back().iso) {
+			LOG(RkISP2Sharpen, Error) << "Edge settings not sorted by iso";
+			return -EINVAL;
+		}
+		edgeIsos_.push_back(s.iso);
+		edge_.push_back(s);
+	}
+
+	if (edge_.size() < 2) {
+		LOG(RkISP2Sharpen, Error) << "Need two edge settings at least";
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Sharpen::init([[maybe_unused]] IPAContext &context,
+		  const ValueNode &tuningData)
+{
+	bool ok = true;
+	int ret;
+
+	ok &= readArray(tuningData, "luma-point", lumaPoint_);
+	ok &= readArray(tuningData, "pbf-coeff", pbfCoeff_);
+	ok &= readArray(tuningData, "rf-m-coeff", rfMCoeff_);
+	ok &= readArray(tuningData, "mbf-coeff", mbfCoeff_);
+	ok &= readArray(tuningData, "rf-h-coeff", rfHCoeff_);
+	ok &= readArray(tuningData, "hbf-coeff", hbfCoeff_);
+	ok &= readArray(tuningData, "edge-hf-coeff", edgeHfCoeff_);
+	ok &= readArray(tuningData, "edge-guide-coeff", edgeGuideCoeff_);
+	ok &= readScalar(tuningData, "edge-dir-min", edgeDirMin_);
+	if (!ok)
+		return -EINVAL;
+
+	ret = parseSharp(tuningData);
+	if (ret)
+		return ret;
+
+	return parseEdge(tuningData);
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::configure
+ */
+int Sharpen::configure([[maybe_unused]] IPAContext &context,
+		       [[maybe_unused]] const IPACameraSensorInfo &configInfo)
+{
+	shp_.reset();
+
+	return 0;
+}
+
+/**
+ * \brief Convert the sharpening calibration at an ISO to the SHP fields
+ * \param[in] iso The ISO, 50 times the gain
+ * \param[out] shp The SHP block
+ *
+ * Port of the AIQ select_rk_sharpen_hw_params_by_ISO() and
+ * rk_Sharp_V1_fix_transfer().
+ */
+void Sharpen::fixSharp(double iso, struct rkispp_params_shp *shp) const
+{
+	calibration::IsoInterval in = calibration::isoInterval(sharpIsos_, iso);
+	const SharpSetting &L = sharp_[in.lo];
+	const SharpSetting &H = sharp_[in.hi];
+	double r = in.r;
+
+	auto li = [&](double SharpSetting::*m) { return lerp(r, L.*m, H.*m); };
+
+	Luma lumaSigma = calibration::lerp(r, L.lumaSigma, H.lumaSigma);
+	Luma clipPosM = calibration::lerp(r, L.clipPosM, H.clipPosM);
+	Luma clipNegM = calibration::lerp(r, L.clipNegM, H.clipNegM);
+	Luma clipH = calibration::lerp(r, L.clipH, H.clipH);
+	double mRatio = li(&SharpSetting::mRatio);
+	double hRatio = li(&SharpSetting::hRatio);
+	double mClip = mRatio > kMaxLumaClip ? mRatio / kMaxLumaClip : 1.0;
+	double hClip = hRatio > kMaxLumaClip ? hRatio / kMaxLumaClip : 1.0;
+	double pbfGain = std::min(li(&SharpSetting::pbfGain), kMaxFilterGain);
+	double pbfAdd = std::min(li(&SharpSetting::pbfAdd), kMaxFilterAdd);
+	double mbfGain = std::min(li(&SharpSetting::mbfGain), kMaxFilterGain);
+	double mbfAdd = std::min(li(&SharpSetting::mbfAdd), kMaxFilterAdd);
+	double hbfGain = std::min(li(&SharpSetting::hbfGain), kMaxFilterGain);
+	double hbfAdd = std::min(li(&SharpSetting::hbfAdd), kMaxFilterAdd);
+	long ehf = roundF(li(&SharpSetting::localStrength));
+
+	shp->yin_flt_en = 1;
+	shp->edge_avg_en = 1;
+	shp->hbf_ratio = std::min(roundF(li(&SharpSetting::hbfRatio) *
+					 (1 << kFracHbfRatio)),
+				  0x100L);
+	shp->ehf_th = std::min(ehf, 0xffL);
+	shp->pbf_ratio = std::min(roundF(li(&SharpSetting::pbfRatio) *
+					 (1 << kFracPbfRatio)),
+				  0x80L);
+
+	std::array<long, 3> pbf = kernelFix(pbfCoeff_, kTaps3, kFracPbfCoeff);
+	std::array<long, 6> mrf = kernelFix(rfMCoeff_, kTaps5, kFracMrfCoeff);
+	std::array<long, 12> mbf = kernelFix(mbfCoeff_, kTapsMbf, kFracMbfCoeff);
+	std::array<long, 6> hrf = kernelFix(rfHCoeff_, kTaps5, kFracHrfCoeff);
+	std::array<long, 3> hbf = kernelFix(hbfCoeff_, kTaps3, kFracHbfCoeff);
+	std::copy(pbf.begin(), pbf.end(), shp->pbf_k);
+	std::copy(mrf.begin(), mrf.end(), shp->mrf_k);
+	std::copy(mbf.begin(), mbf.end(), shp->mbf_k);
+	std::copy(hrf.begin(), hrf.end(), shp->hrf_k);
+	std::copy(hbf.begin(), hbf.end(), shp->hbf_k);
+
+	for (unsigned int i = 0; i < RKISPP_SHP_LUM_POINT_SIZE; i++)
+		shp->lum_point[i] = roundF(lumaPoint_[i + 1]);
+
+	shp->pbf_shf_bits = sigmaTable(lumaSigma, pbfGain, pbfAdd, shp->pbf_sigma);
+	shp->mbf_shf_bits = sigmaTable(lumaSigma, mbfGain, mbfAdd, shp->mbf_sigma);
+	shp->hbf_shf_bits = sigmaTable(lumaSigma, hbfGain, hbfAdd, shp->hbf_sigma);
+
+	for (unsigned int i = 0; i < kLumaPoints; i++) {
+		shp->lum_clp_m[i] = std::min(
+			static_cast<long>(roundF(clipPosM[i]) * mClip), 0xffL);
+		shp->lum_min_m[i] = std::max(
+			roundF(clipNegM[i] * mClip * (1 << kFracLumMinM)),
+			kLumMinMMin);
+		shp->lum_clp_h[i] = std::min(
+			static_cast<long>(roundF(clipH[i]) * hClip), 0xffL);
+	}
+
+	shp->rfl_ratio = std::min(roundF(li(&SharpSetting::lratio) *
+					 (1 << kFracLratio)),
+				  0x100L);
+	shp->rfh_ratio = std::clamp(roundF(li(&SharpSetting::hratio) *
+					   (1 << kFracHratio)),
+				    0x100L, 0x3ffL);
+	shp->m_ratio = std::min<uint8_t>(roundF(mRatio * (1 << kFracMHRatio)), 0x1f);
+	shp->h_ratio = std::min<uint8_t>(roundF(hRatio * (1 << kFracMHRatio)), 0x1f);
+}
+
+/**
+ * \brief Convert the edge filter calibration at an ISO to the SHP fields
+ * \param[in] iso The ISO, 50 times the gain
+ * \param[out] shp The SHP block
+ *
+ * Port of the AIQ select_edgefilter_params_by_ISO() and
+ * edgefilter_fix_transfer(). Like the AIQ, the difference of gaussians kernel
+ * is the one of the ISO step below, not interpolated.
+ */
+void Sharpen::fixEdge(double iso, struct rkispp_params_shp *shp) const
+{
+	calibration::IsoInterval in = calibration::isoInterval(edgeIsos_, iso);
+	const EdgeSetting &L = edge_[in.lo];
+	const EdgeSetting &H = edge_[in.hi];
+	double r = in.r;
+	Kernel5 smooth = {};
+	double dogSum = 0.0;
+
+	auto li = [&](double EdgeSetting::*m) { return lerp(r, L.*m, H.*m); };
+
+	Luma noiseClip = calibration::lerp(r, L.noiseClip, H.noiseClip);
+	Luma clipPos = calibration::lerp(r, L.dogClipPos, H.dogClipPos);
+	Luma clipNeg = calibration::lerp(r, L.dogClipNeg, H.dogClipNeg);
+	Luma dogAlpha = calibration::lerp(r, L.dogAlpha, H.dogAlpha);
+	std::array<double, 5> direct =
+		calibration::lerp(r, L.directFilter, H.directFilter);
+
+	shp->alpha_adp_en = static_cast<uint8_t>(li(&EdgeSetting::alphaAdaptive));
+	shp->edge_thed = std::min(roundF(li(&EdgeSetting::edgeThed)), 0xffL);
+	shp->dir_min = roundF(edgeDirMin_ * (1 << kFracDirMin));
+	shp->smoth_th4 = std::min(roundF(li(&EdgeSetting::srcWeight) *
+					 (1 << kFracSmooth4)),
+				  0xffL);
+	shp->l_alpha = std::min(roundF(li(&EdgeSetting::localAlpha) *
+				       (1 << kFracAlpha)),
+				0x1ffL);
+	shp->g_alpha = std::min(roundF(li(&EdgeSetting::globalAlpha) *
+				       (1 << kFracAlpha)),
+				0x1ffL);
+
+	std::array<long, 3> guide =
+		kernelFix(edgeGuideCoeff_, kTaps3, kFracGuideCoeff);
+	std::copy(guide.begin(), guide.end(), shp->eg_coef);
+
+	std::copy(direct.begin(), direct.end(), smooth.begin() + kSmoothRow);
+	std::array<long, 3> sm = kernelFix(smooth, kTapsSmooth, kFracSmoothCoeff);
+	std::copy(sm.begin(), sm.end(), shp->eg_smoth);
+
+	std::array<long, 6> gaus = kernelFix(edgeHfCoeff_, kTaps5, kFracGausCoeff);
+	std::copy(gaus.begin(), gaus.end(), shp->eg_gaus);
+
+	/* at unity strength the AIQ adds the whole kernel sum to the centre tap */
+	for (unsigned int t = 0; t < kTaps5.size(); t++)
+		shp->dog_k[t] = roundF(L.dogKernel[kTaps5[t]] * (1 << kFracDogCoeff));
+	for (double c : L.dogKernel)
+		dogSum += c;
+	shp->dog_k[0] += static_cast<long>(dogSum * (1 << kFracDogCoeff));
+
+	for (unsigned int i = 0; i < kLumaPoints; i++) {
+		shp->edge_lum_thed[i] = std::min(roundF(noiseClip[i]), 0xffL);
+		shp->clamp_pos[i] = std::min(roundF(clipPos[i]), 0xffL);
+		shp->clamp_neg[i] = std::min(roundF(clipNeg[i]), 0xffL);
+		shp->detail_alpha[i] =
+			std::min(roundF(dogAlpha[i] * (1 << kFracDetailAlpha)), 0xffL);
+	}
+}
+
+/**
+ * \brief Send the SHP block for the gain of the latest ISP frame
+ * \param[in] context The shared IPA context
+ * \param[in] frame The ISPP frame number
+ * \param[out] params The ISPP parameters buffer
+ */
+void Sharpen::prepareIspp(IPAContext &context,
+			  [[maybe_unused]] const uint32_t frame,
+			  RkISPPParams *params)
+{
+	constexpr size_t header = sizeof(struct v4l2_isp_params_block_header);
+	const auto &noiseGain = context.activeState.noiseGain;
+	double gain = noiseGain.gain > 0.0 ? noiseGain.gain : 1.0;
+
+	if (!shp_ ||
+	    std::abs(gain - shpGain_) > calibration::kGainTolerance * shpGain_) {
+		struct rkispp_params_shp shp = {};
+		double iso = gain * calibration::kIsoUnity;
+
+		fixSharp(iso, &shp);
+		fixEdge(iso, &shp);
+		shp_ = shp;
+		shpGain_ = gain;
+
+		LOG(RkISP2Sharpen, Debug)
+			<< "gain " << gain << " m_ratio "
+			<< static_cast<unsigned int>(shp.m_ratio) << " h_ratio "
+			<< static_cast<unsigned int>(shp.h_ratio);
+	}
+
+	auto block = params->block<RkISPPParamsBlocks::Shp>();
+	memcpy(reinterpret_cast<uint8_t *>(&*block) + header,
+	       reinterpret_cast<const uint8_t *>(&*shp_) + header,
+	       sizeof(*shp_) - header);
+	block.setEnabled(true);
+}
+
+REGISTER_IPA_ALGORITHM(Sharpen, "Sharpen")
+
