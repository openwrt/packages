+          exposureTime: [ 100, 10000, 30000, 60000, 120000 ]
+          gain: [ 1.0, 2.0, 4.0, 6.0, 6.0 ]
+        ExposureShort:
+          exposureTime: [ 100, 5000, 10000, 20000, 120000 ]
+          gain: [ 1.0, 2.0, 4.0, 6.0, 6.0 ]
+  - Awb:
+      algorithm: "grey"
+      AwbMode:
+        AwbAuto:
+          lo: 2500
+          hi: 8000
+        AwbIncandescent:
+          lo: 2500
+          hi: 3000
+        AwbTungsten:
+          lo: 3000
+          hi: 3500
+        AwbFluorescent:
+          lo: 4000
+          hi: 4700
+        AwbIndoor:
+          lo: 3000
+          hi: 5000
+        AwbDaylight:
+          lo: 5500
+          hi: 6500
+        AwbCloudy:
+          lo: 7000
+          hi: 8600
+      colourGains:
+        - ct: 2698
+          gains: [ 1.30192, 4.93583 ]
+        - ct: 2930
+          gains: [ 1.33067, 4.72590 ]
+        - ct: 3643
+          gains: [ 1.57357, 3.49895 ]
+        - ct: 4605
+          gains: [ 2.00321, 2.47466 ]
+        - ct: 5658
+          gains: [ 2.22321, 2.18627 ]
+  - BlackLevelSubtraction:
+  - Ccm:
+      ccms:
+        - ct: 2698
+          ccm: [
+                 1.57227, -0.32596, -0.24631, -0.61264, 1.70791, -0.09526, -0.43254, 0.48489,
+                 0.94765,
+               ]
+        - ct: 2930
+          ccm: [
+                 1.69455, -0.52724, -0.16731, -0.67131, 1.78468, -0.11338, -0.41609, 0.54693,
+                 0.86916,
+               ]
+        - ct: 3643
+          ccm: [
+                 1.74041, -0.77553, 0.03512, -0.44073, 1.34131, 0.09943, -0.11035, -0.93919,
+                 2.04954,
+               ]
+        - ct: 4605
+          ccm: [
+                 1.49865, -0.41638, -0.08227, -0.39445, 1.70114, -0.30669, 0.01319, -0.88009,
+                 1.86689,
+               ]
+        - ct: 5658
+          ccm: [
+                 1.38601, -0.23128, -0.15472, -0.37641, 1.70444, -0.32803, -0.01575, -0.71466,
