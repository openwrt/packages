+/*
+ * The driver enables the FEC stage only with a mesh loaded at stream start,
+ * so the start controls apply to it and a lens model set later takes effect
+ * at the next start.
+ */
+int RkISP2CameraData::primeFecMesh(const ControlList *controls)
+{
+	static const std::array<const ControlId *, 5> lensControls = {
+		&controls::rkisp2::LensModel,
+		&controls::rkisp2::LensCentre,
+		&controls::rkisp2::LensCoefficients,
+		&controls::rkisp2::LensFocalLength,
+		&controls::rkisp2::LensCorrectionLevel,
+	};
+	ControlList lens(controls::controls);
+	FrameBuffer *buffer;
+	unsigned int bytesused;
+	int ret;
+
+	for (const ControlId *id : lensControls) {
+		if (controls && controls->contains(id->id()))
+			lens.set(id->id(), controls->get(id->id()));
+	}
+
+	isppMeshActive_ = false;
+	isppMeshFree_.clear();
+	for (const std::unique_ptr<FrameBuffer> &b : isppMeshBuffers_)
+		isppMeshFree_.push_back(b.get());
+
+	if (!isppMesh_ || isppMeshFree_.empty())
+		return 0;
+
+	buffer = isppMeshFree_.back();
+	bytesused = ipa_->primeFecMesh(buffer->cookie(), isppMeshSize_.width,
+				       isppMeshSize_.height, lens);
+	if (!bytesused)
+		return 0;
+
+	ret = isppMesh_->streamOn();
+	if (ret)
+		return ret;
+
+	buffer->_d()->metadata().planes()[0].bytesused = bytesused;
+	ret = isppMesh_->queueBuffer(buffer);
+	if (ret) {
+		isppMesh_->streamOff();
+		return ret;
+	}
+
+	isppMeshFree_.pop_back();
+	isppMeshActive_ = true;
+
+	return 0;
+}
+
+void RkISP2CameraData::isppMeshBufferReady(FrameBuffer *buffer)
+{
+	isppMeshFree_.push_back(buffer);
+}
+
+void RkISP2CameraData::fecMeshChanged()
+{
+	FrameBuffer *buffer;
+
+	if (!isppMeshActive_) {
+		LOG(RkISP2, Warning) << "Lens correction changes apply at the next start";
+		return;
+	}
+
+	if (isppMeshFree_.empty()) {
+		LOG(RkISP2, Warning) << "No free FEC mesh buffer";
+		return;
+	}
+
+	buffer = isppMeshFree_.back();
+	isppMeshFree_.pop_back();
+	ipa_->computeFecMesh(buffer->cookie(), isppMeshSize_.width,
+			     isppMeshSize_.height);
+}
+
+void RkISP2CameraData::fecMeshComputed(unsigned int bufferId,
+				       unsigned int bytesused)
+{
+	auto it = std::find_if(isppMeshBuffers_.begin(), isppMeshBuffers_.end(),
+			       [bufferId](const std::unique_ptr<FrameBuffer> &b) {
+				       return b->cookie() == bufferId;
+			       });
+	FrameBuffer *buffer;
+	int ret;
+
+	if (it == isppMeshBuffers_.end())
+		return;
+
+	buffer = it->get();
+	if (!bytesused) {
+		isppMeshFree_.push_back(buffer);
+		return;
+	}
+
+	buffer->_d()->metadata().planes()[0].bytesused = bytesused;
+	ret = isppMesh_->queueBuffer(buffer);
+	if (ret < 0) {
+		LOG(RkISP2, Error) << "Failed to queue the FEC mesh: " << strerror(-ret);
+		isppMeshFree_.push_back(buffer);
+	}
+}
