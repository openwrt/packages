+		std::array<Lvl, 2> bfScale;
+		Coef6 lumaNrCurve;
+		double denoiseStrength;
+		std::array<Coef6, 2> gfDelta0;
+		std::array<std::array<Coef3, kLevels - 1>, 2> gfDelta;
+		std::array<LvlUv, 2> noiseProfileUv;
+		std::array<LvlUv, 2> bfScaleUv;
+		double denoiseStrengthUv;
+		std::array<Coef6, 2> gfDeltaUv0;
+		std::array<std::array<Coef3, kLevelsUv - 1>, 2> gfDeltaUv;
+		Coef6 gfSigma0;
+		std::array<Coef3, kLevels - 1> gfSigma;
+	};
+
+	struct Selection {
+		Lvl weightLimitY;
+		LvlUv weightLimitUv;
+		std::array<double, 4> ratioFrq;
+		LvlUv lumaWInChroma;
+		std::array<Lvl, 2> ci;
+		std::array<Lvl, 2> scale;
+		Coef6 lumaNrCurve;
+		double dnStr;
+		std::array<Coef6, 2> gfDelta0;
+		std::array<std::array<Coef3, kLevels - 1>, 2> gfDelta;
+		std::array<LvlUv, 2> ciUv;
+		std::array<LvlUv, 2> scaleUv;
+		double dnStrUv;
+		std::array<Coef6, 2> gfDeltaUv0;
+		std::array<std::array<Coef3, kLevelsUv - 1>, 2> gfDeltaUv;
+		Coef6 gfSigma0;
+		std::array<Coef3, kLevels - 1> gfSigma;
+		std::array<double, kCurvePoints> noiseSigma;
+		std::array<unsigned int, kCurvePoints> fixX;
+	};
+
+	Selection select(double iso) const;
+	static void fixTransfer(const Selection &s, double gain,
+				struct rkispp_params_tnr *tnr);
+
+private:
+	double gainRatio(double gain);
+
+	std::vector<Setting> settings_;
+	double sigmaScale_;
+	bool localGain_;
+
+	int gainStateFull_;
+	int gainState_;
+	double gain_;
+	double ratio_;
+
+	std::optional<struct rkispp_params_tnr> tnr_;
+	double tnrGain_;
+};
