+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Daniel Golle
+ *
+ * RkISP2 ISO step calibrations of the Rockchip AIQ
+ */
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <optional>
+#include <stddef.h>
+#include <vector>
+
+#include <libcamera/base/log.h>
+
+#include "libcamera/internal/value_node.h"
+
+namespace libcamera {
+
+namespace ipa::rkisp2::calibration {
+
+LOG_DECLARE_CATEGORY(RkISP2Calibration)
+
+constexpr double kIsoUnity = 50.0;
+
+/* Relative gain change below which a converted block is reused */
+constexpr double kGainTolerance = 0.005;
+
+struct IsoInterval {
+	size_t lo;
+	size_t hi;
+	double r;
+};
+
+long roundF(double x);
+double lerp(double r, double lo, double hi);
+bool readScalar(const ValueNode &node, const char *key, double &out);
+IsoInterval isoInterval(const std::vector<double> &isos, double iso);
+
+template<size_t N>
+bool readArray(const ValueNode &node, const char *key,
+	       std::array<double, N> &out)
+{
+	std::optional<std::vector<double>> v =
+		node[key].get<std::vector<double>>();
+
+	if (!v || v->size() != N) {
+		LOG(RkISP2Calibration, Error) << key << " needs " << N << " values";
+		return false;
+	}
+
+	std::copy(v->begin(), v->end(), out.begin());
+	return true;
+}
+
+template<size_t N>
+std::array<double, N> lerp(double r, const std::array<double, N> &lo,
+			   const std::array<double, N> &hi)
+{
+	std::array<double, N> out;
+
+	for (size_t k = 0; k < N; k++)
+		out[k] = lerp(r, lo[k], hi[k]);
+
+	return out;
+}
+
+} /* namespace ipa::rkisp2::calibration */
+
+} /* namespace libcamera */
