+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Daniel Golle
+ *
+ * RkISP2 ISO step calibrations of the Rockchip AIQ
+ */
+
+#include "calibration.h"
+
+/**
+ * \file calibration.h
+ * \brief Helpers for the ISO step calibrations of the Rockchip AIQ
+ *
+ * The noise reduction and sharpening calibrations of a Rockchip IQ file hold
+ * one setting per ISO step, ISO 50 being unity gain. The AIQ interpolates
+ * them linearly between the two steps around the ISO of a frame and clamps to
+ * the first and last step.
+ */
+
+namespace libcamera {
+
+namespace ipa::rkisp2::calibration {
+
+LOG_DEFINE_CATEGORY(RkISP2Calibration)
+
+/**
+ * \brief Round half away from zero, as ROUND_F() of the AIQ
+ * \param[in] x The value to round
+ * \return The rounded value
+ */
+long roundF(double x)
+{
+	return static_cast<long>(x + (x > 0 ? 0.5 : -0.5));
+}
+
+/**
+ * \brief Interpolate linearly
+ * \param[in] r The position between \a lo (0) and \a hi (1)
+ * \param[in] lo The value at 0
+ * \param[in] hi The value at 1
+ * \return The interpolated value
+ */
+double lerp(double r, double lo, double hi)
+{
+	return r * (hi - lo) + lo;
+}
+
+/**
+ * \brief Read a scalar of a calibration entry
+ * \param[in] node The calibration entry
+ * \param[in] key The key of the scalar
+ * \param[out] out The value
+ * \return True on success
+ */
+bool readScalar(const ValueNode &node, const char *key, double &out)
+{
+	std::optional<double> v = node[key].get<double>();
+
+	if (!v) {
+		LOG(RkISP2Calibration, Error) << "Invalid " << key;
+		return false;
+	}
+
+	out = *v;
+	return true;
+}
+
+/**
+ * \brief Find the ISO steps around an ISO
+ * \param[in] isos The ISO of each step, ascending, two at least
+ * \param[in] iso The ISO to look up
+ * \return The steps below and above \a iso and its position between them,
+ * clamped to the first and last step
+ */
+IsoInterval isoInterval(const std::vector<double> &isos, double iso)
+{
+	for (size_t i = 0; i + 1 < isos.size(); i++) {
+		if (iso >= isos[i] && iso <= isos[i + 1])
+			return { i, i + 1, (iso - isos[i]) / (isos[i + 1] - isos[i]) };
+	}
+
+	if (iso < isos.front())
+		return { 0, 1, 0.0 };
+
+	return { isos.size() - 2, isos.size() - 1, 1.0 };
+}
+
+} /* namespace ipa::rkisp2::calibration */
+
+} /* namespace libcamera */
