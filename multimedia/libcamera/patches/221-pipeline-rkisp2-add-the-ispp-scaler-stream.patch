-	return data->mainPath_->queueBuffer(buffer);
+	if (data->scaleActive_) {
+		FrameBuffer *scaleBuffer = request->findBuffer(&data->scaleStream_);
+
+		if (scaleBuffer) {
+			ret = data->isppScale_->queueBuffer(scaleBuffer);
+			if (ret < 0)
+				return ret;
+		}
+	}
+
+	return data->isppMain_->queueBuffer(buffer);
 }
 
