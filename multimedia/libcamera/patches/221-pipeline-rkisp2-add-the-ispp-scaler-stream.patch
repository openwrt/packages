+
+		return configureIsppScale(data, config);
+	}
 
 	/*
 	 * The ISP takes its input from the raw readback node only while the
@@ -1166,6 +1277,43 @@ int PipelineHandlerRkISP2::configureIspp
 	return configureIpa(data, cfg);
 }
 
+/* The scaler output takes the ISPP frame down to the second stream's size. */
+int PipelineHandlerRkISP2::configureIsppScale(RkISP2CameraData *data,
+					      CameraConfiguration *config)
+{
+	int ret;
+
+	data->scaleActive_ = false;
+	if (config->size() < 2)
+		return 0;
+
+	StreamConfiguration &cfg = config->at(1);
+
+	V4L2DeviceFormat scaleFormat;
+	scaleFormat.fourcc = isppScale_->toV4L2PixelFormat(cfg.pixelFormat);
+	scaleFormat.size = cfg.size;
+	scaleFormat.colorSpace = cfg.colorSpace;
+	scaleFormat.planes[0].bpl = cfg.stride;
+
+	LOG(RkISP2, Debug) << "Configuring ISPP scaler output with: " << scaleFormat;
+	ret = isppScale_->setFormat(&scaleFormat);
+	if (ret)
+		return ret;
+
+	if (scaleFormat.size != cfg.size ||
+	    scaleFormat.fourcc != isppScale_->toV4L2PixelFormat(cfg.pixelFormat)) {
+		LOG(RkISP2, Error)
+			<< "Unable to configure the ISPP scaler in " << cfg.toString();
+		return -EINVAL;
+	}
+
+	cfg.setStream(&data->scaleStream_);
+	cfg.stride = scaleFormat.planes[0].bpl;
+	data->scaleActive_ = true;
+
+	return 0;
+}
+
 int PipelineHandlerRkISP2::configureIpa(RkISP2CameraData *data,
 					const StreamConfiguration &cfg)
 {
@@ -1219,6 +1367,9 @@ int PipelineHandlerRkISP2::exportFrameBu
 	if (!data->usingIsp_ || data->isRaw_)
