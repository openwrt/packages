 	}
 
@@ -608,6 +622,27 @@ void RkISP2CameraData::ispBufferReady(Fr
 				      buffer->metadata().timestamp);
 
 	pipe()->completeBuffer(request, buffer);
+
+	/* The scaler buffer of the same frame completes the request after this. */
+	if (request->_d()->hasPendingBuffers())
+		return;
+
+	tryCompleteRequest(request, buffer);
+}
+
+void RkISP2CameraData::isppScaleBufferReady(FrameBuffer *buffer)
+{
+	Request *request = buffer->request();
+
+	pipe()->completeBuffer(request, buffer);
+	if (request->_d()->hasPendingBuffers())
+		return;
+
+	if (buffer->metadata().status == FrameMetadata::FrameCancelled) {
+		pipe()->completeRequest(request);
+		return;
+	}
+
 	tryCompleteRequest(request, buffer);
 }
 
