+		config->addConfiguration(scaleCfg);
+	}
+
 	config->validate();
 
 	return config;
@@ -1016,8 +1122,13 @@ int PipelineHandlerRkISP2::configure(Cam
 		return 0;
 	}
 
-	if (data->usingIspp_)
-		return configureIspp(data, cfg, format);
