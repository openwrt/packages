@@ -868,6 +910,47 @@ CameraConfiguration::Status RkISP2Camera
 	if (sensorFormat_.size.isNull())
 		status = Invalid;
 
+	if (config_.size() < 2)
+		return status;
+
+	/* The scaler output: any of its formats, no larger than the main one. */
+	StreamConfiguration &scaleCfg = config_[1];
+	V4L2VideoDevice *scale = data_->isppScale_;
+
+	if (!scale->toV4L2PixelFormat(scaleCfg.pixelFormat).isValid()) {
+		scaleCfg.pixelFormat = formats::NV12;
+		status = Adjusted;
+	}
+
+	if (scaleCfg.size.width > cfg.size.width ||
+	    scaleCfg.size.height > cfg.size.height) {
+		scaleCfg.size = cfg.size;
+		status = Adjusted;
+	}
+
+	V4L2DeviceFormat scaleFormat;
+	scaleFormat.fourcc = scale->toV4L2PixelFormat(scaleCfg.pixelFormat);
+	scaleFormat.size = scaleCfg.size;
+	scaleFormat.planes[0].bpl = scaleCfg.stride;
+
+	ret = scale->tryFormat(&scaleFormat);
+	if (ret)
+		return Invalid;
+
+	if (scaleFormat.size != scaleCfg.size) {
+		scaleCfg.size = scaleFormat.size;
+		status = Adjusted;
+	}
+
+	if (scaleCfg.stride && scaleCfg.stride != scaleFormat.planes[0].bpl)
+		status = Adjusted;
+	scaleCfg.stride = scaleFormat.planes[0].bpl;
+	scaleCfg.frameSize = 0;
+	for (unsigned int i = 0; i < scaleFormat.planesCount; i++)
+		scaleCfg.frameSize += scaleFormat.planes[i].size;
+
+	scaleCfg.bufferCount = kRkISP2StreamBufferCount;
+
 	return status;
 }
 
