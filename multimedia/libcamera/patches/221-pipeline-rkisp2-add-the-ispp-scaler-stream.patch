+		}
+		actions += [&]() { data->isppScale_->releaseBuffers(); };
+	}
+
 	for (const std::unique_ptr<FrameBuffer> &buffer : data->statBuffers_) {
 		ret = data->stat_->queueBuffer(buffer.get());
 		if (ret < 0)
@@ -1316,6 +1478,13 @@ int PipelineHandlerRkISP2::startIspp(Cam
 		return ret;
 	actions += [&]() { data->isppMain_->streamOff(); };
 
+	if (data->scaleActive_) {
+		ret = data->isppScale_->streamOn();
+		if (ret < 0)
+			return ret;
+		actions += [&]() { data->isppScale_->streamOff(); };
+	}
+
 	if (controls) {
 		ret = processControls(data, *controls);
 		if (ret < 0)
@@ -1330,10 +1499,14 @@ void PipelineHandlerRkISP2::stopIspp(Cam
 {
 	RkISP2CameraData *data = cameraData(camera);
 
+	if (data->scaleActive_)
+		data->isppScale_->streamOff();
 	data->isppMain_->streamOff();
 	data->isp_->setFrameStartEnabled(false);
 	data->ipa_->stop();
 
+	if (data->scaleActive_)
+		data->isppScale_->releaseBuffers();
 	data->isppMain_->releaseBuffers();
 
 	data->stat_->streamOff();
@@ -1559,10 +1732,20 @@ int PipelineHandlerRkISP2::queueRequestD
 	data->computeParamBuffers(data->frame_ - data->ispBase_);
 	data->frame_++;
 
-	if (data->usingIspp_)
-		return data->isppMain_->queueBuffer(buffer);
+	if (!data->usingIspp_)
