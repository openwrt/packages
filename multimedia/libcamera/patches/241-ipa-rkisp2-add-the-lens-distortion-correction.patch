+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Daniel Golle
+ *
+ * RkISPP FEC correction mesh generator
+ */
+
+#pragma once
+
+#include <array>
+#include <stdint.h>
+#include <vector>
+
+namespace libcamera {
+
+namespace ipa::rkisp2::fecmesh {
+
+/* OCamCalib (Scaramuzza) model: z(rho) = a0 + a2 rho^2 + a3 rho^3 + a4 rho^4 */
+struct OcamLens {
+	double cx;
+	double cy;
+	std::array<double, 4> a;
+};
+
+/* OpenCV fisheye model: theta_d = theta (1 + k1 t^2 + k2 t^4 + k3 t^6 + k4 t^8) */
+struct FisheyeLens {
+	double fx;
+	double fy;
+	double cx;
+	double cy;
+	std::array<double, 4> k;
+};
+
+struct Mesh {
+	unsigned int width;
+	unsigned int height;
+	std::vector<uint16_t> xi;
+	std::vector<uint8_t> xf;
+	std::vector<uint16_t> yi;
+	std::vector<uint8_t> yf;
+};
+
+unsigned int meshSize(unsigned int width, unsigned int height);
+
