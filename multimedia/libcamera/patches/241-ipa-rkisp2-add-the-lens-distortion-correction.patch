+
+	int32_t model_;
+	std::array<float, 2> centre_;
+	std::array<float, 4> coefficients_;
+	std::array<float, 2> focal_;
+	int32_t level_;
+};
+
+} /* namespace ipa::rkisp2::algorithms */
