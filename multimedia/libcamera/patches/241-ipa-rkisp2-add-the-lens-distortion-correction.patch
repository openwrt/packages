+void IPARkISP2::computeFecMesh(const uint32_t bufferId, const uint32_t width,
+			       const uint32_t height)
+{
+	fecMeshComputed.emit(bufferId,
+			     primeFecMesh(bufferId, width, height, ControlList()));
+}
+
+uint32_t IPARkISP2::primeFecMesh(const uint32_t bufferId, const uint32_t width,
+				 const uint32_t height, const ControlList &controls)
+{
+	Span<uint8_t> buffer = mappedBuffers_.at(bufferId).planes()[0];
+	Size size(width, height);
+
+	for (const auto &a : algorithms()) {
+		Algorithm *algo = static_cast<Algorithm *>(a.get());
+		size_t bytes = algo->computeFecMesh(context_, buffer, size, controls);
+
+		if (bytes)
+			return bytes;
+	}
+
+	return 0;
 }
 
