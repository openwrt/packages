+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Daniel Golle
+ *
+ * RkISP2 lens distortion correction
+ */
+
+#include "fec.h"
+
+#include <algorithm>
+#include <errno.h>
+#include <limits>
+#include <optional>
+#include <string.h>
+#include <string>
+#include <vector>
+
+#include <linux/media/rockchip/rkisp2-config.h>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+#include "libcamera/internal/value_node.h"
+
+#include "fec_mesh.h"
+
+/**
+ * \file fec.h
+ */
+
+namespace libcamera {
+
+namespace ipa::rkisp2::algorithms {
+
+/**
+ * \class DistortionCorrection
+ * \brief RkISP2 lens distortion correction by the ISPP FEC
+ *
+ * The ISPP FEC stage resamples the picture through a mesh that holds, for a
+ * grid over the output, the source position to sample. The algorithm
+ * generates the mesh from a lens model, the OCamCalib omnidirectional model
+ * or the OpenCV fisheye model, and the pipeline handler loads it on the mesh
+ * device before streaming starts and whenever the lens controls change it.
+ * The output is a pinhole view whose focal length keeps the image edge
+ * nearest to the optical centre, so that the corrected picture has no blank
+ * area.
+ *
+ * \code{.unparsed}
+ * algorithms:
+ *   - DistortionCorrection:
+ *       model: ocamcalib
+ *       centre: [ 1956.39, 1140.64 ]
+ *       coefficients: [ -2819.41, 3.161e-5, 6.884e-8, -1.307e-11 ]
+ *       level: 255
+ * \endcode
+ *
+ * The fisheye model takes k1 to k4 as coefficients and a focal-length list
+ * of the horizontal and vertical focal length in pixels. The rkisp2
+ * LensModel, LensCentre, LensCoefficients, LensFocalLength and
+ * LensCorrectionLevel controls override the tuning file.
+ */
+
+LOG_DEFINE_CATEGORY(RkISP2Fec)
+
+namespace {
+
+constexpr int32_t kLevelMax = 255;
+constexpr size_t kTableAlign = 16;
+
+size_t alignTable(size_t offset)
+{
+	return (offset + kTableAlign - 1) / kTableAlign * kTableAlign;
+}
+
+template<size_t N>
+bool readList(const ValueNode &node, const char *key, std::array<float, N> &out)
+{
+	std::optional<std::vector<double>> v = node[key].get<std::vector<double>>();
+
+	if (!v || v->size() != N) {
+		LOG(RkISP2Fec, Error) << key << " needs " << N << " values";
+		return false;
+	}
+
+	std::copy(v->begin(), v->end(), out.begin());
+	return true;
+}
+
+template<typename T, size_t N>
+bool update(std::array<T, N> &dst, const std::optional<Span<const T, N>> &src)
+{
+	if (!src || std::equal(dst.begin(), dst.end(), src->begin()))
+		return false;
+
+	std::copy(src->begin(), src->end(), dst.begin());
+	return true;
+}
+
+template<typename T>
+bool update(T &dst, const std::optional<T> &src)
+{
+	if (!src || dst == *src)
+		return false;
+
+	dst = *src;
+	return true;
+}
+
+std::array<double, 4> toDouble(const std::array<float, 4> &v)
+{
+	return { v[0], v[1], v[2], v[3] };
+}
+
+} /* namespace */
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int DistortionCorrection::init(IPAContext &context, const ValueNode &tuningData)
+{
+	std::string model = tuningData["model"].get<std::string>("none");
+	constexpr float kMax = std::numeric_limits<float>::max();
+	constexpr float kMin = std::numeric_limits<float>::lowest();
+
+	centre_ = {};
+	coefficients_ = {};
+	focal_ = {};
+	level_ = std::clamp(tuningData["level"].get<int32_t>(kLevelMax), 0, kLevelMax);
+
+	if (model == "ocamcalib") {
+		model_ = controls::rkisp2::LensModelOcamCalib;
+	} else if (model == "fisheye") {
+		model_ = controls::rkisp2::LensModelFisheye;
+		if (!readList(tuningData, "focal-length", focal_))
+			return -EINVAL;
+	} else if (model == "none") {
+		model_ = controls::rkisp2::LensModelNone;
+	} else {
+		LOG(RkISP2Fec, Error) << "Unknown lens model " << model;
+		return -EINVAL;
+	}
+
+	if (model_ != controls::rkisp2::LensModelNone &&
+	    (!readList(tuningData, "centre", centre_) ||
+	     !readList(tuningData, "coefficients", coefficients_)))
+		return -EINVAL;
+
+	context.ctrlMap[&controls::rkisp2::LensModel] =
+		ControlInfo(controls::rkisp2::LensModelValues, ControlValue(model_));
+	context.ctrlMap[&controls::rkisp2::LensCentre] = ControlInfo(kMin, kMax);
+	context.ctrlMap[&controls::rkisp2::LensCoefficients] = ControlInfo(kMin, kMax);
+	context.ctrlMap[&controls::rkisp2::LensFocalLength] = ControlInfo(kMin, kMax);
+	context.ctrlMap[&controls::rkisp2::LensCorrectionLevel] =
+		ControlInfo(0, kLevelMax, level_);
+
+	return 0;
+}
+
+bool DistortionCorrection::applyControls(const ControlList &controls)
+{
+	const auto &level = controls.get(controls::rkisp2::LensCorrectionLevel);
+	bool changed = false;
+
+	changed |= update(model_, controls.get(controls::rkisp2::LensModel));
+	changed |= update(centre_, controls.get(controls::rkisp2::LensCentre));
+	changed |= update(coefficients_,
+			  controls.get(controls::rkisp2::LensCoefficients));
+	changed |= update(focal_, controls.get(controls::rkisp2::LensFocalLength));
+	if (level)
+		changed |= update(level_, std::optional<int32_t>(
+						  std::clamp(*level, 0, kLevelMax)));
+
+	return changed;
+}
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::queueRequest
+ */
+void DistortionCorrection::queueRequest(IPAContext &context,
+					[[maybe_unused]] const uint32_t frame,
+					[[maybe_unused]] IPAFrameContext &frameContext,
+					const ControlList &controls)
+{
+	if (applyControls(controls))
+		context.activeState.fec.meshChanged = true;
+}
+
+/**
+ * \brief Enable the FEC stage while a lens model is set
+ * \param[in] context The shared IPA context
+ * \param[in] frame The ISPP frame number
+ * \param[out] params The ISPP parameters buffer
+ */
+void DistortionCorrection::prepareIspp([[maybe_unused]] IPAContext &context,
+				       [[maybe_unused]] const uint32_t frame,
+				       RkISPPParams *params)
+{
+	auto block = params->block<RkISPPParamsBlocks::Fec>();
+
+	block.setEnabled(model_ != controls::rkisp2::LensModelNone);
+}
+
+/**
+ * \brief Generate the FEC mesh for a picture size
+ * \param[in] context The shared IPA context
+ * \param[out] buffer The mesh buffer of the mesh device
+ * \param[in] size The ISPP output size
+ * \param[in] controls The lens controls to apply first
+ *
+ * \return The number of bytes used, or 0 without a lens model
+ */
+size_t DistortionCorrection::computeFecMesh([[maybe_unused]] IPAContext &context,
+					    Span<uint8_t> buffer, const Size &size,
+					    const ControlList &controls)
+{
+	struct rkispp_fec_mesh header = {};
+	std::array<double, 4> coefficients;
+	fecmesh::Mesh mesh;
+	size_t n, end;
+
+	applyControls(controls);
+	coefficients = toDouble(coefficients_);
+
+	if (model_ == controls::rkisp2::LensModelOcamCalib) {
+		fecmesh::OcamLens lens{ centre_[0], centre_[1], coefficients };
+
+		mesh = fecmesh::generate(lens, size.width, size.height, level_);
+	} else if (model_ == controls::rkisp2::LensModelFisheye) {
+		fecmesh::FisheyeLens lens{ focal_[0], focal_[1], centre_[0],
+					   centre_[1], coefficients };
+
+		mesh = fecmesh::generate(lens, size.width, size.height, level_);
+	} else {
+		return 0;
+	}
+
+	n = mesh.xi.size();
+	header.width = size.width;
+	header.height = size.height;
+	header.density = RKISPP_FEC_MESH_COARSE;
+	header.mesh_size = n;
+	header.xint_offset = alignTable(sizeof(header));
+	header.xfra_offset = alignTable(header.xint_offset + 2 * n);
+	header.yint_offset = alignTable(header.xfra_offset + n);
+	header.yfra_offset = alignTable(header.yint_offset + 2 * n);
+	end = header.yfra_offset + n;
+
+	if (end > buffer.size()) {
+		LOG(RkISP2Fec, Error)
+			<< "Mesh of " << end << " bytes exceeds the buffer of "
+			<< buffer.size();
+		return 0;
+	}
+
+	memcpy(buffer.data(), &header, sizeof(header));
+	memcpy(buffer.data() + header.xint_offset, mesh.xi.data(), 2 * n);
+	memcpy(buffer.data() + header.xfra_offset, mesh.xf.data(), n);
+	memcpy(buffer.data() + header.yint_offset, mesh.yi.data(), 2 * n);
+	memcpy(buffer.data() + header.yfra_offset, mesh.yf.data(), n);
+
+	LOG(RkISP2Fec, Debug)
+		<< "Mesh for " << size << ", model " << model_ << ", level "
+		<< level_ << ", " << n << " vertices";
+
+	return end;
+}
+
+REGISTER_IPA_ALGORITHM(DistortionCorrection, "DistortionCorrection")
+
+} /* namespace ipa::rkisp2::algorithms */
+
+} /* namespace libcamera */
