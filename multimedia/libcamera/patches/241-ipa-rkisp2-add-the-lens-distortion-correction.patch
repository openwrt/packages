+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026, Daniel Golle
+ *
+ * RkISPP FEC correction mesh generator
+ */
+
+#include "fec_mesh.h"
+
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <utility>
+
+namespace libcamera {
+
+namespace ipa::rkisp2::fecmesh {
+
+namespace {
+
+/* coarse mesh geometry of cal_fec_mesh() in the ISPP driver */
+constexpr unsigned int kAlign = 32;
+constexpr unsigned int kStepX = 32;
+constexpr unsigned int kStepY = 16;
+constexpr unsigned int kStrip = 128;
+
+constexpr unsigned int kLevelMax = 255;
+constexpr int kFracBits = 8;
+
+/* the engine stalls on source positions 0 and w - 1 or beyond */
+constexpr double kClampLow = 1.0;
+constexpr double kClampHighMargin = 3.0;
+
+/* halves the bracket each step: 64 steps reach double precision */
+constexpr unsigned int kBisectSteps = 64;
+
+/* output focal search bracket, natural log around the edge distance */
+constexpr double kFocalLogRange = 10.0;
+
+using SourceMap = std::function<std::pair<double, double>(double, double)>;
+
+unsigned int alignUp(unsigned int v)
+{
+	return (v + kAlign - 1) / kAlign * kAlign;
+}
+
+/* Output positions of the vertices, in the order the engine reads them */
+std::vector<std::pair<unsigned int, unsigned int>>
+vertices(unsigned int width, unsigned int height)
+{
+	unsigned int w = alignUp(width), h = alignUp(height);
+	unsigned int cols = w / kStepX + 1;
+	unsigned int strips = (h + kStrip - 1) / kStrip;
+	unsigned int lastRows = ((h % kStrip) ? h % kStrip : kStrip) / kStepY + 1;
+	std::vector<std::pair<unsigned int, unsigned int>> out;
+
+	for (unsigned int s = 0; s < strips; s++) {
+		unsigned int rows = s + 1 < strips ? kStrip / kStepY + 1 : lastRows;
+
+		for (unsigned int c = 0; c < cols; c++)
+			for (unsigned int r = 0; r < rows; r++)
+				out.emplace_back(c * kStepX, s * kStrip + r * kStepY);
+	}
+
+	return out;
+}
+
+/* Find x in [lo, hi] with f(x) = target for f increasing */
+double bisect(const std::function<double(double)> &f, double target,
+	      double lo, double hi)
+{
+	for (unsigned int i = 0; i < kBisectSteps; i++) {
+		double mid = (lo + hi) / 2;
+
+		if (f(mid) < target)
+			lo = mid;
+		else
+			hi = mid;
+	}
+
+	return (lo + hi) / 2;
+}
+
+double nearestEdge(double cx, double cy, unsigned int width, unsigned int height)
+{
+	return std::min({ cx, width - 1 - cx, cy, height - 1 - cy });
+}
+
+void encode(double p, double max, uint16_t &integer, uint8_t &fraction)
+{
+	long fixed;
+
+	p = std::clamp(p, kClampLow, max);
+	fixed = std::lround(p * (1 << kFracBits));
+	integer = fixed >> kFracBits;
+	fraction = fixed & ((1 << kFracBits) - 1);
+}
+
+Mesh build(const SourceMap &map, unsigned int width, unsigned int height,
+	   unsigned int level)
+{
+	double k = static_cast<double>(std::min(level, kLevelMax)) / kLevelMax;
+	auto order = vertices(width, height);
+	Mesh mesh;
+
+	mesh.width = width;
+	mesh.height = height;
+	mesh.xi.resize(order.size());
+	mesh.xf.resize(order.size());
+	mesh.yi.resize(order.size());
+	mesh.yf.resize(order.size());
+
+	for (size_t n = 0; n < order.size(); n++) {
+		double u = order[n].first, v = order[n].second;
+		auto [x, y] = map(u, v);
+
+		encode(u + (x - u) * k, width - kClampHighMargin,
+		       mesh.xi[n], mesh.xf[n]);
+		encode(v + (y - v) * k, height - kClampHighMargin,
+		       mesh.yi[n], mesh.yf[n]);
+	}
+
+	return mesh;
+}
+
+} /* namespace */
+
+unsigned int meshSize(unsigned int width, unsigned int height)
+{
+	return vertices(width, height).size();
+}
+
+/*
+ * The output is a pinhole view whose focal length maps the image edge nearest
+ * to the centre onto itself, so that the corrected picture has no blank area.
+ */
+Mesh generate(const OcamLens &lens, unsigned int width, unsigned int height,
+	      unsigned int level)
+{
+	const auto &a = lens.a;
+	auto z = [&a](double r) {
+		return a[0] + a[1] * r * r + a[2] * r * r * r + a[3] * r * r * r * r;
+	};
+	double focal = -z(nearestEdge(lens.cx, lens.cy, width, height));
+	double diag = std::hypot(width, height);
+
+	SourceMap map = [&](double u, double v) {
+		double ro = std::hypot(u - lens.cx, v - lens.cy);
+		double rs, s;
+
+		if (ro == 0.0)
+			return std::make_pair(u, v);
+
+		rs = bisect([&](double r) { return focal * r / -z(r); }, ro, 0.0, diag);
+		s = rs / ro;
+		return std::make_pair(lens.cx + (u - lens.cx) * s,
+				      lens.cy + (v - lens.cy) * s);
+	};
+
+	return build(map, width, height, level);
+}
+
+Mesh generate(const FisheyeLens &lens, unsigned int width, unsigned int height,
+	      unsigned int level)
+{
+	const auto &k = lens.k;
+	auto distort = [&k](double theta) {
+		double t2 = theta * theta;
+
+		return theta * (1 + t2 * (k[0] + t2 * (k[1] + t2 * (k[2] + t2 * k[3]))));
+	};
+	double edge = nearestEdge(lens.cx, lens.cy, width, height);
+	/* source radius of the edge point decreases as the output focal grows */
+	double focal = std::exp(bisect(
+		[&](double lf) { return -lens.fx * distort(std::atan(edge / std::exp(lf))); },
+		-edge, std::log(edge) - kFocalLogRange,
+		std::log(edge) + kFocalLogRange));
+
+	SourceMap map = [&](double u, double v) {
+		double a = (u - lens.cx) / focal, b = (v - lens.cy) / focal;
+		double r = std::hypot(a, b);
+		double s = r > 0.0 ? distort(std::atan(r)) / r : 1.0;
+
+		return std::make_pair(lens.cx + lens.fx * a * s,
+				      lens.cy + lens.fy * b * s);
+	};
+
+	return build(map, width, height, level);
+}
+
+} /* namespace ipa::rkisp2::fecmesh */
+
+} /* namespace libcamera */
