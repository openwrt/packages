+uint32_t IPARkISP2::primeIsppParams(const uint32_t frame, const uint32_t bufferId)
+{
+	RkISPPParams params(mappedBuffers_.at(bufferId).planes()[0]);
+
+	for (const auto &a : algorithms()) {
+		Algorithm *algo = static_cast<Algorithm *>(a.get());
+
+		algo->prepareIspp(context_, frame, &params);
+	}
+
+	return params.bytesused();
+}
+
+void IPARkISP2::computeIsppParams(const uint32_t frame, const uint32_t bufferId)
+{
+	isppParamsComputed.emit(frame, bufferId, primeIsppParams(frame, bufferId));
+}
