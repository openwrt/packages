+constexpr Field orbFields[] = {
+	ISPP_FIELD(rkispp_params_orb, limit_value),
+	ISPP_FIELD(rkispp_params_orb, max_feature),
+};
+
+void storeValue(uint8_t *dst, const Field &field, int64_t value)
+{
+	switch (field.size) {
+	case 1:
+		if (field.isSigned)
+			*reinterpret_cast<int8_t *>(dst) = value;
+		else
+			*reinterpret_cast<uint8_t *>(dst) = value;
+		break;
+	case 2: {
+		uint16_t v = field.isSigned ? static_cast<int16_t>(value)
+					    : static_cast<uint16_t>(value);
+		memcpy(dst, &v, sizeof(v));
+		break;
+	}
+	default: {
+		uint32_t v = field.isSigned ? static_cast<int32_t>(value)
+					    : static_cast<uint32_t>(value);
+		memcpy(dst, &v, sizeof(v));
+		break;
+	}
+	}
+}
+
+int loadField(const ValueNode &node, const Field &field, uint8_t *block)
+{
+	uint8_t *dst = block + field.offset;
+
+	if (field.count == 1) {
+		std::optional<int32_t> value = node.get<int32_t>();
+		if (!value) {
+			LOG(RkISP2Ispp, Error)
+				<< "Invalid value for " << field.name;
+			return -EINVAL;
+		}
+
+		storeValue(dst, field, *value);
+		return 0;
+	}
+
+	std::optional<std::vector<int32_t>> values =
+		node.get<std::vector<int32_t>>();
+	if (!values || values->size() != field.count) {
+		LOG(RkISP2Ispp, Error)
+			<< field.name << " needs " << field.count << " values";
+		return -EINVAL;
+	}
+
+	for (size_t i = 0; i < field.count; i++)
+		storeValue(dst + i * field.size, field, (*values)[i]);
+
+	return 0;
+}
+
+template<typename T>
+int loadBlock(const ValueNode &tuningData, const char *name,
+	      Span<const Field> fields, std::optional<T> &block)
+{
+	if (!tuningData.contains(name))
+		return 0;
+
+	const ValueNode &node = tuningData[name];
+	if (!node.isDictionary()) {
+		LOG(RkISP2Ispp, Error) << name << " is not a dictionary";
+		return -EINVAL;
+	}
+
+	T data = {};
+	uint8_t *raw = reinterpret_cast<uint8_t *>(&data);
+
+	for (const auto &[key, value] : node.asDict()) {
+		const Field *field = nullptr;
+
+		for (const Field &f : fields) {
+			if (key == f.name) {
+				field = &f;
+				break;
+			}
+		}
+
+		if (!field) {
+			LOG(RkISP2Ispp, Error)
+				<< "Unknown " << name << " field " << key;
+			return -EINVAL;
+		}
+
+		int ret = loadField(value, *field, raw);
+		if (ret)
+			return ret;
+	}
+
+	block = data;
+	LOG(RkISP2Ispp, Debug) << "Loaded the " << name << " module parameters";
+
+	return 0;
+}
+
+template<typename T>
+void sendBlock(V4L2ParamsBlock<T> block, const T &data)
+{
+	constexpr size_t header = sizeof(struct v4l2_isp_params_block_header);
+
+	memcpy(reinterpret_cast<uint8_t *>(&*block) + header,
+	       reinterpret_cast<const uint8_t *>(&data) + header,
+	       sizeof(T) - header);
+	block.setEnabled(true);
+}
+
+} /* namespace */
+
+/**
+ * \copydoc libcamera::ipa::Algorithm::init
+ */
+int Ispp::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	int ret;
+
+	ret = loadBlock(tuningData, "Tnr", tnrFields, tnr_);
+	if (ret)
+		return ret;
+
+	ret = loadBlock(tuningData, "Nr", nrFields, nr_);
+	if (ret)
+		return ret;
+
+	ret = loadBlock(tuningData, "Shp", shpFields, shp_);
+	if (ret)
+		return ret;
+
+	ret = loadBlock(tuningData, "Fec", fecFields, fec_);
+	if (ret)
+		return ret;
+
+	return loadBlock(tuningData, "Orb", orbFields, orb_);
+}
+
+/**
+ * \brief Send the configured ISPP module parameters with the frame
+ * \param[in] context The shared IPA context
+ * \param[in] frame The ISPP frame number
+ * \param[out] params The ISPP parameters buffer
+ */
+void Ispp::prepareIspp([[maybe_unused]] IPAContext &context,
+		       [[maybe_unused]] const uint32_t frame,
+		       RkISPPParams *params)
+{
+	if (tnr_)
+		sendBlock(params->block<RkISPPParamsBlocks::Tnr>(), *tnr_);
+	if (nr_)
+		sendBlock(params->block<RkISPPParamsBlocks::Nr>(), *nr_);
+	if (shp_)
+		sendBlock(params->block<RkISPPParamsBlocks::Shp>(), *shp_);
+	if (fec_)
+		sendBlock(params->block<RkISPPParamsBlocks::Fec>(), *fec_);
+	if (orb_)
+		sendBlock(params->block<RkISPPParamsBlocks::Orb>(), *orb_);
+}
+
+REGISTER_IPA_ALGORITHM(Ispp, "Ispp")
+
+} /* namespace ipa::rkisp2::algorithms */
+
+} /* namespace libcamera */
