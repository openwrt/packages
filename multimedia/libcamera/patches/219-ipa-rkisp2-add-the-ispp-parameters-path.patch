+	std::optional<struct rkispp_params_shp> shp_;
+	std::optional<struct rkispp_params_fec> fec_;
+	std::optional<struct rkispp_params_orb> orb_;
+};
+
+} /* namespace ipa::rkisp2::algorithms */
