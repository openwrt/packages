+enum class RkISPPParamsBlocks : uint16_t {
+	Tnr,
+	Nr,
+	Shp,
+	Fec,
+	Orb,
+};
+
+namespace details {
+
+template<RkISPPParamsBlocks B>
+struct ispp_block_type {
+};
+
+#define RkISPP_DEFINE_PARAMS_BLOCK_TYPE(id, cfgType, blkType)		\
+template<>								\
+struct ispp_block_type<RkISPPParamsBlocks::id> {			\
+	using type = struct rkispp_params_##cfgType;			\
+	static constexpr rkispp_params_block_type blockType =		\
+		rkispp_params_block_type::RKISPP_PARAMS_BLOCK_##blkType;\
+}
+
+RkISPP_DEFINE_PARAMS_BLOCK_TYPE(Tnr,	tnr,	TNR);
+RkISPP_DEFINE_PARAMS_BLOCK_TYPE(Nr,	nr,	NR);
+RkISPP_DEFINE_PARAMS_BLOCK_TYPE(Shp,	shp,	SHP);
+RkISPP_DEFINE_PARAMS_BLOCK_TYPE(Fec,	fec,	FEC);
+RkISPP_DEFINE_PARAMS_BLOCK_TYPE(Orb,	orb,	ORB);
+
+struct ispp_param_traits {
+	using id_type = RkISPPParamsBlocks;
+
+	template<id_type Id>
+	using id_to_details = ispp_block_type<Id>;
+};
+
+} /* namespace details */
