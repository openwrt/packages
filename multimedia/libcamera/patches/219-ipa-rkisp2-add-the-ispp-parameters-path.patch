 src/ipa/rkisp2/data/imx415.yaml       |   1 +
 src/ipa/rkisp2/ispp_params.h          |  69 +++++
 src/ipa/rkisp2/rkisp2.cpp             |  14 +
 9 files changed, 545 insertions(+), 1 deletion(-)
 create mode 100644 src/ipa/rkisp2/algorithms/ispp.cpp
 create mode 100644 src/ipa/rkisp2/algorithms/ispp.h
