+/**
+ * \class Ispp
+ * \brief RkISPP module parameters from the tuning file
+ *
+ * The ISPP post-processor (temporal noise reduction, noise reduction,
+ * sharpening, FEC motion mesh and ORB feature detection) takes its
+ * parameters through its own params node. This algorithm sends the modules
+ * configured in the tuning file with every frame, each tuning dictionary
+ * filling the fields of the corresponding UAPI block by name:
+ *
+ * \code{.unparsed}
+ * algorithms:
+ *   - Ispp:
+ *       Shp:
+ *         tile_xcnt: 18
+ *         tile_ycnt: 121
+ *         pbf_k: [ 2, 1, 0 ]
+ *       Nr:
+ *         uvnr_step1_en: 1
+ * \endcode
+ *
+ * A module absent from the tuning file is not sent and keeps the driver's
+ * state; a field absent from a module dictionary is zero.
+ */
+
+LOG_DEFINE_CATEGORY(RkISP2Ispp)
+
+namespace {
+
+struct Field {
+	const char *name;
+	size_t offset;
+	size_t count;
+	size_t size;
+	bool isSigned;
+};
+
+template<typename T>
+constexpr size_t fieldCount()
+{
+	return sizeof(T) / sizeof(std::remove_all_extents_t<T>);
+}
+
+template<typename T>
+constexpr size_t fieldSize()
+{
+	return sizeof(std::remove_all_extents_t<T>);
+}
+
+template<typename T>
+constexpr bool fieldSigned()
+{
+	return std::is_signed_v<std::remove_all_extents_t<T>>;
+}
+
+#define ISPP_FIELD(type, name)						\
+	{ #name, offsetof(struct type, name),				\
+	  fieldCount<decltype(type::name)>(),				\
+	  fieldSize<decltype(type::name)>(),				\
+	  fieldSigned<decltype(type::name)>() }
+
