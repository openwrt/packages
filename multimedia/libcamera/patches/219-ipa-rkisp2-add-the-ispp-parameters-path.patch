+constexpr Field fecFields[] = {
+	ISPP_FIELD(rkispp_params_fec, mesh_density),
+	ISPP_FIELD(rkispp_params_fec, crop_en),
+	ISPP_FIELD(rkispp_params_fec, crop_width),
+	ISPP_FIELD(rkispp_params_fec, crop_height),
+	ISPP_FIELD(rkispp_params_fec, mesh_size),
+};
