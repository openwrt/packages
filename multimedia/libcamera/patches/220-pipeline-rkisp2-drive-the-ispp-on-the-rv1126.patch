+/*
+ * The ISPP root stream start waits for the params stream and its first
+ * buffer, so the params are up, with every buffer filled and queued, before
+ * the main output starts; the statistics node starts with the ISP.
+ */
+int PipelineHandlerRkISP2::startIspp(Camera *camera, const ControlList *controls)
+{
+	RkISP2CameraData *data = cameraData(camera);
+	unsigned int count = data->stream_.configuration().bufferCount;
+	utils::ScopeExitActions actions;
+	int ret;
+
+	data->frame_ = 0;
+	data->ispSequence_ = 0;
+	data->ispBase_ = 0;
+	data->ispBaseSet_ = false;
+	data->isppFrame_ = 0;
+
+	ret = allocateBuffers(camera);
+	if (ret) {
+		LOG(RkISP2, Error) << "Failed to allocate buffers";
+		return ret;
+	}
+	actions += [&]() { freeBuffers(camera); };
+
+	ret = data->ipa_->start();
+	if (ret) {
+		LOG(RkISP2, Error) << "Failed to start IPA " << camera->id();
+		return ret;
+	}
+	actions += [&]() { data->ipa_->stop(); };
+	data->delayedCtrls_->reset();
+	data->isppPushSequence_ = 1;
+	data->isppSensorControls_.clear();
+
+	ret = data->param_->streamOn();
+	if (ret) {
+		LOG(RkISP2, Error) << "Failed to start parameters " << camera->id();
+		return ret;
+	}
+	actions += [&]() { data->param_->streamOff(); };
+
+	for (const std::unique_ptr<FrameBuffer> &buffer : data->isppParamBuffers_) {
+		ret = data->primeIsppParamBuffer(buffer.get());
+		if (ret < 0) {
+			LOG(RkISP2, Error) << "Failed to queue the ISPP parameters";
+			return ret;
+		}
+	}
+
+	ret = data->isppParam_->streamOn();
+	if (ret) {
+		LOG(RkISP2, Error) << "Failed to start ISPP parameters " << camera->id();
+		return ret;
+	}
+	actions += [&]() { data->isppParam_->streamOff(); };
+
+	ret = data->isppMain_->importBuffers(count);
+	if (ret < 0) {
+		LOG(RkISP2, Error) << "Failed to import buffers to the ISPP main output";
+		return ret;
+	}
+	actions += [&]() { data->isppMain_->releaseBuffers(); };
+
+	for (const std::unique_ptr<FrameBuffer> &buffer : data->statBuffers_) {
+		ret = data->stat_->queueBuffer(buffer.get());
+		if (ret < 0)
+			LOG(RkISP2, Warning)
+				<< "Failed to queue buffer " << &buffer
+				<< " to stat: " << ret;
+	}
+
+	ret = data->stat_->streamOn();
+	if (ret) {
+		LOG(RkISP2, Error) << "Failed to start stats " << camera->id();
+		return ret;
+	}
+	actions += [&]() { data->stat_->streamOff(); };
+
+	ret = data->isp_->setFrameStartEnabled(true);
+	if (ret) {
+		LOG(RkISP2, Error) << "Failed to enable the ISP frame start event";
+		return ret;
+	}
+	actions += [&]() { data->isp_->setFrameStartEnabled(false); };
+
+	ret = data->isppMain_->streamOn();
+	if (ret < 0)
+		return ret;
+	actions += [&]() { data->isppMain_->streamOff(); };
+
+	if (controls) {
+		ret = processControls(data, *controls);
+		if (ret < 0)
+			return ret;
+	}
+
+	actions.release();
+	return 0;
+}
+
+void PipelineHandlerRkISP2::stopIspp(Camera *camera)
+{
+	RkISP2CameraData *data = cameraData(camera);
+
+	data->isppMain_->streamOff();
+	data->isp_->setFrameStartEnabled(false);
+	data->ipa_->stop();
+
+	data->isppMain_->releaseBuffers();
+
+	data->stat_->streamOff();
+	data->stat_->releaseBuffers();
+
+	data->isppParam_->streamOff();
+	data->param_->streamOff();
+
+	data->statBuffers_.clear();
+	freeBuffers(camera);
+}
