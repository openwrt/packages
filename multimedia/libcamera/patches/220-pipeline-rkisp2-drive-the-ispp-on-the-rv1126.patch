+/* The memory planes of a frame in the V4L2 format mainPathFormat() picked */
+static unsigned int mainPathPlanes(const V4L2PixelFormat &fourcc,
+				   const PixelFormat &pixelFormat)
+{
+	const PixelFormatInfo &info = PixelFormatInfo::info(pixelFormat);
+
+	if (info.v4l2Formats.size() > 1 && fourcc == info.v4l2Formats.back())
+		return info.numPlanes();
+
+	return 1;
+}
