+void RkISP2CameraData::ispFrameStart(uint32_t sequence)
+{
+	unsigned int slot = sequence + kRkISP2IsppFrameStartLag +
+			    delayedCtrls_->maxDelay();
+
+	ispSequence_ = sequence;
+
+	/* DelayedControls warns about every gap and every repeat in the slots */
+	while (isppPushSequence_ < slot)
+		delayedCtrls_->push(isppPushSequence_++, {});
+	delayedCtrls_->push(isppPushSequence_++, isppSensorControls_);
+	isppSensorControls_.clear();
+
+	delayedCtrls_->applyControls(slot);
+}
