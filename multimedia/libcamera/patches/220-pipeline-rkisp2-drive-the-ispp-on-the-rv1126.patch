+/*
+ * The ISPP pipe: the VICAP feeds the ISP inside the kernel (the readback
+ * link stays disabled), the ISP main path writes into the ISPP input pool
+ * and the ISPP main output is the capture node. The ISPP output pad of the
+ * ISP decides the pipe size.
+ */
+int PipelineHandlerRkISP2::configureIspp(RkISP2CameraData *data,
+					 StreamConfiguration &cfg,
+					 V4L2SubdeviceFormat &format)
+{
+	int ret;
+
+	ret = rawrdLink_->setEnabled(false);
+	if (ret)
+		return ret;
+
+	LOG(RkISP2, Debug) << "Configuring ISP input with: " << format;
+	ret = isp_->setFormat(0, &format);
+	if (ret)
+		return ret;
+
+	/* The ISPP input follows the ISP output pad, the query syncs them. */
+	V4L2SubdeviceFormat isppFormat;
+	ret = isppSubdev_->getFormat(0, &isppFormat);
+	if (ret)
+		return ret;
+
+	LOG(RkISP2, Debug) << "ISPP input: " << isppFormat;
+
+	V4L2DeviceFormat outputFormat;
+	outputFormat.fourcc = mainPathFormat(isppMain_.get(), cfg.pixelFormat);
+	outputFormat.size = isppFormat.size;
+	outputFormat.colorSpace = cfg.colorSpace;
+	outputFormat.planesCount = mainPathPlanes(outputFormat.fourcc,
+						  cfg.pixelFormat);
+	outputFormat.planes[0].bpl = cfg.stride;
+
+	LOG(RkISP2, Debug) << "Configuring ISPP main output with: " << outputFormat;
+	ret = isppMain_->setFormat(&outputFormat);
+	if (ret)
+		return ret;
+
+	if (outputFormat.fourcc != mainPathFormat(isppMain_.get(), cfg.pixelFormat)) {
+		LOG(RkISP2, Error)
+			<< "Unable to configure the ISPP output in " << cfg.toString();
+		return -EINVAL;
+	}
+
+	if (outputFormat.size != cfg.size) {
+		LOG(RkISP2, Warning)
+			<< "ISPP pipe runs at " << outputFormat.size
+			<< " for the requested " << cfg.size;
+		cfg.size = outputFormat.size;
+	}
+
+	cfg.setStream(&data->stream_);
+	cfg.stride = outputFormat.planes[0].bpl;
+
+	V4L2DeviceFormat isppParamFormat;
+	isppParamFormat.fourcc = V4L2PixelFormat(V4L2_META_FMT_RKISP2_PARAMS);
+	ret = isppParam_->setFormat(&isppParamFormat);
+	if (ret)
+		return ret;
+
+	return configureIpa(data, cfg);
+}
