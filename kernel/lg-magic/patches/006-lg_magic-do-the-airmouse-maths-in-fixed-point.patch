From bff793e9741bfd6e91ddf3499725d2e842e2c74f Mon Sep 17 00:00:00 2001
From: Daniel Golle <daniel@makrotopia.org>
Date: Fri, 18 Sep 2026 08:49:41 +0100
Subject: [PATCH 2/6] lg_magic: do the airmouse maths in fixed point

The airmouse filter used C floats and the module was built with
CC_FLAGS_FPU. Kernel code may not use the FPU without wrapping the
region in kernel_fpu_begin(), so on x86 this silently clobbered
userspace floating-point state, and on architectures without those
compiler flags it did not build at all.

Decode the IEEE-754 calibration blob by hand and run the bias, scale
and low-pass stages in Q16.16 with s64 intermediates. The blob format
is unchanged, so existing calibration files still load; a value that is
not finite converts to S64_MAX, which lgmagic_validate_calib() already
rejects. Over 200k random samples the pointer deltas differ from the
float version by at most one count and the threshold decisions are
identical.

Signed-off-by: Daniel Golle <daniel@makrotopia.org>
---
 kernel/Makefile            |  2 -
 kernel/lg_magic_airmouse.c | 91 ++++++++++++++++++++++++++++++++------
 kernel/lg_magic_airmouse.h | 16 ++++---
 kernel/lg_magic_main.c     |  6 +--
 4 files changed, 91 insertions(+), 24 deletions(-)

--- a/kernel/Makefile
+++ b/kernel/Makefile
@@ -6,8 +6,6 @@ KDIR ?= /lib/modules/$(KVER)/build
 KVER ?= $(shell uname -r)
 PWD  := $(shell pwd)
 
-CFLAGS_lg_magic_airmouse.o += $(CC_FLAGS_FPU)
-
 all:
 	$(MAKE) -C $(KDIR) M=$(PWD) modules
 
--- a/kernel/lg_magic_airmouse.c
+++ b/kernel/lg_magic_airmouse.c
@@ -15,49 +15,112 @@
     Foundation, Inc., 59 Temple Place, Suite 330, Boston, MA  02111-1307  USA
 */
 
+#include <linux/bits.h>
+#include <linux/limits.h>
 #include <linux/types.h>
 #include "lg_magic_airmouse.h"
 
-static inline float lgmagic_fabs(float val)
+#define LGMAGIC_F32_MANT_BITS	23
+#define LGMAGIC_F32_EXP_BIAS	127
+
+static inline s64 lgmagic_fabs(s64 val)
 {
 	if (val<0)
 		return -val;
 	return val;
 }
 
+static inline s64 lgmagic_fpmul(s64 a, s64 b)
+{
+	return (a * b) >> LGMAGIC_FP_SHIFT;
+}
+
+static s64 lgmagic_f32_to_fp(u32 bits)
+{
+	int shift;
+	s64 mant;
+	int exp;
+
+	exp = (bits >> LGMAGIC_F32_MANT_BITS) & 0xFF;
+	mant = bits & GENMASK(LGMAGIC_F32_MANT_BITS - 1, 0);
+
+	if (!exp)
+		return 0;
+
+	if (exp == 0xFF)
+		return S64_MAX;
+
+	mant |= BIT(LGMAGIC_F32_MANT_BITS);
+	shift = exp - LGMAGIC_F32_EXP_BIAS - LGMAGIC_F32_MANT_BITS +
+		LGMAGIC_FP_SHIFT;
+
+	if (shift > 24)
+		return S64_MAX;
+
+	if (shift >= 0)
+		mant <<= shift;
+	else if (-shift < 62)
+		mant >>= -shift;
+	else
+		mant = 0;
+
+	return (bits & BIT(31)) ? -mant : mant;
+}
+
+void lgmagic_convert_calib(struct lg_magic_airmouse_calib *calib, const u8 *blob)
+{
+	size_t i;
+	u32 bits;
+
+	for (i = 0; i < LGMAGIC_CALIB_SIZE / sizeof(bits); i++)
+	{
+		bits = blob[4 * i] | (blob[4 * i + 1] << 8) |
+		       (blob[4 * i + 2] << 16) | ((u32)blob[4 * i + 3] << 24);
+
+		if (i < 3)
+			calib->gyro_bias[i] = lgmagic_f32_to_fp(bits);
+		else if (i < 6)
+			calib->gyro_scale[i - 3] = lgmagic_f32_to_fp(bits);
+		else if (i == 6)
+			calib->alpha = lgmagic_f32_to_fp(bits);
+		else
+			calib->mouse_k = lgmagic_f32_to_fp(bits);
+	}
+}
+
 int lgmagic_validate_calib(struct lg_magic_airmouse_calib *calib)
 {
 	for (size_t i = 0; i < 3; i++)
 	{
-		if (lgmagic_fabs(calib->gyro_bias[i])>100.0 || lgmagic_fabs(calib->gyro_scale[i])>10.0)
+		if (lgmagic_fabs(calib->gyro_bias[i])>100*LGMAGIC_FP_ONE || lgmagic_fabs(calib->gyro_scale[i])>10*LGMAGIC_FP_ONE)
 			return 1;
 	}
-	if (calib->alpha<0.0 || calib->alpha>1.0)
+	if (calib->alpha<0 || calib->alpha>LGMAGIC_FP_ONE)
 			return 1;
 
-	if (calib->mouse_k<0.0 || calib->mouse_k>1.0)
+	if (calib->mouse_k<0 || calib->mouse_k>LGMAGIC_FP_ONE)
 		return 1;
 
 	return 0;
 }
 
-static inline void lgmagic_lpf(float *acc, float alpha, float value)
+int lgmagic_calc_mouse(struct lg_magic_airmouse_calib *calib, s64 *gyro_acc, u16 threshold, s16 *gyro, s16 *mouse)
 {
-	*acc = alpha * value + (1.0 - alpha) * (*acc);
-}
+	s64 limit = (s64)threshold << LGMAGIC_FP_SHIFT;
 
-int lgmagic_calc_mouse(struct lg_magic_airmouse_calib *calib, float *gyro_acc, u16 threshold, s16 *gyro, s16 *mouse)
-{
 	for (size_t i = 0; i < 3; i++)
 	{
-		float gyro_corr = ((float)gyro[i] - calib->gyro_bias[i]) * calib->gyro_scale[i];
-		gyro_acc[i] = calib->alpha * gyro_corr + (1.0 - calib->alpha) * gyro_acc[i];
+		s64 gyro_corr = ((s64)gyro[i] << LGMAGIC_FP_SHIFT) - calib->gyro_bias[i];
+
+		gyro_corr = lgmagic_fpmul(gyro_corr, calib->gyro_scale[i]);
+		gyro_acc[i] = lgmagic_fpmul(calib->alpha, gyro_corr) +
+			      lgmagic_fpmul(LGMAGIC_FP_ONE - calib->alpha, gyro_acc[i]);
 	}
 
-	mouse[0] = gyro_acc[2] * calib->mouse_k;
-	mouse[1] = gyro_acc[0] * calib->mouse_k;
+	mouse[0] = lgmagic_fpmul(gyro_acc[2], calib->mouse_k) >> LGMAGIC_FP_SHIFT;
+	mouse[1] = lgmagic_fpmul(gyro_acc[0], calib->mouse_k) >> LGMAGIC_FP_SHIFT;
 
-	if (lgmagic_fabs(gyro_acc[0])>threshold || lgmagic_fabs(gyro_acc[2])>threshold)
+	if (lgmagic_fabs(gyro_acc[0])>limit || lgmagic_fabs(gyro_acc[2])>limit)
 		return 1;
 	return 0;
 }
--- a/kernel/lg_magic_airmouse.h
+++ b/kernel/lg_magic_airmouse.h
@@ -1,15 +1,21 @@
 #ifndef LG_MAGIC_AIRMOUSE_H
 #define LG_MAGIC_AIRMOUSE_H
 
+#define LGMAGIC_FP_SHIFT	16
+#define LGMAGIC_FP_ONE		(1LL << LGMAGIC_FP_SHIFT)
+
+#define LGMAGIC_CALIB_SIZE	32
+
 struct lg_magic_airmouse_calib
 {
-	float gyro_bias[3];
-	float gyro_scale[3];
-	float alpha;
-	float mouse_k;
+	s64 gyro_bias[3];
+	s64 gyro_scale[3];
+	s64 alpha;
+	s64 mouse_k;
 };
 
-int lgmagic_calc_mouse(struct lg_magic_airmouse_calib *calib, float *gyro_acc, u16 threshold, s16 *gyro, s16 *mouse);
+void lgmagic_convert_calib(struct lg_magic_airmouse_calib *calib, const u8 *blob);
+int lgmagic_calc_mouse(struct lg_magic_airmouse_calib *calib, s64 *gyro_acc, u16 threshold, s16 *gyro, s16 *mouse);
 int lgmagic_validate_calib(struct lg_magic_airmouse_calib *calib);
 
 #endif
--- a/kernel/lg_magic_main.c
+++ b/kernel/lg_magic_main.c
@@ -55,7 +55,7 @@ struct lgmagic_drvdata {
 
 	u16 last_keycode;
 	u16 last_btncode;
-	float gyro_acc[3];
+	s64 gyro_acc[3];
 	int mode;
 	struct lg_magic_airmouse_calib calib;
 };
@@ -230,9 +230,9 @@ static int lgmagic_load_fw(const char *f
 	const struct firmware *fw;
 
 	ret = request_firmware(&fw, fwname, dev);
-	if (ret == 0 && fw->size>=sizeof(struct lg_magic_airmouse_calib)) {
+	if (ret == 0 && fw->size>=LGMAGIC_CALIB_SIZE) {
 		lgmagic_dev_info(dev, "Loading LG Magic calibration");
-		memcpy(&drvdata->calib, fw->data, sizeof(struct lg_magic_airmouse_calib));
+		lgmagic_convert_calib(&drvdata->calib, fw->data);
 		release_firmware(fw);
 		if (lgmagic_validate_calib(&drvdata->calib))
 		{
