+
+Event = namedtuple("Event", ["type", "code", "value"])
+
+class InputDevice:
+    """The part of an evdev device this script needs, without the module."""
+    FORMAT = "llHHi"
+
+    def __init__(self, path, name):
+        self.path = path
+        self.name = name
+
+    def read_loop(self):
+        size = struct.calcsize(self.FORMAT)
+        with open(self.path, "rb", buffering=0) as handle:
+            while True:
+                data = handle.read(size)
+                if len(data) < size:
+                    return
+                _, _, etype, code, value = struct.unpack(self.FORMAT, data)
+                yield Event(etype, code, value)
+
