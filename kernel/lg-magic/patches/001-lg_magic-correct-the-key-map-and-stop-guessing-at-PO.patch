-sudo modprobe lg_magic airmouse=1 airmouse_threshold=300 imu_evdev=1 debug=2
+sudo modprobe lg_magic airmouse=1 airmouse_threshold=300 imu_evdev=1 \
+              power_key=0 debug=2
 
