[ -x /etc/init.d/lg-magic-voice ] || exit 0
/etc/init.d/lg-magic-voice enabled || exit 0

case "$ACTION" in
add)
	# the bridge needs the remote's event node, which appears after hidraw
	case "$DEVNAME" in
	input/event*) ;;
	*) exit 0 ;;
	esac

	/etc/init.d/lg-magic-voice device >/dev/null || exit 0
	/etc/init.d/lg-magic-voice running || /etc/init.d/lg-magic-voice start
	;;
remove)
	/etc/init.d/lg-magic-voice device >/dev/null || \
		/etc/init.d/lg-magic-voice stop
	;;
esac
