#!/bin/sh /etc/rc.common

USE_PROCD=1
START=65
STOP=15

RUNDIR="/var/run/pipewire"
HID_ID="0005:0000000F:00003412"

EXTRA_COMMANDS="device"
EXTRA_HELP="	device	Print the remote's hidraw node, if it is present"

find_remote() {
	local uevent node

	for uevent in /sys/class/hidraw/hidraw*/device/uevent; do
		[ -e "$uevent" ] || continue
		grep -qs "^HID_ID=$HID_ID\$" "$uevent" || continue

		node="${uevent%/device/uevent}"
		echo "/dev/${node##*/}"

		return 0
	done

	return 1
}

device() {
	find_remote
}

start_service() {
	local enabled device mode tail verbose waited

	config_load lg-magic
	config_get_bool enabled voice enabled 1
	config_get device voice device
	config_get mode voice mode button
	config_get tail voice tail 1500
	config_get_bool verbose voice verbose 0

	[ "$enabled" = 1 ] || return 0

	[ -n "$device" ] || device="$(find_remote)" || {
		logger -t lg-magic-voice "no LG Magic Remote paired, waiting for hotplug"
		return 0
	}

	# pipewire starts just before this service and spawns asynchronously, so
	# its socket is usually not there yet on boot.
	waited=0
	while [ ! -S "$RUNDIR/pipewire-0" ] && [ "$waited" -lt 15 ]; do
		sleep 1
		waited=$((waited + 1))
	done

	procd_open_instance
	procd_set_param command /usr/bin/lg-magic-voice \
		-d "$device" -m "$mode" -t "$tail"
	[ "$verbose" = 1 ] && procd_append_param command -v
	procd_set_param env \
		XDG_RUNTIME_DIR="$RUNDIR" \
		PIPEWIRE_RUNTIME_DIR="$RUNDIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger lg-magic
}
