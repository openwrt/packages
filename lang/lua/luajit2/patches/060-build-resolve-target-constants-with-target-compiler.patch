+# The constants in the DynASM output which depend on the data layout of the
+# target are resolved with the target compiler: buildvm.c is compiled for
+# the target with a variant of the backend which emits them into the
+# assembler output (never assembled or run), then substituted by their
+# values. The host tools therefore need not match the pointer size of the
+# target. Optimization is disabled, so every probe appears exactly once.
+host/buildvm_probe.h: host/buildvm_arch_dasm.h host/genoffsets.lua $(MINILUA_DEP)
+	$(E) "OFFSETS   $@"
+	$(Q)$(HOST_LUA) host/genoffsets.lua probe host/buildvm_arch_dasm.h $@
+
+host/buildvm_probe.s: host/buildvm_probe.h $(DASM_DIR)/dasm_*.h
+	$(E) "CC        $@"
+	$(Q)$(TARGET_CC) $(TARGET_ACFLAGS) $(TARGET_ARCH) -I. -O0 -fno-lto -DLJ_BUILDVM_PROBE -S -o $@ host/buildvm.c
+
+host/buildvm_arch.h: host/buildvm_arch_dasm.h host/buildvm_probe.s host/genoffsets.lua $(MINILUA_DEP)
+	$(E) "OFFSETS   $@"
+	$(Q)$(HOST_LUA) host/genoffsets.lua apply host/buildvm_arch_dasm.h host/buildvm_probe.s $@
+
 host/buildvm.o: $(DASM_DIR)/dasm_*.h
 
 $(BUILDVM_T): $(BUILDVM_O)
