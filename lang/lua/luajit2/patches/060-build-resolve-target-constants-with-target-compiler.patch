--- /dev/null
+++ b/src/host/genoffsets.lua
@@ -0,0 +1,237 @@
+----------------------------------------------------------------------------
+-- LuaJIT VM builder: resolve target constants in the DynASM output.
+--
+-- Copyright (C) 2026 Mirko Vogt. See Copyright Notice in luajit.h
+----------------------------------------------------------------------------
+-- The DynASM-generated backend of buildvm passes many constant expressions
+-- to dasm_put(): offsets and sizes of the LuaJIT core data structures, and
+-- constants derived from them. Evaluating them with the host compiler is
+-- only correct if the host matches the pointer size and alignment rules of
+-- the target. This script resolves them with the target compiler instead,
+-- which removes the requirement that the host tools are built for the
+-- pointer size of the target.
+--
+--   probe: Rewrite every dasm_put() call in the DynASM output into asm
+--     statements which make the compiler emit the value of each constant
+--     argument. buildvm.c is compiled with the target compiler (-S only,
+--     the result is never run) with LJ_BUILDVM_PROBE defined, which selects
+--     this variant of the backend.
+--
+--   apply: Substitute the values from the probe assembler output into the
+--     DynASM output. Arguments which are not constant (they depend on the
+--     bytecode opcode etc.) and arguments in unreachable code (the compiler
+--     dropped the probe) are left unchanged. All constructs which depend on
+--     the target data layout are then redefined to reference an undefined
+--     function, so a remaining reachable use fails when linking buildvm
+--     instead of being evaluated by the host compiler.
+--
+-- Usage:
+--   minilua genoffsets.lua probe <dynasm output> <probe header>
+--   minilua genoffsets.lua apply <dynasm output> <probe assembler> <output>
+----------------------------------------------------------------------------
+
+local MARKER = "->lj_buildvm_const"
+local UNRESOLVED = "lj_buildvm_unresolved_target_constant()"
+
+local function die(fmt, ...)
+  io.stderr:write("genoffsets.lua: ", string.format(fmt, ...), "\n")
+  os.exit(1)
+end
+
+local function readlines(name)
+  local fp = io.open(name, "r") or die("cannot open %s", name)
+  local lines = {}
+  for line in fp:lines() do lines[#lines+1] = line end
+  fp:close()
+  return lines
+end
+
+local function writelines(name, lines)
+  local fp = io.open(name, "w") or die("cannot create %s", name)
+  fp:write(table.concat(lines, "\n"), "\n")
+  fp:close()
+end
+
+-- Split the argument list of a dasm_put() call at the top-level commas.
+local function splitargs(s)
+  local args, depth, start = {}, 0, 1
+  for i=1,#s do
+    local c = s:sub(i, i)
+    if c == "(" or c == "[" then
+      depth = depth + 1
+    elseif c == ")" or c == "]" then
+      depth = depth - 1
+    elseif c == "," and depth == 0 then
+      args[#args+1] = s:sub(start, i-1)
+      start = i + 1
+    end
+  end
+  args[#args+1] = s:sub(start)
+  for i=1,#args do args[i] = args[i]:match("^%s*(.-)%s*$") end
+  return args
+end
+
+local function isliteral(arg)
+  return arg:match("^%-?%d+$") or arg:match("^0[xX]%x+$")
+end
+
+-- Check for constructs which depend on the data layout of the target,
+-- including the macros in the LuaJIT headers which are defined with them.
+local function islayout(arg)
+  for _, pat in ipairs{ "Dt%x+%(", "sizeof", "offsetof", "DISPATCH_",
+			"PC2PROTO", "GL_J", "GG_", "TV2MARKOFS",
+			"HOTCOUNT_PCMASK", "SCALE_NUM_GCO", "size%a" } do
+    if arg:find(pat) then return true end
+  end
+  return false
+end
+
+-- Call func for every dasm_put() line. Every argument gets an id, counted
+-- in file order, so both passes refer to the same argument by the same id.
+local function foreach_dasm_put(lines, func)
+  local id = 0
+  for n, line in ipairs(lines) do
+    local indent, start, rest =
+      line:match("^(%s*)dasm_put%(Dst, (%d+)(.-)%);%s*$")
+    if indent then
+      local args = {}
+      if rest ~= "" then
+        rest = rest:match("^,%s*(.*)$") or
+               die("line %d: unexpected dasm_put() call", n)
+        args = splitargs(rest)
+      end
+      local ids = {}
+      for i=1,#args do
+        id = id + 1
+        ids[i] = id
+      end
+      func(n, indent, start, args, ids)
+    elseif line:find("dasm_put%(") and not line:match("^%s*//") then
+      die("line %d: unexpected dasm_put() call", n)
+    end
+  end
+end
+
+local function probe(dasm, out)
+  local lines = readlines(dasm)
+  foreach_dasm_put(lines, function(n, indent, start, args, ids)
+    local stmts = {}
+    for i, arg in ipairs(args) do
+      if not isliteral(arg) then
+        -- dasm_put() reads every argument as an int. Cast pointer-typed
+        -- arguments via ptrdiff_t to avoid a warning.
+        local e = "(int)(ptrdiff_t)("..arg..")"
+        local c = "__builtin_constant_p("..e..")"
+        stmts[#stmts+1] = string.format(
+          '__asm__ __volatile__("\\n%s %d %%0 %%1" : : "i"(%s), "i"(%s ? %s : 0));',
+          MARKER, ids[i], c, c, e)
+      end
+    end
+    if #stmts > 0 then
+      lines[n] = indent.."{ "..table.concat(stmts, " ").." }"
+    end
+  end)
+  writelines(out, lines)
+end
+
+local function apply(dasm, probe_s, out)
+  -- Collect the constants. The compiler prints immediates with the
+  -- punctuation of the target assembler ($ or #), which is skipped.
+  local values, nonconst = {}, {}
+  for line in io.lines(probe_s) do
+    local id, const, value =
+      line:match("^%->lj_buildvm_const (%d+)%s+[%$#]?(%d+)%s+[%$#]?(%-?%d+)")
+    if id then
+      id = tonumber(id)
+      if const == "1" then
+        value = tonumber(value)
+        if values[id] ~= nil and values[id] ~= value then
+          die("conflicting values %d and %d for constant %d",
+              values[id], value, id)
+        end
+        values[id] = value
+      else
+        nonconst[id] = true
+      end
+    end
+  end
+  if next(values) == nil then die("no constants found in %s", probe_s) end
+
+  local lines = readlines(dasm)
+  foreach_dasm_put(lines, function(n, indent, start, args, ids)
+    local changed = false
+    for i, arg in ipairs(args) do
+      local v = values[ids[i]]
+      if nonconst[ids[i]] and islayout(arg) then
+        -- A non-constant argument is evaluated at run time by buildvm.
+        -- It must not depend on the data layout of the target.
+        die("line %d: argument %s is not constant", n, arg)
+      end
+      if v and not nonconst[ids[i]] and not isliteral(arg) then
+        if v == -2147483648 then
+          args[i] = "(-2147483647-1)"
+        else
+          args[i] = string.format("%d", v)
+        end
+        changed = true
+      end
+    end
+    if changed then
+      lines[n] = indent.."dasm_put(Dst, "..start..
+                 (#args > 0 and ", "..table.concat(args, ", ") or "")..");"
+    end
+  end)
+
+  -- Redefine the DynASM type macros. They expand to the offset of a
+  -- struct member as seen by the compiler of buildvm.
+  local ntype, nredef = 0, 0
+  for n, line in ipairs(lines) do
+    if line:match("^#define Dt%x+%(") then
+      ntype = ntype + 1
+      local name, ctype = line:match(
+        "^#define (Dt%x+%(_V%)) %(int%)%(ptrdiff_t%)&%(%(%((.-) %*%)0%)_V%)$")
+      if name then
+        lines[n] = "#define "..name.."\t"..UNRESOLVED.."\t/* "..ctype.." */"
+        nredef = nredef + 1
+      end
+    end
+  end
+  if nredef ~= ntype then die("unrecognized DynASM type macro definition") end
+
+  -- Insert the redefinition of offsetof() after the header comment, before
+  -- the first line directive, and undo it at the end. sizeof() cannot be
+  -- redefined, since the C code in the *.dasc files uses it legitimately.
+  local pos = 1
+  for n, line in ipairs(lines) do
+    if line:match("^#line") then pos = n break end
+  end
+  local prologue = {
+    "/*",
+    "** All constants which depend on the data layout of the target have been",
+    "** resolved with the target compiler and substituted by their values",
+    "** (see host/genoffsets.lua). offsetof() and the DynASM type macros must",
+    "** not be evaluated by the host compiler anymore. A remaining reachable",
+    "** use fails when linking buildvm, since the referenced function is not",
+    "** defined.",
+    "*/",
+    "extern int lj_buildvm_unresolved_target_constant(void);",
+    "#undef offsetof",
+    "#define offsetof(type, member)\t"..UNRESOLVED,
+    "",
+  }
+  for i=#prologue,1,-1 do table.insert(lines, pos, prologue[i]) end
+  lines[#lines+1] = ""
+  lines[#lines+1] = "#undef offsetof"
+  writelines(out, lines)
+end
+
+local mode, in1, in2, out = ...
+if mode == "probe" and in1 and in2 then
+  probe(in1, in2)
+elseif mode == "apply" and in1 and in2 and out then
+  apply(in1, in2, out)
+else
+  io.stderr:write("Usage: genoffsets.lua probe <dynasm output> <probe header>\n",
+                  "       genoffsets.lua apply <dynasm output> <probe assembler> <output>\n")
+  os.exit(1)
+end
--- a/src/lj_arch.h
+++ b/src/lj_arch.h
@@ -332,15 +332,21 @@
 #endif
 #endif
 
+#ifndef LJ_ARCH_BITS
 #if _LP64
 #define LJ_ARCH_BITS		64
+#else
+#define LJ_ARCH_BITS		32
+#endif
+#endif
+
+#if LJ_ARCH_BITS == 64
 #if LJ_ARCH_ENDIAN == LUAJIT_LE
