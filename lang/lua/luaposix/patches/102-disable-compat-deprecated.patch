Subject: [PATCH] disable deprecated and compat injections

---
 lib/posix/init.lua | 8 --------
 1 file changed, 8 deletions(-)

--- a/lib/posix/init.lua
+++ b/lib/posix/init.lua
@@ -435,14 +435,6 @@ do
       end
    end
 
