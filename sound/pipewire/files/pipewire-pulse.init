#!/bin/sh /etc/rc.common
USE_PROCD=1
START=61
STOP=19

RUNDIR="/var/run/pipewire"
PW_USER="pipewire"

start_service() {
	# RUNDIR is set up by the pipewire service (see pipewire.init); only the
	# pulse/ subdirectory is handled here. pipewire-pulse creates it with mode
	# 0700 when it is missing, but uses an existing one as it is, so create it
	# with group audio and mode 0750 to let the members of group audio reach
	# pulse/native.
	mkdir -p "${RUNDIR}/pulse"
	chown "${PW_USER}:audio" "${RUNDIR}/pulse"
	chmod 0750 "${RUNDIR}/pulse"

	# umask 007 as in pipewire.init; pipewire-pulse creates the pulse socket
	# itself with mode 0777.
	procd_open_instance
	procd_set_param command /bin/sh -c 'umask 007; exec /usr/bin/pipewire-pulse'
	procd_set_param respawn 3600 5 5
	procd_set_param user "${PW_USER}"
	# primary group audio, as in pipewire.init
	procd_set_param group audio
	procd_set_param env \
		XDG_RUNTIME_DIR="${RUNDIR}" \
		PIPEWIRE_RUNTIME_DIR="${RUNDIR}" \
		HOME="${RUNDIR}" \
		PW_LOG=2
	# realtime limits as in pipewire.init; all limits in one call
	procd_set_param limits nofile="8192 8192" rtprio="95 95" nice="40 40"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
