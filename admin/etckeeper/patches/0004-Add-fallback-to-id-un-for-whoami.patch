From b8321819084f79e4fdebf0ea375c5f2b89f510bb Mon Sep 17 00:00:00 2001
From: Rimas Kudelis <rimas@kudelis.lt>
Date: Fri, 6 Nov 2026 14:08:20 +0200
Subject: Add fallback to `id -un` for `whoami`

---
 commit.d/50vcs-commit | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

--- a/commit.d/50vcs-commit
+++ b/commit.d/50vcs-commit
@@ -54,7 +54,7 @@ if [ "$VCS" = git ] && [ -d .git ]; then
 	# has several edge cases where it fails and would prevent the
 	# commit.
 	if [ -z "$USER" ]; then
-		USER="$(whoami)"
+		USER="$(whoami 2>/dev/null || id -un)"
 	fi
 	if [ -n "$USER" ]; then
 		# Use user.name and user.email from the gitconfig belonging
@@ -96,7 +96,7 @@ if [ "$VCS" = git ] && [ -d .git ]; then
 			export GIT_AUTHOR_EMAIL
 		fi
 		if [ -z "$GIT_COMMITTER_EMAIL" ]; then
-			GIT_COMMITTER_EMAIL=`whoami`"@$hostname"
+			GIT_COMMITTER_EMAIL="$USER@$hostname"
 			export GIT_COMMITTER_EMAIL
 		fi
 	fi
