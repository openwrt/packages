#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	local ENABLED=0

	[ -f /etc/default/atop ] && . /etc/default/atop
	[ "$ENABLED" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/libexec/atop-daily
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
