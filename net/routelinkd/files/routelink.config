config routelink 'main'
	option enabled '1'
	option data_dir '/etc/routelink'
	# 0 = automatic: 60 min on flash (jffs2/ubifs), 10 min otherwise
	option commit_interval '0'
	option max_size_mb '32'
	option max_size_percent '10'
	option sample_interval '30'
	option live_interval '2'
	option traffic '1'
	# wireless stations and channel busy time where this router is an access point
	option wifi '1'

config retention 'retention'
	option minute_hours '48'
	option hour_days '90'
	option day_days '730'
	option event_days '90'
	option signal_minute_days '7'
	option signal_hour_days '30'
	option latency_minute_days '7'
	option latency_hour_days '90'
	option outage_days '365'

# Latency probes and the outage log (gateway): an ICMP echo to every target each 10 s.
# Targets are IP addresses (at most 8); an outage is when none of them answers 3 rounds in a row.
config probe 'probe'
	option enabled '1'
	# the WAN's next hop (from netifd's default route) too
	option gateway '1'
	list target '223.5.5.5'
	list target '119.29.29.29'
	list target '1.1.1.1'

# Router-side speed test: empty server = Cloudflare, else the base URL of a LibreSpeed server
# (the folder with garbage.php and empty.php)
config speedtest 'speedtest'
	option server ''
	option streams '4'
	option duration '10'

# DNS logging (and with it where devices go): the answers LAN devices get, kept keep_days days and at
# most max_records records. Off by default: it records which sites every device looks up.
config dns 'dns'
	option enabled '0'
	option keep_days '7'
	option max_records '100000'

# Push messages: lang auto (LuCI's language; if that is auto too, Chinese in the time zones of mainland
# China, Hong Kong, Macau and Taiwan, else English), zh_cn or en
config notify_settings 'notify'
	option lang 'auto'

# One section per device, written by LuCI and the app (unnamed):
# config device
#	option mac 'AA:BB:CC:DD:EE:FF'
#	option trusted '1'
#	option watch '0'
#
# Speed limits in kbit/s (0 = not limited), on some weekdays and between two times (both optional):
# config limit
#	option mac 'AA:BB:CC:DD:EE:FF'
#	option enabled '1'
#	option download '8000'
#	option upload '2000'
#	list weekdays 'mon'
#	option start_time '20:00'
#	option stop_time '23:00'
#
# Data quotas: period day | week | month (reset_day 1-7 from Monday, or 1-28), direction total | download,
# action block (no internet) or limit (limit_download / limit_upload in kbit/s); a notice at 80 %:
# config quota
#	option mac 'AA:BB:CC:DD:EE:FF'
#	option enabled '1'
#	option period 'month'
#	option reset_day '1'
#	option limit_mb '102400'
#	option direction 'total'
#	option action 'block'
#
# Push channels: type webhook | bark | serverchan | pushplus | telegram | wecom | dingtalk | feishu,
# events device_new | device_watch | quota | outage:
# config notify
#	option type 'bark'
#	option enabled '1'
#	option name 'iPhone'
#	option url 'https://api.day.app'
#	option token '<device key>'
#	list events 'device_new'
#	list events 'quota'
