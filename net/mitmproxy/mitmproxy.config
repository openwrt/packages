config mitmproxy 'main'
	option enabled '0'
	# 'dump' runs mitmdump, 'web' runs mitmweb
	option ui 'dump'
	# empty listens on all interfaces
	option listen_host ''
	option listen_port '8080'
	# web UI only; reach it through an SSH tunnel or change web_host
	option web_host '127.0.0.1'
	option web_port '8081'
	# CA key and certificate are generated here on first start
	option confdir '/etc/mitmproxy'
	option ssl_insecure '0'
	# mitmdump only: 0 (silent) .. 4 (full)
	option flow_detail '1'
	# list mode 'transparent'
	# list script '/etc/mitmproxy/addon.py'
	# list set 'block_global=false'
