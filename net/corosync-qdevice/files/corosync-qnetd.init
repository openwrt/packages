#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/corosync-qnetd
CERTUTIL=/usr/sbin/corosync-qnetd-certutil
RUN_USER=coroqnetd
CONFIG_DIR=/etc/corosync/qnetd
RUNTIME_DIR=/var/run/corosync-qnetd

validate_qnetd_section() {
	uci_load_validate corosync-qnetd qnetd "$1" "$2" \
		'enabled:bool:0' \
		'address_family:or("any","ipv4","ipv6"):any' \
		'listen_address:or(ip4addr,ip6addr)' \
		'port:port:5403' \
		'tls:or("on","off","req","required"):req' \
		'client_cert_required:or("on","off"):on' \
		'auto_initialize:bool:0' \
		'max_clients:uinteger:0' \
		'debug:range(0,2):0'
}

qnetd_instance() {
	[ "$2" = 0 ] || {
		echo "validation failed"
		return 1
	}
	[ "$enabled" = 1 ] || return 0

	mkdir -p "$CONFIG_DIR" "$RUNTIME_DIR"
	chown root:root "$CONFIG_DIR"
	chmod 0755 "$CONFIG_DIR"
	chown "$RUN_USER:$RUN_USER" "$RUNTIME_DIR"

	if [ "$tls" != off ] && [ ! -e "$CONFIG_DIR/nssdb/cert9.db" ]; then
		if [ "$auto_initialize" = 1 ]; then
			"$CERTUTIL" -i || return 1
		else
			echo "TLS is enabled but the qnetd NSS database is not initialized"
			return 1
		fi
	fi

	[ ! -d "$CONFIG_DIR/nssdb" ] || chown -R "$RUN_USER:$RUN_USER" "$CONFIG_DIR/nssdb"

	procd_open_instance
	procd_set_param command "$PROG" -f
	case "$address_family" in
		ipv4) procd_append_param command -4 ;;
		ipv6) procd_append_param command -6 ;;
	esac
	[ -n "$listen_address" ] && procd_append_param command -l "$listen_address"
	procd_append_param command -p "$port"
	[ "$tls" != required ] || tls=req
	procd_append_param command -s "$tls"
	procd_append_param command -c "$client_cert_required"
	procd_append_param command -m "$max_clients"
	[ "$debug" -ge 1 ] && procd_append_param command -d
	[ "$debug" -ge 2 ] && procd_append_param command -d
	procd_set_param user "$RUN_USER"
	procd_set_param group "$RUN_USER"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	config_load corosync-qnetd
	config_foreach validate_qnetd_section qnetd qnetd_instance
}

service_triggers() {
	procd_add_reload_trigger corosync-qnetd
	procd_add_validation validate_qnetd_section
}
