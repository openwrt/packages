#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
USE_PROCD=1
START=99

prog_name="antiblock"
bin="/usr/bin/$prog_name"
tmp_folder="/tmp/$prog_name"
blacklist_file="$tmp_folder/blacklist"

routes_parse() {
	local _config="$1"
	local _enabled _interface _domains_path

	_enabled=""
	config_get_bool _enabled "${_config}" "enabled" "1"
	if [ "${_enabled}" -eq "1" ]; then
		_interface=""
		_domains_path=""

		# AntiBlock 3.x calls the first -r field an interface. Keep the old
		# 'gateway' UCI option as a fallback so existing configs still work.
		config_get _interface "${_config}" interface
		[ -z "${_interface}" ] && config_get _interface "${_config}" gateway
		config_get _domains_path "${_config}" domains_path

		[ -n "${_interface}" ] || return 0
		[ -n "${_domains_path}" ] || return 0

		# Count usable rules before opening a procd instance.
		if [ "${_routes_check_only:-0}" -eq "1" ]; then
			_valid_routes=$((_valid_routes + 1))
			return 0
		fi

		procd_append_param command -r "${_interface} ${_domains_path}"
	fi
}

blacklist_parse() {
	[ "${_blacklist_count}" -eq "0" ] && true >"$blacklist_file"
	_blacklist_count=$((_blacklist_count + 1))
	echo "$1" >>"$blacklist_file"
}

start_service() {
	local _enabled _valid_routes _routes_check_only
	local _log _stat _test _listen _blacklist_count

	config_load "$prog_name"

	_enabled=""
	config_get_bool _enabled "config" "enabled" "0"
	[ "${_enabled}" -eq "0" ] && return 0

	_valid_routes=0
	_routes_check_only=1
	config_foreach routes_parse route
	_routes_check_only=0
	if [ "${_valid_routes}" -eq "0" ]; then
		logger -t "$prog_name" -p daemon.err \
			"No enabled route with both interface (or gateway) and domains_path"
		return 1
	fi

	logger -t "$prog_name" -p daemon.info "AntiBlock start requested"

	_log=""
	_stat=""
	_test=""
	_listen=""

	config_get_bool _log "config" "log" "0"
	config_get_bool _stat "config" "stat" "0"
	config_get_bool _test "config" "test" "0"
	config_get _listen "config" "listen"

	if [ -z "${_listen}" ]; then
		_listen="$(uci -q get network.lan.ipaddr | cut -d/ -f1)"
		if [ -z "${_listen}" ]; then
			logger -t "$prog_name" -p daemon.err \
				"Cannot determine DNS address; set option listen"
			return 1
		fi
		_listen="${_listen}:53"
	fi

	mkdir -p "$tmp_folder"

	_blacklist_count=0
	config_list_foreach "config" blacklist blacklist_parse

	procd_open_instance "$prog_name"

	procd_set_param command "$bin"
	procd_set_param file /etc/config/antiblock
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1

	config_foreach routes_parse route

	procd_append_param command -l "${_listen}"
	procd_append_param command -o "$tmp_folder"
	[ "${_blacklist_count}" -ne "0" ] && procd_append_param command -b "$blacklist_file"
	[ "${_log}" -ne "0" ] && procd_append_param command --log
	[ "${_stat}" -ne "0" ] && procd_append_param command --stat
	[ "${_test}" -ne "0" ] && procd_append_param command --test

	procd_close_instance

	if [ -x /etc/init.d/dnsmasq ] && /etc/init.d/dnsmasq running >/dev/null 2>&1; then
		/etc/init.d/dnsmasq restart >/dev/null 2>&1
	fi
}

service_triggers() {
	procd_add_reload_trigger "$prog_name"
}
