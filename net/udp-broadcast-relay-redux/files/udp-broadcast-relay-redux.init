#!/bin/sh /etc/rc.common

START=90
STOP=10

USE_PROCD=1
PROG=/usr/sbin/udp-broadcast-relay-redux
NAME=udp-broadcast-relay-redux
PIDCOUNT=0

validate_section_udp_broadcast_relay_redux()
{
	uci_validate_section udp_broadcast_relay_redux udp_broadcast_relay_redux "${1}" \
		'id:uinteger' \
		'port:port' \
		'network:list(string)' \
		'src_override:ip4addr' \
		'dest_override:list(string)' \
		'multicast:ip4addr'

	[ -z "$id" ] && return 1

	[ -z "$network" ] && return 1

	[ -z "$port" ] && return 1

	return 0
}

udp_broadcast_relay_redux_instance() {
	local net network ifname ifnames id port src_override dest_override dest dest_net dest_iface dest_ip multicast

	validate_section_udp_broadcast_relay_redux "${1}" || {
		echo "Validation failed"
		return 1
	}

	PIDCOUNT="$((PIDCOUNT + 1))"

	procd_open_instance
	procd_set_param command "$PROG" "--id" "${id}" "--port" "${port}"
	procd_set_param stdout 1
	procd_set_param stderr 1

	# Since udp-broadcast-relay-redux has no signal handler and jail forces PID 1
	# (which will swallow signal), force SIGKILL after 1 second.
	procd_set_param term_timeout 1

	for net in $network; do
		network_get_device ifname "$net"
		if [ -z "$ifname" ]; then
			network_get_physdev ifname "$net"
		fi
		if [ -n "$ifname" ]; then
			procd_append_param command "--dev" "$ifname"
			procd_append_param netdev "$ifname"
			ifnames="$ifnames $ifname"
		fi
	done

	if [ -n "$src_override" ] ; then
		procd_append_param command "-s" "$src_override"
	fi

	for dest in $dest_override; do
		# Strip an optional "iface:" prefix before validating the address.
		dest_ip="${dest#*:}"
		if ! /sbin/validate_data ip4addr "$dest_ip" >/dev/null 2>&1; then
			echo "Invalid dest_override target: $dest"
			return 1
		fi

		if [ "$dest_ip" != "$dest" ]; then
			# The prefix is a UCI network name, same as the "network" list above;
			# resolve it to its literal device the same way, since the binary matches
			# qualified targets against literal --dev device names, not UCI network names.
			dest_net="${dest%%:*}"
			dest_iface=""
			network_get_device dest_iface "$dest_net"
			if [ -z "$dest_iface" ]; then
				network_get_physdev dest_iface "$dest_net"
			fi

			if [ -z "$dest_iface" ]; then
				echo "dest_override '$dest' references unknown network '$dest_net'"
				return 1
			fi

			case " $ifnames " in
				*" $dest_iface "*) ;;
				*)
					echo "dest_override '$dest' targets network '$dest_net' (device '$dest_iface'), which is not in this instance's own \"network\" list"
					return 1
					;;
			esac

			dest="$dest_iface:$dest_ip"
		fi

		procd_append_param command "-t" "$dest"
	done

	if [ -n "$multicast" ] ; then
		procd_append_param command "--multicast" "$multicast"
	fi

	procd_add_jail ubr-${PIDCOUNT} log
	procd_close_instance
}

start_service() {
	. /lib/functions.sh
	. /lib/functions/network.sh

	config_load udp_broadcast_relay_redux
	config_foreach udp_broadcast_relay_redux_instance udp_broadcast_relay_redux
}

service_triggers() {
	procd_add_reload_trigger "udp_broadcast_relay_redux"
	procd_add_validation validate_section_udp_broadcast_relay_redux
}
