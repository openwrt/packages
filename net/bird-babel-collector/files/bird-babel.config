
config collector 'collector'
	option enabled '1'
	# BIRD control socket, and the Babel protocol to show (empty: all of them)
	option socket '/var/run/bird.ctl'
	option protocol ''
	# Sampling interval in seconds; 0 picks one by RAM: 60 s below 96 MB,
	# 30 s below 192 MB, 15 s below 384 MB, else 4 s (BIRD's default Babel
	# hello interval; values only change with hellos)
	option interval '0'
	# Memory cap for the history in bytes; 0 uses 1/64 of RAM, between
	# 256 KiB and 16 MiB. History only shrinks below 24 h if it is reached.
	option memory_budget '0'
	# Keep history across reboots and sysupgrade by saving it to flash,
	# gzip compressed: only when the collector stops (reboot, shutdown,
	# restart) and before sysupgrade; "ubus call bird-babel save" saves now
	option persist '0'
	option persist_path '/etc/bird-babel/history.json.gz'

# Optional: the device and radio that serve a mesh network, e.g. a mesh AP
# bridging its 802.11s interface into a VLAN of this router. Shown in the
# graph; vendor and model are used when the device does not report them.
#config mesh
#	option network 'mesh_hof_s'
#	option host 'gub37-hof-s'
#	option band '5 GHz'
#	option ifname 'wlan5-mesh'
#	option vendor 'Cudy'
#	option model 'AP3000 Outdoor (v1)'
