#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/bird-babel-collector

start_service() {
	config_load bird-babel
	local enabled
	config_get_bool enabled collector enabled 1
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn 3600 5 0
	# the history is saved on stop, which can take a while on slow targets
	procd_set_param term_timeout 60
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger bird-babel
}
