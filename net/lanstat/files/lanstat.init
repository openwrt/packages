#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/sbin/lanstat

start_service() {
	local enabled iface dev bind port promisc track_ext max_hosts ring_kb

	. /lib/functions/network.sh
	config_load lanstat
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0

	config_get iface main interface "br-lan"
	network_get_device dev "$iface" || dev="$iface"
	[ -n "$dev" ] || dev="$iface"
	config_get bind main bind "0.0.0.0"
	config_get port main port "6670"
	config_get_bool promisc main promisc 1
	config_get_bool track_ext main track_external 0
	config_get max_hosts main max_hosts "512"
	config_get ring_kb main ring_kb "1024"

	procd_open_instance
	procd_set_param command "$PROG" -i "$dev" -b "$bind" -p "$port" -m "$max_hosts" -r "$ring_kb"
	[ "$promisc" -eq 0 ] && procd_append_param command -n
	[ "$track_ext" -eq 1 ] && procd_append_param command -e
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "lanstat"
}
