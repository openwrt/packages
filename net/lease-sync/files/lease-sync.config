config lease-sync 'config'
	option enabled '0'
	option node_id ''
	option sync_port '5378'
	option sync_interval '30'
	option peer_timeout '120'
	option log_level '2'
	# Peer to sync with, one list entry each:
	# address or address,source_address
	#list peer '172.20.0.11'
	# 'encrypted' (default) or 'plain'
	#option security_mode 'encrypted'
	# 64 hex chars, same on every peer; required in encrypted mode
	#option psk_key ''
	# Required in plain mode: run it only over a secure link
	# (WireGuard, IPsec)
	#option plain_mode_acknowledged '1'
