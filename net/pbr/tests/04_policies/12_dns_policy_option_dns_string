-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft = global.mocklib.read_captured('/var/run/pbr.nft') || '';

function rules_for(n) {
	return filter(split(nft, '\n'), l => index(l, 'comment "' + n + '"') >= 0);
}
function dnat_to(n, addr) {
	return length(filter(rules_for(n), l => index(l, addr) >= 0)) > 0;
}

let checks = [
	// 1. the string form, which used to be discarded whole
	['option_has_rules', length(rules_for('Option Form')) > 0],
	['option_v4',        dnat_to('Option Form', '10.9.0.1')],
	['option_v6',        dnat_to('Option Form', 'fd00::9')],

	// 2. the array form, unchanged -- guards against fixing one by breaking
	//    the other
	['list_has_rules',   length(rules_for('List Form')) > 0],
	['list_v4',          dnat_to('List Form', '10.9.0.1')],
	['list_v6',          dnat_to('List Form', 'fd00::9')],

	// 3. the two forms describe the same servers, so they must emit the same
	//    number of rules
	['forms_agree',      length(rules_for('Option Form')) ==
	                     length(rules_for('List Form'))],

	// 4. splitting must not leave an empty token behind that then fails to
	//    parse as an address
	['no_empty_dnat',    index(nft, 'dnat ip to  ') < 0 &&
	                     index(nft, 'dnat ip6 to  ') < 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("dns_policy_option_dns_string: %d/%d passed\n", pass, pass + fail);
-- End --

