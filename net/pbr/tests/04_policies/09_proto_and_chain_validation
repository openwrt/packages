-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft = global.mocklib.read_captured('/var/run/pbr.nft') || '';

// .info is a single string, "'name' (proto)" -- it must stay a string, because
// the procd emission writes it with json_add_string and an array would reach the
// WebUI as '[ "name", "proto" ]'.
function coded(list, code, who) {
	for (let m in (list || []))
		if (m.code == code && index('' + m.info, "'" + who + "'") == 0) return true;
	return false;
}
function rules_for(n) {
	return filter(split(nft, '\n'), l => index(l, 'comment "' + n + '"') >= 0);
}

let checks = [
	// 1. a port-capable protocol with no ports: warn, and keep routing
	['udp_noport_warns',   coded(result.warnings, 'warningPolicyProtoNoPort', 'Udp No Port')],
	['udp_noport_routed',  length(rules_for('Udp No Port')) > 0],
	// the protocol is named in .info so the message can point at the right one
	['warning_names_proto', length(filter(result.warnings || [], w =>
		w.code == 'warningPolicyProtoNoPort' &&
		'' + w.info == "'Udp No Port' (udp)")) == 1],
	['info_is_a_string', length(filter(result.warnings || [], w =>
		w.code == 'warningPolicyProtoNoPort' && type(w.info) != 'string')) == 0],

	// 2. a portless protocol with no ports: warn that it cannot work
	['icmp_noport_warns',  coded(result.warnings, 'warningPolicyProtoPortless', 'Icmp No Port')],

	// 3. a portless protocol WITH a port: reject the policy outright, because
	//    the rule it would emit takes the whole ruleset down
	['icmp_port_rejected', coded(result.errors, 'errorPolicyProtoPortNotSupported', 'Icmp With Port')],
	['icmp_port_no_rule',  length(rules_for('Icmp With Port')) == 0],
	['no_icmp_dport',      index(nft, 'icmp dport') < 0],

	// 4. the working combination stays silent and emits the match
	['udp_port_no_warning', !coded(result.warnings, 'warningPolicyProtoNoPort', 'Udp With Port')],
	['udp_port_matches',   length(filter(rules_for('Udp With Port'),
		l => index(l, 'udp dport') >= 0)) > 0],

	// 5. protocol names are matched case-insensitively, so an upper-case value
	//    written by hand into UCI is classified the same way. 'UDP' must be
	//    recognised as port-capable (warn, keep routing) and 'ICMP' as portless
	//    (warn that it cannot work) -- not fall through to the wrong branch.
	['mixed_case_port_capable', coded(result.warnings, 'warningPolicyProtoNoPort', 'Mixed Case Proto')],
	['mixed_case_portless',     coded(result.warnings, 'warningPolicyProtoPortless', 'Mixed Case Portless')],
	['mixed_case_not_swapped',  !coded(result.warnings, 'warningPolicyProtoPortless', 'Mixed Case Proto') &&
	                            !coded(result.warnings, 'warningPolicyProtoNoPort', 'Mixed Case Portless')],
	// and the message reports the normalised name, not the raw 'UDP'
	['mixed_case_normalised',   length(filter(result.warnings || [], w =>
		'' + w.info == "'Mixed Case Proto' (udp)")) == 1],

	// 6. a chain pbr does not create cannot hold a rule: nft answers "No such
	//    file or directory" and rejects the whole file. 'input' and
	//    'postrouting' were documented for years and have never existed here,
	//    and a plain typo does the same thing -- so reject the policy instead.
	['bad_chain_rejected',  coded(result.errors, 'errorPolicyUnknownChain', 'Bad Chain')],
	['bad_chain_no_rule',   length(rules_for('Bad Chain')) == 0],
	['no_pbr_input_chain',  index(nft, 'pbr_input') < 0],
	// a chain that does exist is untouched
	['good_chain_kept',     length(filter(rules_for('Good Chain'),
		l => index(l, 'pbr_forward') >= 0)) > 0],
	['good_chain_no_error', !coded(result.errors, 'errorPolicyUnknownChain', 'Good Chain')],
	// chain names are matched case-insensitively, like proto above: the guard
	// lowercases before its exact-word lookup, and policy_routing() lowercases
	// before building the rule, so 'FORWARD' and 'DSTNAT' -- the latter outside
	// chains_list -- are accepted and land in their lowercase chains
	['upper_chain_kept',    length(filter(rules_for('Upper Chain'),
		l => index(l, 'pbr_forward') >= 0)) > 0],
	['upper_chain_no_error', !coded(result.errors, 'errorPolicyUnknownChain', 'Upper Chain')],
	['upper_dstnat_kept',   length(filter(rules_for('Upper Dstnat'),
		l => index(l, 'pbr_dstnat') >= 0)) > 0],
	['upper_dstnat_no_error', !coded(result.errors, 'errorPolicyUnknownChain', 'Upper Dstnat')],

	// 7. rejecting one policy must not take the others with it
	['others_survive',     length(rules_for('Udp No Port')) > 0 &&
	                       length(rules_for('Udp With Port')) > 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("proto_and_chain_validation: %d/%d passed\n", pass, pass + fail);
-- End --

