-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();
let result = pbr.start_service(['on_start']);
let nft = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let rules = filter(split(nft, '\n'), l => index(l, 'comment "Tor-') >= 0);

let checks = [
	['ten_rules', length(rules) == 10],
	['five_ipv4', length(filter(rules, l => index(l, 'meta nfproto ipv4') >= 0)) == 5],
	['five_ipv6', length(filter(rules, l => index(l, 'meta nfproto ipv6') >= 0)) == 5],
	['accepted', length(result.errors || []) == 0],
];
for (let r in rules) {
	push(checks, ['counter_after_every_match', !!match(r, / (udp|tcp) dport (53|80|443) counter redirect to :[0-9]+ /)]);
	push(checks, ['one_counter', length(split(r, ' counter ')) == 2]);
}
let pass = 0;
for (let c in checks) {
	if (c[1]) pass++;
	else printf("FAIL: %s\n", c[0]);
}
printf("tor_counter_position: %d/%d passed\n", pass, length(checks));
-- End --

