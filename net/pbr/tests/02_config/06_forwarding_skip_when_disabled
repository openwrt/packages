Testing forwarding.disable() is a no-op when the service is disabled.

-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

// Capture every system() command so we can assert no sysctl is issued.
let sys_calls = [];
let _orig_system = global.system;
global.system = function(cmd, timeout) {
	push(sys_calls, cmd);
	return _orig_system(cmd, timeout);
};

pbr.forwarding.disable();

let sysctl_calls = filter(sys_calls, c => index(c, 'sysctl') >= 0);
printf("sysctl_calls: %d\n", length(sysctl_calls));
-- End --

