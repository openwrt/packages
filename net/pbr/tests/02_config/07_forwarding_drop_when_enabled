Testing forwarding.disable() drops forwarding when the service is enabled (strict_enforcement=1).

-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

// Capture every system() command so we can assert the sysctl is issued.
let sys_calls = [];
let _orig_system = global.system;
global.system = function(cmd, timeout) {
	push(sys_calls, cmd);
	return _orig_system(cmd, timeout);
};

pbr.forwarding.disable();

let v4 = filter(sys_calls, c => index(c, 'sysctl -w net.ipv4.ip_forward=0') >= 0);
let v6 = filter(sys_calls, c => index(c, 'sysctl -w net.ipv6.conf.all.forwarding=0') >= 0);
printf("ipv4_forward_disabled: %s\n", length(v4) > 0 ? 'yes' : 'no');
printf("ipv6_forward_disabled: %s\n", length(v6) > 0 ? 'yes' : 'no');
-- End --

