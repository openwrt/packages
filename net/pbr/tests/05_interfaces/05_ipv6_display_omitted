Testing that the IPv6 display segment is omitted for interfaces without a v6 gateway/address (no trailing "/-" or "/::/0").

-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);

let checks = [];
let summary = (result && result.status) ? (result.status.gateways || '') : '';

// The gateway summary joins lines with a literal "\n" (two chars), not a newline.
let vpn_line = '', wan6_line = '';
for (let line in split(summary, '\\n')) {
	if (index(line, 'vpn/') == 0)  vpn_line = line;
	if (index(line, 'wan6/') == 0) wan6_line = line;
}

// vpn has an IPv4 gateway but no IPv6 — its summary line must omit the v6 part
push(checks, ['vpn_line_present', vpn_line != '']);
push(checks, ['vpn_no_dash',      index(vpn_line, '/-') < 0]);
push(checks, ['vpn_no_v6_zero',   index(vpn_line, '::/0') < 0]);
push(checks, ['vpn_v4_shown',     index(vpn_line, '10.8.0.1') >= 0]);

// wan6 carries a real v6 gateway, which must still be shown
push(checks, ['wan6_v6_shown',    index(wan6_line, '2001:db8::ffff') >= 0]);

// gateways[] array: vpn v6 omitted (empty string), wan6 v6 present
if (result && result.gateways) {
	for (let gw in result.gateways) {
		if (gw.name == 'vpn')  push(checks, ['vpn_arr_v6_empty', gw.gateway_ipv6 == '']);
		if (gw.name == 'wan6') push(checks, ['wan6_arr_v6',      gw.gateway_ipv6 == '2001:db8::ffff']);
	}
}

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("ipv6_display_omitted: %d/%d passed\n", pass, pass + fail);
-- End --

