-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let result = pbr.start_service(['on_start']);
let nft = global.mocklib.read_captured('/var/run/pbr.nft') || '';
let icmp = filter(split(nft, '\n'), l => index(l, 'icmp') >= 0);

let checks = [
	// both families emit a rule
	['two_icmp_rules',   length(icmp) == 2],
	// IPv4 keeps 'ip protocol icmp'
	['ipv4_form',        length(filter(icmp, l => index(l, 'ip protocol icmp') >= 0)) == 1],
	// IPv6 must use nexthdr/icmpv6
	['ipv6_form',        length(filter(icmp, l => index(l, 'ip6 nexthdr icmpv6') >= 0)) == 1],
	// and must never use the form nft rejects
	['no_ip6_protocol',  index(nft, 'ip6 protocol') < 0],
	// they belong in the output chain, aimed at a mark chain
	['in_output_chain',  length(filter(icmp, l => index(l, 'pbr_output') >= 0)) == 2],
	['targets_mark',     length(filter(icmp, l => index(l, 'goto pbr_mark_') >= 0)) == 2],
	// setting it must not break the service
	['no_errors',        length(result.errors || []) == 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("icmp_interface_ipv6_syntax: %d/%d passed\n", pass, pass + fail);
-- End --

