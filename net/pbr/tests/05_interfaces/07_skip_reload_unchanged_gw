Testing should_skip_reload(): a DHCPv6-renew reload of the IPv6 uplink is skipped when the gateway is unchanged.

-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let checks = [];

// wan6 is the IPv6 uplink; its current gateway (from ubus route) equals the
// previously published gateway_ipv6 -> reload should be skipped.
push(checks, ['skip_when_unchanged', pbr.should_skip_reload('wan6') == true]);

// vpn is not the IPv6 uplink -> never skipped.
push(checks, ['no_skip_non_uplink', pbr.should_skip_reload('vpn') == false]);

// No interface argument -> never skipped.
push(checks, ['no_skip_null', pbr.should_skip_reload(null) == false]);

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("skip_reload_unchanged: %d/%d passed\n", pass, pass + fail);
-- End --

