Testing should_skip_reload(): a reload of the IPv6 uplink proceeds when the gateway has actually changed.

-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

let checks = [];

// wan6's current gateway (from ubus route: 2001:db8::ffff) differs from the
// previously published gateway_ipv6 -> the reload must NOT be skipped.
push(checks, ['no_skip_when_changed', pbr.should_skip_reload('wan6') == false]);

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("skip_reload_changed: %d/%d passed\n", pass, pass + fail);
-- End --

