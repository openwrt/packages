Testing that the wrapper around a shell user file defines nft4 and nft6, and that nft6 adds rules when ipv6 is enabled.

-- Testcase --
import create_pbr from 'pbr';
let pbr = create_pbr();

global.mocklib.capture('/usr/share/pbr/test_user.sh', "nft4 add rule inet fw4 pbr_prerouting return\n");

// The wrapper is deleted once the user file has run, so record it as it is written
let fs = require('fs');
let real_writefile = fs.writefile;
let wrapper = '';
fs.writefile = function(path, data) {
	if (path == '/var/run/pbr.user_wrapper.sh') wrapper = data;
	return real_writefile(path, data);
};

pbr.start_service(['on_start']);

let checks = [
	['nft_defined', index(wrapper, 'nft() {') >= 0],
	['nft4_defined', index(wrapper, 'nft4() { nft "$@"; }') >= 0],
	['nft6_adds', index(wrapper, 'nft6() { nft "$@"; }') >= 0],
];

let pass = 0, fail = 0;
for (let c in checks) {
	if (c[1]) {
		pass++;
	} else {
		fail++;
		printf("FAIL: %s\n", c[0]);
	}
}
printf("shell_nft4_nft6_ipv6_enabled: %d/%d passed\n", pass, pass + fail);
-- End --

