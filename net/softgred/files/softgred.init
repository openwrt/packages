#!/bin/sh /etc/rc.common
# procd init script for softgred.

USE_PROCD=1
START=90
STOP=10

CONFFILE=/etc/softgred/softgred.conf

start_service() {
	[ -r "$CONFFILE" ] || return 1
	procd_open_instance
	procd_set_param command /usr/sbin/softgred -f -c "$CONFFILE"
	procd_set_param file "$CONFFILE"
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	procd_send_signal softgred
}

service_triggers() {
	procd_add_reload_trigger softgred
}
