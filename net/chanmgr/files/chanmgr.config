config chanmgr 'main'
	# router: plans the channels of all nodes; ap: managed by a router
	option role 'router'
	# start the scheduler (sampling + nightly evaluations)
	option enabled '0'
	# recommend: only log and show the plan; apply: switch channels
	option mode 'recommend'
	option eval_times '02:30 04:30'
	option sample_interval '300'
	option scan_gap '120'
	option apply_gap '30'
	# the plan uses the average of the last N days of measurements; an
	# automatic change waits until the new channel has N days of data
	option history_days '3'
	# apply only if the estimated capacity grows by >= min_gain_rel %
	option min_gain_rel '25'
	# same plan in N consecutive evaluations
	option confirm '2'
	option min_switch_interval '86400'
	option allow_dfs '0'
	option ref_rssi '-70'
	option bcn_count '10'
	option reload_fallback '0'
	# radios with a mesh interface: reload (guarded restart) or csa
	option mesh_method 'reload'
	# guarded restart: nodes go back on their own unless their mesh peers
	# return and the controller confirms within these times (seconds)
	option guard_mesh_timeout '90'
	option guard_confirm_timeout '240'
	list channels_2g '1'
	list channels_2g '6'
	list channels_2g '11'
	# 5 GHz: also choose the channel width (off: keep the configured width)
	option width_analysis '0'
	list widths_5g '40'
	list widths_5g '80'

config node 'local'
	option enabled '1'

