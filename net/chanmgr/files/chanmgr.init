#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=99
USE_PROCD=1

boot() {
	# a channel switch interrupted by a power loss: go back to the old channel
	/usr/sbin/chanmgr agent recover >/dev/null 2>&1
	start "$@"
}

start_service() {
	config_load chanmgr
	config_get_bool enabled main enabled 0
	config_get role main role router
	[ "$enabled" -eq 1 ] && [ "$role" != "ap" ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/chanmgr daemon
	# evaluation times are local time
	procd_set_param env TZ="$(cat /tmp/TZ 2>/dev/null || cat /etc/TZ 2>/dev/null || echo UTC)"
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger chanmgr
}
