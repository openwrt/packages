config observer 'main'
	option enabled '1'
	option listen_address '127.0.0.1'
	option port '8787'
	option token_file '/etc/openwrt-presence-agent/token'
	option agent_id_file '/etc/openwrt-presence-agent/agent-id'
	option ubus_path '/bin/ubus'
	option hostapd_socket '/var/run/hostapd/global'
	option arping_path '/usr/bin/arping'
	option dhcp_leases_file '/tmp/dhcp.leases'
	option lan_interface 'br-lan'
	option provider 'ubus'
	option reconcile_interval '30s'
	option wired_reconcile_interval '2s'
	option discovery_interval '10s'
	option command_timeout '5s'
	option max_command_output '1048576'
	option max_event_bytes '65536'
	option max_clients '512'
	option max_http_connections '16'
	option provider_queue_size '256'
	option max_stream_clients '4'
	option stream_queue_size '64'
	option log_level 'info'
