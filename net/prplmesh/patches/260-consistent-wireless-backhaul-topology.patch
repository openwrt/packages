From 7ccc19b57d5bebcbd0a919aaf85cc503c8070224 Mon Sep 17 00:00:00 2001
From: Shi Jiayang <shi05275@163.com>
Date: Tue, 10 Nov 2026 20:26:28 +0800
Subject: [PATCH] controller: retain consistent wireless backhaul parents

Stations created from a topology response or re-created after reconnect
can retain the default Ethernet type despite being attached to a BSS.
BML then labels the active wireless backhaul as Ethernet. A later radio
placeholder can also overwrite the selected backhaul in the BML record.

Keep interface type and parent binding consistent, recover bSTA bindings
from Device Information, preserve confirmed prplMesh parents when reports
arrive out of order, and serialize only the selected backhaul.

Upstream-Status: Pending

Signed-off-by: Shi Jiayang <shi05275@163.com>
---
--- a/controller/src/beerocks/master/db/station.cpp
+++ b/controller/src/beerocks/master/db/station.cpp
@@ -9,6 +9,7 @@
 #include "station.h"
 
 #include <bcl/beerocks_defines.h>
+#include <bcl/beerocks_utils.h>
 #include <chrono>
 #include <easylogging++.h>
 
@@ -151,6 +152,12 @@ void Station::set_bss(std::shared_ptr<Ag
 {
     m_previous_bss = m_bss;
     m_bss          = bss;
+    if (bss) {
+        m_eth_switch.reset();
+        if (!beerocks::utils::is_device_wireless(iface_type)) {
+            iface_type = beerocks::IFACE_TYPE_WIFI_UNSPECIFIED;
+        }
+    }
 }
 
 std::shared_ptr<Agent::sRadio::sBss> Station::get_bss() { return m_bss.lock(); }
@@ -160,6 +167,14 @@ void Station::clear_sta_stats_info() { s
 bool Station::is_bSta() { return m_is_bSta; }
 void Station::set_eth_switch(std::shared_ptr<Agent::sEthSwitch> eth_switch)
 {
+    if (eth_switch) {
+        if (auto bss = get_bss()) {
+            bss->connected_stations.erase(mac);
+        }
+        m_previous_bss = m_bss;
+        m_bss.reset();
+        iface_type = beerocks::IFACE_TYPE_ETHERNET;
+    }
     m_eth_switch = eth_switch;
 }
 std::shared_ptr<Agent::sEthSwitch> Station::get_eth_switch() { return m_eth_switch.lock(); }
