@@ -257,6 +239,17 @@ bool topology_task::handle_topology_resp
         }
     }
 
+    // Reset wired hierarchy only when no active wireless membership was
+    // reported. A missing association event must not turn a wireless link
+    // into Ethernet; real wired transitions still use graph inference.
+    if (!agent->is_gateway && !reports_wireless_backhaul) {
+        agent->backhaul.backhaul_iface_type = beerocks::IFACE_TYPE_ETHERNET;
+        agent->backhaul.backhaul_interface = al_mac;
+        agent->backhaul.parent_agent.reset();
+        agent->backhaul.parent_interface = network_utils::ZERO_MAC;
+        agent->backhaul.wireless_backhaul_radio = nullptr;
+    }
+
     // Update external agents multi ap backhaul datamodel
     if (!agent->is_gateway) {
         database.dm_set_device_multi_ap_backhaul(*agent);
