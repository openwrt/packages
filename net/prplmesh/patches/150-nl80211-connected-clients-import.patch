+bool looks_like_mac(const std::string &text)
+{
+    if (text.length() != 17) {
+        return false;
+    }
+    for (size_t i = 0; i < text.length(); i++) {
+        if (i % 3 == 2) {
+            if (text[i] != ':') {
+                return false;
+            }
+        } else if (!std::isxdigit(static_cast<unsigned char>(text[i]))) {
+            return false;
+        }
+    }
+    return true;
+}
