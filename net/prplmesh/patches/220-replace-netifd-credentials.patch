From 9ce368b2dad0bc726432f4343ba3bd2777fe428e Mon Sep 17 00:00:00 2001
From: Shi Jiayang <shi05275@163.com>
Date: Tue, 10 Nov 2026 20:26:28 +0800
Subject: [PATCH] nl80211: replace stale netifd credential files when applying M2

Per-BSS PSK and SAE files override the received passphrase. Remove those
references only on the managed BSS being configured, so new credentials
work for both authentication methods. Retain optional PMF in mixed mode.

Upstream-Status: Pending

Signed-off-by: Shi Jiayang <shi05275@163.com>
---
--- a/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
+++ b/common/beerocks/bwl/nl80211/ap_wlan_hal_nl80211.cpp
@@ -303,7 +303,7 @@ static bool assign_auth_encr_parameters(
         }
         wpa_passphrase.assign(bss.network_key);
 
-        ieee80211w.assign("2");
+        ieee80211w.assign("1");
         disable_pmksa_caching.assign("1");
         okc.assign("1");
         wpa_disable_eapol_key_retries.assign("0");
@@ -342,6 +342,11 @@ static bool assign_auth_encr_parameters(
     conf.set_create_value(vap_id, "wpa_psk", wpa_psk);
     conf.set_create_value(vap_id, "ieee80211w", ieee80211w);
     conf.set_create_value(vap_id, "wpa_passphrase", wpa_passphrase);
+    // Netifd's per-BSS files contain the previous credentials and take
+    // precedence over wpa_passphrase, for WPA2 and SAE respectively.
+    conf.set_create_value(vap_id, "wpa_psk_file", "");
+    conf.set_create_value(vap_id, "sae_password_file", "");
+    conf.set_create_value(vap_id, "sae_password", "");
     conf.set_create_value(vap_id, "disable_pmksa_caching", disable_pmksa_caching);
     conf.set_create_value(vap_id, "wpa_disable_eapol_key_retries", wpa_disable_eapol_key_retries);
     return true;
