From 92e176040e14837272155657059da02bff8ec3c3 Mon Sep 17 00:00:00 2001
From: Shi Jiayang <shi05275@163.com>
Date: Tue, 10 Nov 2026 20:26:28 +0800
Subject: [PATCH] agent: exclude platform buffer padding from backhaul credentials

The platform credential buffers reserve space for NUL termination and
alignment. Constructing strings with the whole buffer size imports this
padding, turning a valid SSID into 36 bytes and retaining trailing NULs in
the passphrase. Initial netifd association hides the error until backhaul
recovery calls the HAL with these invalid credentials.

Bound the conversion at the first terminator and initialize the buffers.
This also makes equality checks against M8 credentials meaningful.

Upstream-Status: Pending

Signed-off-by: Shi Jiayang <shi05275@163.com>
---
--- a/agent/src/beerocks/slave/son_slave_thread.cpp
+++ b/agent/src/beerocks/slave/son_slave_thread.cpp
@@ -711,14 +711,17 @@ bool slave_thread::read_platform_configu
                << " ssid=" << db->device_conf.front_radio.ssid
                << " sec=" << db->device_conf.front_radio.security_type << " pass=***";
 
-    char ssid[beerocks::message::WIFI_SSID_MAX_LENGTH];
-    char pass[beerocks::message::WIFI_PASS_MAX_LENGTH];
+    char ssid[beerocks::message::WIFI_SSID_MAX_LENGTH] = {};
+    char pass[beerocks::message::WIFI_PASS_MAX_LENGTH] = {};
     if (bpl::cfg_get_beerocks_credentials(BPL_RADIO_BACK, ssid, pass, security_type) < 0) {
         LOG(ERROR) << "Failed reading Wi-Fi back credentials!";
         return false;
     }
-    db->device_conf.back_radio.ssid = std::string(ssid, beerocks::message::WIFI_SSID_MAX_LENGTH);
-    db->device_conf.back_radio.pass = std::string(pass, beerocks::message::WIFI_PASS_MAX_LENGTH);
+    // Platform buffers include a terminator and alignment padding. Import
+    // only the bounded C string, otherwise every SSID becomes 36 bytes and
+    // recovery rejects it (or tries to authenticate with padded credentials).
+    db->device_conf.back_radio.ssid = std::string(ssid, strnlen(ssid, sizeof(ssid)));
+    db->device_conf.back_radio.pass = std::string(pass, strnlen(pass, sizeof(pass)));
     db->device_conf.back_radio.security_type = platform_to_bwl_security(security_type);
 
     int mem_only_psk = bpl::cfg_get_security_policy();
