From 1add303f85edbd1f0fb76dbe59b3bb0b02c5056d Mon Sep 17 00:00:00 2001
From: Shi Jiayang <shi05275@163.com>
Date: Tue, 10 Nov 2026 20:26:28 +0800
Subject: [PATCH] nl80211: implement stock wireless backhaul station operations

Use supplicant scans and parse escaped SSIDs, configure SAE/PMF and the
Multi-AP station role, apply real four-address mode through nl80211, and
propagate kernel failures. Fix null reply output pointers and stop logging
network credentials when control requests fail. Keep netifd-owned networks
while removing temporary HAL-owned networks on reconnect.

Upstream-Status: Pending

Signed-off-by: Shi Jiayang <shi05275@163.com>
---
--- /dev/null
+++ b/common/beerocks/bwl/nl80211/sta_wpa_utils.h
@@ -0,0 +1,139 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef BWL_STA_WPA_UTILS_H
+#define BWL_STA_WPA_UTILS_H
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace bwl {
+namespace nl80211 {
+namespace sta_wpa_utils {
+
+inline int hex_digit(char c)
+{
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+}
+
+inline bool parse_number(const std::string &s, int min, int max, int &value)
+{
+    if (s.empty()) return false;
+    char *end = nullptr;
+    errno = 0;
+    auto n = std::strtol(s.c_str(), &end, 10);
+    if (errno || end != s.c_str() + s.size() || n < min || n > max) return false;
+    value = static_cast<int>(n);
+    return true;
+}
+
+inline bool valid_bssid(const std::string &s)
+{
+    if (s.size() != 17) return false;
+    for (size_t i = 0; i < s.size(); ++i) {
+        if (i % 3 == 2 ? s[i] != ':' : hex_digit(s[i]) < 0) return false;
+    }
+    // An AP BSSID must be a nonzero unicast address.
+    return !(hex_digit(s[1]) & 1) && s != "00:00:00:00:00:00";
+}
+
+// wpa_supplicant's SCAN_RESULTS uses printf_encode(), including escaped UTF-8 octets.
+inline bool decode_ssid(const std::string &s, std::string &out)
+{
+    out.clear();
+    for (size_t i = 0; i < s.size(); ++i) {
+        auto c = s[i];
+        if (c == '\\') {
+            if (++i == s.size()) return false;
+            switch (s[i]) {
+            case '\\': c = '\\'; break;
+            case '"': c = '"'; break;
+            case 'n': c = '\n'; break;
+            case 'r': c = '\r'; break;
+            case 't': c = '\t'; break;
+            case 'e': c = '\x1b'; break;
+            case 'x':
+                if (i + 2 >= s.size() || hex_digit(s[i + 1]) < 0 || hex_digit(s[i + 2]) < 0)
+                    return false;
+                c = static_cast<char>((hex_digit(s[i + 1]) << 4) | hex_digit(s[i + 2]));
+                i += 2;
+                break;
+            default: return false;
+            }
+        }
+        out.push_back(c);
+    }
+    return out.size() <= 32;
+}
+
+struct scan_result {
+    std::string bssid;
+    int frequency;
+    int rssi;
+    std::string ssid;
+};
+
+inline std::vector<scan_result> parse_scan_results(const std::string &reply,
+                                                  const std::string &ssid)
+{
+    std::vector<scan_result> results;
+    std::istringstream input(reply);
+    std::string line;
+    while (std::getline(input, line)) {
+        // Ignore a potentially truncated last row, never select a partial SSID.
+        if (input.eof() && (reply.empty() || reply.back() != '\n')) break;
+        std::vector<std::string> fields;
+        size_t start = 0;
+        for (int column = 0; column < 4; ++column) {
+            auto end = line.find('\t', start);
+            if (end == std::string::npos) break;
+            fields.push_back(line.substr(start, end - start));
+            start = end + 1;
+        }
+        if (fields.size() != 4) continue;
+        scan_result result{};
+        if (!valid_bssid(fields[0]) ||
+            !parse_number(fields[1], 1, 71000, result.frequency) ||
+            !parse_number(fields[2], -127, 0, result.rssi) ||
+            !decode_ssid(line.substr(start), result.ssid) || result.ssid != ssid) continue;
+        result.bssid = fields[0];
+        results.push_back(result);
+    }
+    return results;
+}
+
+inline std::string hex_string(const std::string &s)
+{
+    static const char digits[] = "0123456789abcdef";
+    std::string out;
+    for (unsigned char c : s) {
+        out.push_back(digits[c >> 4]);
+        out.push_back(digits[c & 15]);
+    }
+    return out;
+}
+
+inline bool valid_passphrase(const std::string &pass, bool sae)
+{
+    if (pass.find_first_of(std::string("\r\n\0", 3)) != std::string::npos) return false;
+    if (pass.size() >= 8 && pass.size() <= 63) return true;
+    return !sae && pass.size() == 64 &&
+           std::all_of(pass.begin(), pass.end(), [](char c) { return hex_digit(c) >= 0; });
+}
+
+// SET_NETWORK's PSK parser strips the outer quotes; inner quotes and backslashes
+// are literal bytes. Do not shell-escape or printf-escape a control socket value.
+inline std::string psk_value(const std::string &pass)
+{
+    return pass.size() == 64 ? pass : '"' + pass + '"';
+}
+
+} // namespace sta_wpa_utils
+} // namespace nl80211
+} // namespace bwl
+#endif
