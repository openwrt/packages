+bool sta_wlan_hal_nl80211::get_4addr_mode()
+{
+    bool enabled = false;
+    bool found = false;
+    auto success = send_nl80211_msg(NL80211_CMD_GET_INTERFACE, 0,
+        [](struct nl_msg *) { return true; },
+        [&](struct nl_msg *msg) {
+            struct nlattr *attrs[NL80211_ATTR_MAX + 1] = {};
+            auto header = static_cast<struct genlmsghdr *>(nlmsg_data(nlmsg_hdr(msg)));
+            if (nla_parse(attrs, NL80211_ATTR_MAX, genlmsg_attrdata(header, 0),
+                          genlmsg_attrlen(header, 0), nullptr) < 0) return false;
+            if (attrs[NL80211_ATTR_4ADDR]) {
+                found = true;
+                enabled = nla_get_u8(attrs[NL80211_ATTR_4ADDR]) != 0;
+            }
+            return true;
+        });
+    return success && found && enabled;
+}
+
+bool sta_wlan_hal_nl80211::set_4addr_mode(bool enable)
+{
+    if (enable && get_4addr_mode()) return true;
+    return send_nl80211_msg(NL80211_CMD_SET_INTERFACE, 0,
+        [enable](struct nl_msg *msg) {
+            return nla_put_u8(msg, NL80211_ATTR_4ADDR, enable ? 1 : 0) == 0;
+        }, [](struct nl_msg *) { return true; });
+}
 
