+++ b/common/beerocks/bcl/source/network/network_utils.cpp
@@ -1937,8 +1937,19 @@ bool network_utils::linux_iface_is_physi
         return false;
     }
 
-    /* Physical interfaces have the same 'iflink' and 'ifindex' values */
-    return (iflink == ifindex) ? true : false;
+    // DSA user ports refer to their conduit through iflink. They are still physical
+    // Ethernet ports, and must be included in LAN/backhaul discovery.
+    if (iflink == ifindex) {
+        return true;
+    }
+    std::ifstream uevent("/sys/class/net/" + iface + "/uevent");
+    std::string line;
+    while (std::getline(uevent, line)) {
+        if (line == "DEVTYPE=dsa") {
+            return true;
+        }
+    }
+    return false;
