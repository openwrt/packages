From 748d94941b2f64c86ef16e14b2921c6acc50d793 Mon Sep 17 00:00:00 2001
From: Shi Jiayang <shi05275@163.com>
Date: Tue, 10 Nov 2026 20:26:28 +0800
Subject: [PATCH] backhaul: retain unchanged credentials and avoid enrollee BSSID pinning

M8 repeats the bootstrap credentials during onboarding. Keep a working
STA when those credentials match, and do not constrain supplicant to the
enrollee MAC carried by this controller's M8 when credentials do change.
Check the HAL result and retain changed credentials for recovery retries.

Upstream-Status: Pending

Signed-off-by: Shi Jiayang <shi05275@163.com>
---
--- a/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
+++ b/agent/src/beerocks/slave/backhaul_manager/backhaul_manager.cpp
@@ -2883,8 +2883,25 @@ bool BackhaulManager::handle_slave_backh
         // We just create a valid parameter for compilation purpose.
         std::pair<uint8_t, beerocks::eFreqType> channel =
             std::make_pair(0, beerocks::eFreqType::FREQ_24G);
-        sta_wlan_hal->connect(config_data->ssid_str(), config_data->network_key_str(), sec, false,
-                              tlvf::mac_to_string(config_data->bssid_attr().data), channel, false);
+        auto db = AgentDB::get();
+        auto &saved = db->device_conf.back_radio;
+        const std::string ssid = config_data->ssid_str();
+        const std::string pass = config_data->network_key_str();
+        if (saved.ssid == ssid && saved.pass == pass && saved.security_type == sec &&
+            sta_wlan_hal->is_connected()) {
+            LOG(INFO) << "Backhaul credentials unchanged; retaining the associated STA";
+            break;
+        }
+
+        // The controller M8 carries the enrollee's MAC, not the upstream
+        // AP BSSID. Let supplicant select a matching AP for these credentials.
+        if (!sta_wlan_hal->connect(ssid, pass, sec, false, "", channel, false)) {
+            LOG(ERROR) << "Failed applying backhaul credentials";
+            return false;
+        }
+        saved.ssid = ssid;
+        saved.pass = pass;
+        saved.security_type = sec;
         break;
     }
     case beerocks_message::ACTION_BACKHAUL_MLD_UPDATE_REQUEST: {
