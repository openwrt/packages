#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034 # USE_PROCD, START and STOP are read by /etc/rc.common

USE_PROCD=1
START=99
STOP=10

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/tmhi daemon
	# The script is listed so a package upgrade restarts the daemon: it's a
	# shell that keeps running the script it started with.
	procd_set_param file /etc/config/tmhi /usr/bin/tmhi
	procd_set_param respawn 3600 60 0
	procd_set_param term_timeout 30
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger tmhi
}

# Write out the samples buffered in RAM before procd stops the daemon.
stop_service() {
	/usr/bin/tmhi flush
}
