# v2rayA configuration
#
# This file is read by /etc/init.d/v2raya and translated to V2RAYA_*
# environment variables.  The names intentionally match the old v2rayA feed
# so an existing /etc/config/v2raya keeps working after the upgrade.

config v2raya 'config'
	# Start the service at boot.  The procd instance is also enabled/disabled
	# by this flag, not only by /etc/rc.d/S99v2raya.
	option enabled '0'

	# Web UI listening address.  Use 127.0.0.1:2017 if you only access it
	# through an SSH tunnel or a reverse proxy.
	option address '0.0.0.0:2017'

	# URL prefix when v2rayA sits behind a reverse proxy.  Must start with /.
	option baseurl '/'

	# auto, on or off.  Make sure IPv6 works before forcing it on.
	option ipv6_support 'auto'

	# auto, on or off.  nftables is the default on OpenWrt 22.03+.
	option nftables_support 'auto'

	# Seconds to wait for v2raya_core to start.  Raise this on slow MIPS
	# devices if the core is reported as failing to start.
	option core_startup_timeout '15'

	# trace, debug, info, warn or error.  Warn keeps the flash writes down
	# on a router; use info while debugging.
	option log_level 'warn'

	# Number of days to keep rotated log files.
	option log_max_days '1'

	# The log file already contains timestamps and no terminal colours.
	option log_disable_color '1'
	option log_disable_timestamp '0'

	# Soft Go memory limit for both v2raya and v2raya_core (GOMEMLIMIT).
	# 0 disables the limit.  64MiB is a safe start on a 256MiB router.
	option gomemlimit '64MiB'

	# Go scheduler threads (GOMAXPROCS).  0 uses every CPU core; 2 is
	# enough for a home router and uses fewer scheduler resources.
	option gomaxprocs '2'

	# Go GC target percentage (GOGC).  0 keeps the Go default; lower values
	# use less memory at the cost of more CPU.
	option gogc '0'

	# Maximum open file descriptors.  16384 is plenty for a home router and
	# stops a connection flood from exhausting memory.
	option nofile '16384'

	# Directory containing geoip.dat and geosite.dat.  This is where the
	# v2ray-geoip and v2ray-geosite packages install their files.
	option v2ray_assetsdir '/usr/share/v2ray'

	# Path to v2raya_core.  Leave empty to auto-detect the binary next to
	# /usr/bin/v2raya or in PATH.
	option v2ray_bin ''

	# Extra v2ray configuration directory merged into the generated config.
	option v2ray_confdir ''

	# Hooks run around transparent-proxy and core life-cycle events.
	# v2rayA passes --stage (pre-start, post-start, pre-stop, post-stop) and,
	# for the transparent hook, --transparent-type (tproxy, redirect).
	option transparent_hook ''
	option core_hook ''
	option plugin_manager ''

	# [Linux] In redirect mode, let sockets bound to a device bypass the
	# proxy.  Requires kernel 5.14+ and cgroup v2.
	option redirect_respect_bound_device '0'
