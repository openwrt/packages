From 8a3f10e0295a1587fd4beef414386290aca89605 Mon Sep 17 00:00:00 2001
From: Amr Fateem <amr.fateem@yahoo.com>
Date: Wed, 11 Nov 2026 21:06:01 +0200
Subject: [PATCH] openwrt: clean residual transparent-proxy and DNS rules on stop

When a core process stops, the in-memory transparentOn flag may be
false even though tproxy rules from an earlier process are still
installed.  The early return leaves those rules and the policy route
behind, so stopping the proxy or the service leaves no internet.

The stop request can also arrive when no core process is tracked, for
example after a process restart.  Clean the residual rules in that path
too.  The normal path still runs the transparent-proxy hooks and removes
the rules as before.

The nft DNS redirect table (inet v2raya_dns) is installed separately and
has no stop hook.  Remove it in the same cleanup, otherwise the router's
own port-53 traffic keeps going to a listener that has stopped when DNS
hijack is enabled.

Upstream-Status: Pending

Signed-off-by: Amr Fateem <amr.fateem@yahoo.com>
---
 kernel/v2ray/processManager.go | 15 ++++++++++++---
 kernel/v2ray/transparent.go    |  2 ++
 2 files changed, 14 insertions(+), 3 deletions(-)

--- a/kernel/v2ray/processManager.go
+++ b/kernel/v2ray/processManager.go
@@ -170,9 +170,13 @@ func (m *CoreProcessManager) CheckAndSto
 
 func (m *CoreProcessManager) checkAndStopTransparentProxy(setting *configure.Setting) {
 	if !m.transparentOn.Swap(false) {
-		// Nothing installed by this process, so nothing to remove and no hook
-		// to run. Rules left behind by an earlier process are removed by
-		// cleanupResidualTransparentProxyRules when the rules are set up.
+		// Clean residual rules from an earlier process too: after a
+		// restart the in-memory flag is false while the tproxy rules
+		// may still be installed, which blackholes all traffic when
+		// the core stops.
+		if setting != nil && setting.Transparent != configure.TransparentClose {
+			deleteTransparentProxyRules()
+		}
 		return
 	}
 	if setting == nil {
@@ -237,6 +241,11 @@ func (m *CoreProcessManager) Stop(saveRu
 	m.mu.Lock()
 	defer m.mu.Unlock()
 	if m.p == nil {
+		// A previous process may have left tproxy rules behind; a stop
+		// request must still restore direct connectivity.
+		hostMu.Lock()
+		deleteTransparentProxyRules()
+		hostMu.Unlock()
 		return
 	}
 	if saveRunning {
--- a/kernel/v2ray/transparent.go
+++ b/kernel/v2ray/transparent.go
@@ -210,6 +210,8 @@ func dnsRedirectDeleteCommands() string
 // to :52353, and once the DNS module exits they hit a dead port and DNS
 // fails. Idempotent (2>/dev/null || true).
 func cleanDnsRedirectRules() {
+	// NftDNSRedirect installs its table separately and has no stop hook.
+	iptables.Setter{Cmds: "nft delete table inet v2raya_dns 2>/dev/null || true"}.Run(false)
 	commands := dnsRedirectDeleteCommands() + `
 iptables -w 2 -t nat -D OUTPUT -m mark --mark 0x80/0x80 -j RETURN 2>/dev/null || true
 iptables -w 2 -t nat -D PREROUTING -m mark --mark 0x80/0x80 -j RETURN 2>/dev/null || true
