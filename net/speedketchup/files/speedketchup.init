#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/bin/speedketchup

append_arg() {
	local value
	config_get value main "$2" "$3"
	[ -n "$value" ] && procd_append_param command "$1" "$value"
}

# secrets go in the environment, not on the command line where ps shows them
append_env() {
	local value
	config_get value main "$2"
	[ -n "$value" ] && procd_append_param env "$1=$value"
}

start_service() {
	local enabled file
	config_load speedketchup
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 1

	config_get file main file /tmp/speedketchup/speedketchup-results.csv
	mkdir -p "$(dirname "$file")"

	procd_open_instance
	procd_set_param command "$PROG" -f "$file"
	append_arg -i interval 10
	append_arg -a address 0.0.0.0
	append_arg -p port 8080
	append_arg -s server
	append_arg -dd download_duration 10
	append_arg -ud upload_duration 10
	append_arg -dc download_connections 8
	append_arg -uc upload_connections 8
	append_arg -iu influx_url
	append_env SPEEDKETCHUP_INFLUX_TOKEN influx_token
	append_arg -mq mqtt
	append_arg -mu mqtt_user
	append_env SPEEDKETCHUP_MQTT_PASSWORD mqtt_password
	procd_set_param respawn
	# stdout has a trace of every test, the results go to the file
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger speedketchup
}
