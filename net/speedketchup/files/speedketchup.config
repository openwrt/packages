
config speedketchup 'main'
	option enabled '0'

	# Minutes between the speed tests
	option interval '10'
	# The test results, /tmp is lost on reboot, point it to an usb drive
	# to keep them, the file grows by about 150 bytes per test
	option file '/tmp/speedketchup/speedketchup-results.csv'

	# The web page with the results, the firewall keeps it off the
	# internet unless a rule opens the port on the wan zone
	option address '0.0.0.0'
	option port '8080'

	# Speedtest server host[:port] to always test against, empty picks
	# the server with the lowest latency for every test
	option server ''

	# Seconds to test the download and upload speed, 0 skips the test
	option download_duration '10'
	option upload_duration '10'
	# Parallel connections for the download and upload tests
	option download_connections '8'
	option upload_connections '8'

	# InfluxDB line protocol write url to also write every result to,
	# http only, eg http://influxdb:8086/api/v2/write?org=home&bucket=speedketchup,
	# and its token
	option influx_url ''
	option influx_token ''

	# MQTT broker host[:port] to also publish every result to, with
	# Home Assistant discovery, plain mqtt only, and its user and password
	option mqtt ''
	option mqtt_user ''
	option mqtt_password ''
