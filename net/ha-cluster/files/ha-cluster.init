#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: MIT
# Copyright (c) 2025-2026 Pierre Gaufillet <pierre.gaufillet@bergamote.eu>

# After dnsmasq (19) and network (20)
START=25
STOP=91

USE_PROCD=1

. /usr/lib/ha-cluster/ha-cluster.sh

start_service() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0

	ha_log_init

	[ "$enabled" -eq 0 ] && {
		ha_log_debug "HA cluster disabled"
		return 0
	}

	ha_log_info "Starting HA cluster"

	mkdir -p /etc/owsync
	mkdir -p "$HA_CLUSTER_RUN_DIR"

	ha_apply_config || {
		ha_log_error "Failed to apply configuration"
		return 1
	}

	ha_log_info "Starting keepalived daemon"
	procd_open_instance keepalived
	procd_set_param command /usr/sbin/keepalived
	procd_append_param command -n  # don't daemonize
	procd_append_param command -f "$KEEPALIVED_CONF"
	procd_set_param file "$KEEPALIVED_CONF"
	procd_set_param reload_signal HUP
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ -f "$OWSYNC_CONF" ]; then
		ha_log_info "Starting owsync daemon"
		procd_open_instance owsync
		procd_set_param command "$OWSYNC_BIN" daemon
		procd_append_param command -c "$OWSYNC_CONF"
		procd_set_param file "$OWSYNC_CONF"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ -f "$LEASE_SYNC_CONF" ]; then
		ha_log_info "Starting lease-sync daemon"
		procd_open_instance lease-sync
		procd_set_param command "$LEASE_SYNC_BIN"
		procd_append_param command -c "$LEASE_SYNC_CONF"
		procd_set_param file "$LEASE_SYNC_CONF"
		procd_set_param respawn
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	return 0
}

stop_service() {
	ha_log_info "Stopping HA cluster"

	# procd stops the instances
	return 0
}

# Runs after procd_kill, which only signals the instances. lease-sync must
# be gone before dnsmasq restarts and replays its leases, and the
# standalone daemons need the ports back. procd sends SIGKILL after
# term_timeout (5 s).
service_stopped() {
	local i=0

	while procd_running ha-cluster && [ "$i" -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done

	ha_release_dnsmasq
	ha_manage_services "release"
}

reload_service() {
	local enabled

	config_load ha-cluster
	config_get_bool enabled config enabled 0

	ha_log_init

	ha_log_info "Reloading HA cluster configuration"

	if ! procd_running ha-cluster; then
		if [ "$enabled" -eq 1 ]; then
			ha_log_info "Service not running, performing full start"
			start
		fi
		return 0
	fi

	if [ "$enabled" -eq 0 ]; then
		ha_log_info "HA cluster disabled, stopping"
		stop
		return 0
	fi

	# Regenerate configs and let procd reconcile the instances: owsync and
	# lease-sync restart on config file change or start/stop as their config
	# appears/disappears; keepalived gets SIGHUP on config file change and
	# re-reads its config, keeping the VIPs.
	start
}

service_triggers() {
	procd_add_reload_trigger "ha-cluster"
}
