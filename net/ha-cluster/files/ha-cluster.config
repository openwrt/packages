config global 'config'
	option enabled '0'

	# VRRP priority (1-255, highest becomes MASTER)
	option node_priority '100'

	# multicast (needs L2 adjacency) | unicast (e.g. over WireGuard; peers
	# and source address derived from the peer sections)
	option vrrp_transport 'multicast'

	# File sync backend; owsync is the only one
	#option sync_method 'owsync'
	# 64 hex chars, shared by owsync and lease-sync; empty = plain
	option encryption_key ''
	# DHCP lease sync (lease-sync and the dnsmasq ubus lease methods)
	option lease_sync '1'

	# This node's own address for owsync and lease-sync, so that the VIP is
	# never used as source; empty = all addresses
	#option bind_address ''

# VIPs of the same instance fail over together.
# VRID 1-127 (with multicast VRRP, VRID+128 is used by the IPv6 instance).
config vrrp_instance 'main'
	option vrid '64'
	option interface 'lan'
	option priority '100'         # overrides node_priority
	option nopreempt '1'
	option advert_int '1'         # seconds
	#option preempt_delay '0'     # seconds
	#option garp_master_delay ''  # seconds
	#option auth_type 'none'      # none | pass | ah
	#option auth_pass ''
	#option unicast_src_ip ''
	#list unicast_peer '10.0.0.2'
	#list track_interface 'wan'
	#list track_script 'check_gateway'

config vip
	option enabled '1'
	option vrrp_instance 'main'
	option interface 'lan'
	option address '192.168.1.254'
	option netmask '255.255.255.0'
	#option address6 ''
	#option prefix6 '64'

# source_address: this node's own address to reach the peer (not the VIP)
# vrrp_only '1': router not running ha-cluster, never synced
#config peer
#	option name 'router2'
#	option address '192.168.1.2'
#	#option source_address '192.168.1.1'
#	#option vrrp_only '0'

# Files synced by owsync; a group without 'enabled' is enabled
config sync_group 'dhcp'
	option enabled '1'
	list config_files 'dhcp'

config sync_group 'firewall'
	option enabled '0'
	list config_files 'firewall'

# Log levels: 0=ERROR, 1=WARN, 2=INFO, 3=DEBUG; intervals in seconds
config advanced 'advanced'
	option log_level '2'
	option owsync_log_level '2'
	option sync_interval '30'
	option lease_sync_port '5378'
	option lease_sync_interval '30'
	option lease_sync_peer_timeout '120'
	option lease_sync_log_level '2'
	option max_auto_priority '0'
	option enable_notifications '0'
	#list notification_email 'root@localhost'
	#option notification_email_from 'ha-cluster@router'
	#option smtp_server '127.0.0.1'

# Excludes take precedence over sync groups
config exclude
	list file 'network'
	list file 'system'
	list file 'owsync'
	list file 'ha-cluster'
	list file 'wireless'

#config script 'check_gateway'
#	option script '/bin/ping -c 1 -W 1 8.8.8.8'
#	option interval '5'
#	option timeout '2'
#	option weight '-10'
#	option rise '2'
#	option fall '2'
