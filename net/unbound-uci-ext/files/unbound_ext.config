# Clauses after server:, such as forward-zone:, rendered into a marked
# region of /etc/unbound/unbound_ext.conf, one ext_line for each line.
# Nothing checks the lines, and unbound stops on a line that it cannot
# parse, so run unbound-checkconf after a change.

config unbound_ext 'main'
	option enabled '0'

	#list ext_line 'forward-zone:'
	#list ext_line '  name: "example.org"'
	#list ext_line '  forward-addr: 192.0.2.53'
