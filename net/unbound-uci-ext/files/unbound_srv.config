# Lines of the server: clause, rendered into a marked region of
# /etc/unbound/unbound_srv.conf. For another clause, such as
# forward-zone:, use /etc/config/unbound_ext.

config unbound_srv 'main'
	option enabled '0'

	# interface: lines, as addr or addr@port. To bind only these, also
	# set interface_auto '0' in /etc/config/unbound.
	#list interface_bind '127.0.0.1@5353'

	# outgoing-interface: lines.
	#list interface_outgoing '192.0.2.1'

	# ip-transparent: 1 for yes, 0 for no.
	#option ip_transparent '0'

	# Any other server: line, as it is.
	#list srv_line 'serve-expired: yes'
