config ntfy 'main'
	option enabled '0'

	# All ntfy server options live in this file, see https://docs.ntfy.sh/config/
	# The directories ntfy needs are derived from it, so the paths only have to
	# be changed in one place.
	option conf_file '/etc/ntfy/server.yml'

	option user 'ntfy'
	option group 'ntfy'

	# Override single options of conf_file without editing the YAML file.
	#list env 'NTFY_BASE_URL=http://ntfy.example.org:8180'
	#list env 'NTFY_LOG_LEVEL=debug'
